/*
 * DATOS FICTICIOS (decisión D-00 del brain).
 * Todos los valores de este archivo son de ejemplo: menú y precios en MXN, horario, dirección,
 * coordenadas y WhatsApp (+52 000 000 0000). Deben sustituirse por los reales antes de publicar
 * (ver brain/huecos.md). Para cambiarlos, edita solo este archivo: ningún otro módulo contiene
 * datos del negocio.
 */

export interface MenuItem {
  name: string;
  /** Price as a number in `currency`; formatting lives in src/lib/formatPrice.ts (D-06). */
  price: number;
}

export interface OpenDay {
  day: string;
  /** "HH:MM", 24 h. */
  open: string;
  /** "HH:MM", 24 h, later than `open`. */
  close: string;
  closed?: never;
}

export interface ClosedDay {
  day: string;
  closed: true;
  open?: never;
  close?: never;
}

export type DayHours = OpenDay | ClosedDay;

export interface Business {
  name: string;
  slogan: string;
  locale: string;
  currency: string;
  menu: {
    drinks: MenuItem[];
    desserts: MenuItem[];
  };
  /** Seven entries, Monday to Sunday. */
  hours: DayHours[];
  address: string;
  coordinates: { lat: number; lng: number };
  /** `number`: digits only, country code included. */
  whatsapp: { number: string; message: string };
}

export const business: Business = {
  name: "Cafetería Luna",
  slogan: "Tu rincón tranquilo para un buen café",
  locale: "es-MX",
  currency: "MXN",
  menu: {
    drinks: [
      { name: "Café americano", price: 45 },
      { name: "Capuchino", price: 55 },
      { name: "Latte", price: 60 },
      { name: "Chocolate caliente", price: 50 },
    ],
    desserts: [
      { name: "Pastel de chocolate", price: 75 },
      { name: "Cheesecake de frutos rojos", price: 80 },
      { name: "Pan de elote", price: 45 },
    ],
  },
  hours: [
    { day: "Lunes", closed: true },
    { day: "Martes", open: "08:00", close: "20:00" },
    { day: "Miércoles", open: "08:00", close: "20:00" },
    { day: "Jueves", open: "08:00", close: "20:00" },
    { day: "Viernes", open: "08:00", close: "21:00" },
    { day: "Sábado", open: "09:00", close: "21:00" },
    { day: "Domingo", open: "09:00", close: "15:00" },
  ],
  address: "Calle Ejemplo 123, Col. Centro, 00000 Ciudad de México, CDMX, México",
  coordinates: { lat: 19.4326, lng: -99.1332 },
  whatsapp: {
    number: "520000000000",
    message:
      "¡Hola, Cafetería Luna! Quiero reservar una mesa. ¿Me ayudas?\nFecha: \nHora: \nNúmero de personas: ",
  },
};
/* Custom properties de brain/diseno.md (D-02), copiadas tal cual del bloque "Tokens CSS". */
:root {
  /* Color */
  --color-bg: #FBF6EE;
  --color-surface: #F3EADB;
  --color-surface-raised: #FFFFFF;
  --color-text: #2B1D14;
  --color-text-muted: #6B5646;
  --color-primary: #7A3E1D;
  --color-primary-hover: #62301A;
  --color-on-primary: #FFFFFF;
  --color-secondary: #E9C46A;
  --color-on-secondary: #2B1D14;
  --color-whatsapp: #1E6B45;
  --color-on-whatsapp: #FFFFFF;
  --color-success: #2E6B3A;
  --color-error: #B3261E;
  --color-border: #D9C9B3;
  --color-focus: #1F4E8C;
  --color-footer-bg: #2B1D14;
  --color-footer-text: #F3EADB;

  /* Tipografía */
  --font-heading: "Fraunces", Georgia, "Times New Roman", serif;
  --font-body: "DM Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --text-xs: 0.8125rem;
  --text-sm: 0.9375rem;
  --text-base: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.5rem;
  --text-2xl: 1.875rem;
  --text-3xl: 2.5rem;
  --leading-body: 1.6;
  --leading-heading: 1.2;

  /* Espaciado (escala de 4 px) */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.5rem;
  --space-6: 2rem;
  --space-7: 3rem;
  --space-8: 4.5rem;

  /* Radios */
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 20px;
  --radius-pill: 999px;

  /* Sombras */
  --shadow-sm: 0 1px 2px rgb(43 29 20 / 0.08), 0 1px 3px rgb(43 29 20 / 0.06);
  --shadow-md: 0 4px 12px rgb(43 29 20 / 0.12), 0 2px 4px rgb(43 29 20 / 0.06);

  /* Layout */
  --container-max: 64rem;      /* 1024 px */
  --gutter: var(--space-4);
  --tap-min: 44px;             /* zona táctil mínima (CA-05.2) */
  --header-height: 56px;
}

@media (min-width: 768px) {
  :root {
    --text-base: 1.0625rem;
    --text-lg: 1.25rem;
    --text-xl: 1.75rem;
    --text-2xl: 2.5rem;
    --text-3xl: 3.75rem;
    --gutter: var(--space-5);
    --header-height: 64px;
  }
}

