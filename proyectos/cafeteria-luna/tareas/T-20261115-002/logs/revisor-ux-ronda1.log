+// ── T-20261115-002: menu.css ──────────────────────────────────────────────
+
+// Body of the first `@media (min-width: 768px) { … }` block, braces balanced.
+const mediaBlock = (css: string, query: RegExp): string => {
+  const start = css.search(query);
+  if (start < 0) return "";
+  const open = css.indexOf("{", start);
+  let depth = 0;
+  for (let i = open; i < css.length; i += 1) {
+    if (css[i] === "{") depth += 1;
+    if (css[i] === "}") depth -= 1;
+    if (depth === 0) return css.slice(open + 1, i);
+  }
+  return "";
+};
+
+describe("T-20261115-002 CA-13: menu.css only uses tokens and fixes the 375 px row", () => {
+  const css = readCss("menu.css");
+  const rules = parseRules(css);
+  const ruleFor = (selector: RegExp, list: CssRule[] = rules): CssRule | undefined =>
+    list.find((rule) => selector.test(rule.selector));
+
+  it("has no color literals", () => {
+    expect(css).not.toMatch(/#[0-9a-f]{3,8}(?![\w-])/i);
+    expect(css).not.toMatch(/\b(rgba?|hsla?)\(/i);
+  });
+
+  it("styles the group as a diseno.md card", () => {
+    const group = ruleFor(/\.menu__group\b/);
+    expect(group, ".menu__group rule").toBeDefined();
+    for (const token of ["--color-surface-raised", "--color-border", "--radius-md", "--shadow-sm", "--space-5"]) {
+      expect(group?.body, token).toContain(`var(${token})`);
+    }
+  });
+
+  it("keeps the price on one line, bold, in primary", () => {
+    const price = ruleFor(/\.menu__price\b|\.menu\b.*\bdd\b/);
+    expect(price, "menu dd rule").toBeDefined();
+    expect(price?.body).toMatch(/(^|;\s*)white-space: nowrap(;|$)/);
+    expect(price?.body).toMatch(/(^|;\s*)font-weight: 700(;|$)/);
+    expect(price?.body).toContain("var(--color-primary)");
+  });
+
+  it("lets the name shrink and wrap", () => {
+    const name = ruleFor(/\.menu__name\b|\.menu\b.*\bdt\b/);
+    expect(name, "menu dt rule").toBeDefined();
+    expect(name?.body).toMatch(/(^|;\s*)min-width: 0(;|$)/);
+    expect(name?.body).toMatch(/overflow-wrap: (anywhere|break-word)/);
+  });
+
+  it("puts the groups in two columns with gap var(--space-6) from 768 px", () => {
+    const md = mediaBlock(css, /@media\s*\(\s*min-width:\s*768px\s*\)/);
+    expect(md, "@media (min-width: 768px) block").not.toBe("");
+    const list = parseRules(md).find(
+      (rule) => /\.menu\b/.test(rule.selector) && /grid-template-columns:/.test(rule.body),
+    );
+    expect(list, "two-column rule").toBeDefined();
+    expect(list?.body).toMatch(/grid-template-columns: (1fr 1fr|repeat\(2,[^)]+\))/);
+    expect(list?.body).toMatch(/(^|;\s*)gap: var\(--space-6\)(;|$)/);
+  });
+});

