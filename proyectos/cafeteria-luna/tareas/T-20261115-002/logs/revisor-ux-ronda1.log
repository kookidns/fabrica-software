@media (min-width: 768px) {
  :root {
    --text-base: 1.0625rem;
    --text-lg: 1.25rem;
    --text-xl: 1.75rem;
    --text-2xl: 2.5rem;
    --text-3xl: 3.75rem;
    --gutter: var(--space-5);
    --header-height: 64px;
  }
