diff --git a/src/sections/menu.ts b/src/sections/menu.ts
new file mode 100644
index 0000000..d8b2289
--- /dev/null
+++ b/src/sections/menu.ts
@@ -0,0 +1,47 @@
+import type { Business, MenuItem } from "../data/business";
+import { formatPrice } from "../lib/formatPrice";
+
+/**
+ * "Menú" section: one card per group (Bebidas, Postres), each a <dl> of name + price rows.
+ * Products, locale and currency arrive as parameters from src/data/business.ts via main.ts (D-00);
+ * prices are formatted only by formatPrice (D-06). Text goes in with textContent only.
+ */
+
+export interface Money {
+  locale: string;
+  currency: string;
+}
+
+function renderGroup(title: string, items: MenuItem[], money: Money): HTMLElement {
+  const group = document.createElement("div");
+  group.className = "menu__group";
+
+  const heading = document.createElement("h3");
+  heading.className = "menu__title";
+  heading.textContent = title;
+
+  const list = document.createElement("dl");
+  list.className = "menu__list";
+  for (const item of items) {
+    const row = document.createElement("div");
+    row.className = "menu__item";
+    const name = document.createElement("dt");
+    name.className = "menu__name";
+    name.textContent = item.name;
+    const price = document.createElement("dd");
+    price.className = "menu__price";
+    price.textContent = formatPrice(item.price, money.locale, money.currency);
+    row.append(name, price);
+    list.append(row);
+  }
+
+  group.append(heading, list);
+  return group;
+}
+
+export function renderMenu(menu: Business["menu"], money: Money): HTMLElement {
+  const container = document.createElement("div");
+  container.className = "menu";
+  container.append(renderGroup("Bebidas", menu.drinks, money), renderGroup("Postres", menu.desserts, money));
+  return container;
+}
diff --git a/src/styles/menu.css b/src/styles/menu.css
new file mode 100644
