import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { describe, expect, it } from "vitest";
import { formatPrice } from "./formatPrice";

const libDir = dirname(fileURLToPath(import.meta.url));

// Expected values come from Intl itself, so the tests do not depend on the ICU version.
const intl = (price: number, locale: string, currency: string): string =>
  new Intl.NumberFormat(locale, { style: "currency", currency }).format(price);

describe("CA-1: formatPrice formats with Intl for es-MX / MXN", () => {
  it("formats 45 exactly like Intl.NumberFormat, with $ and 45", () => {
    const result = formatPrice(45, "es-MX", "MXN");
    expect(result).toBe(intl(45, "es-MX", "MXN"));
    expect(result).toContain("$");
    expect(result).toContain("45");
  });

  it("leaves thousands and decimal separators to Intl (1250.5)", () => {
    expect(formatPrice(1250.5, "es-MX", "MXN")).toBe(intl(1250.5, "es-MX", "MXN"));
  });
});

describe("CA-2: the currency comes from the parameters", () => {
  it("formats 45 in es-ES / EUR like Intl, with €", () => {
    const result = formatPrice(45, "es-ES", "EUR");
    expect(result).toBe(intl(45, "es-ES", "EUR"));
    expect(result).toContain("€");
  });
});

describe("CA-3: invalid prices throw", () => {
  it.each([Number.NaN, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY, -1, -0.01])("throws for %s", (price) => {
    expect(() => formatPrice(price, "es-MX", "MXN")).toThrow(Error);
  });

  it("accepts 0", () => {
    expect(formatPrice(0, "es-MX", "MXN")).toBe(intl(0, "es-MX", "MXN"));
  });
});

describe("CA-4: formatPrice.ts source", () => {
  const source = readFileSync(resolve(libDir, "formatPrice.ts"), "utf8");

  it("uses Intl.NumberFormat with style currency", () => {
    expect(source).toContain("Intl.NumberFormat");
    expect(source).toMatch(/style:\s*["']currency["']/);
  });

  it("hard-codes neither es-MX nor MXN and does not import business", () => {
    expect(source).not.toContain("es-MX");
    expect(source).not.toContain("MXN");
    expect(source).not.toMatch(/import[^;]*\bbusiness\b/);
    expect(source).not.toMatch(/from\s+["'][^"']*data\/business["']/);
  });

  it("does not use the DOM", () => {
    expect(source).not.toMatch(/\bdocument\b/);
    expect(source).not.toMatch(/\bwindow\b/);
  });
});
import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { beforeEach, describe, expect, it, vi } from "vitest";
import { business } from "./data/business";
import { buildWhatsAppUrl } from "./lib/whatsapp";
import { formatPrice } from "./lib/formatPrice";

const srcDir = dirname(fileURLToPath(import.meta.url));
const readSource = (relativePath: string): string => readFileSync(resolve(srcDir, relativePath), "utf8");
const indexBody = (): HTMLElement =>
  new DOMParser().parseFromString(readSource("../index.html"), "text/html").body;

const BUTTON_TEXT = "Reservar mesa por WhatsApp";

// main.ts mounts on import, so the page body must be in place before each import.
const loadPage = (body: HTMLElement = indexBody()): void => {
  document.body.replaceWith(document.importNode(body, true));
};

const reserveLinks = (): HTMLAnchorElement[] =>
  Array.from(document.querySelectorAll("a")).filter((a) => a.textContent?.trim() === BUTTON_TEXT);

beforeEach(() => {
  vi.resetModules();
});

describe("CA-10: mounting index.html", () => {
  it("fills #inicio with the h1 and slogan from business, leaving a single <h1>", async () => {
    loadPage();
    await import("./main");
    const hero = document.getElementById("inicio");
    expect(hero?.querySelector("h1")?.textContent).toBe(business.name);
    expect(hero?.querySelector("p")?.textContent).toBe(business.slogan);
    expect(document.querySelectorAll("h1")).toHaveLength(1);
  });

  it("adds the reserve text and button after the <h2> of #reservar", async () => {
    loadPage();
    await import("./main");
    const h2 = document.querySelector("#reservar h2");
    const after = h2?.nextElementSibling;
    expect(after?.querySelector("p")?.textContent).toMatch(/^¿Quieres asegurar tu mesa\?/);
    expect(after?.querySelector("a")?.textContent?.trim()).toBe(BUTTON_TEXT);
  });

  it("has exactly two reserve buttons, in #inicio and #reservar, with the same buildWhatsAppUrl href", async () => {
    loadPage();
    await import("./main");
    const expected = buildWhatsAppUrl(business.whatsapp.number, business.whatsapp.message);
    expect(expected.startsWith("https://wa.me/520000000000?text=")).toBe(true);
    const decoded = decodeURIComponent(expected.split("?text=")[1] ?? "").toLowerCase();
    for (const word of ["fecha", "hora", "personas"]) {
      expect(decoded).toContain(word);
    }

    const links = reserveLinks();
    expect(links).toHaveLength(2);
    expect(links[0]?.closest("section")?.id).toBe("inicio");
    expect(links[1]?.closest("section")?.id).toBe("reservar");
    for (const link of links) {
      expect(link.getAttribute("href")).toBe(expected);
    }
  });
});

describe("CA-11: a missing mount container fails loudly", () => {
  it("throws on import naming #reservar when that section is missing", async () => {
    const body = indexBody();
    body.querySelector("#reservar")?.remove();
    loadPage(body);
    await expect(import("./main")).rejects.toThrow("#reservar");
  });

  it("throws from mount() naming #inicio when that section is missing, without touching the page", async () => {
    loadPage();
    const { mount } = await import("./main");
    const broken = document.implementation.createHTMLDocument("broken");
    broken.body.replaceWith(broken.importNode(indexBody(), true));
    broken.querySelector("#inicio")?.remove();
    expect(() => mount(broken)).toThrow("#inicio");
    expect(broken.querySelectorAll("a.btn--whatsapp")).toHaveLength(0);
  });
});

describe("CA-12: no HTML injection APIs and no business data in the sections", () => {
  const forbiddenApis = ["innerHTML", "outerHTML", "insertAdjacentHTML"];

  it.each(["main.ts", "sections/hero.ts", "sections/reserve.ts"])("%s uses no HTML-string DOM API", (file) => {
    const source = readSource(file);
    for (const api of forbiddenApis) {
      expect(source, `${file} contains ${api}`).not.toContain(api);
    }
  });

  it.each(["sections/hero.ts", "sections/reserve.ts"])("%s holds no business data and does not import it", (file) => {
    const source = readSource(file);
    expect(source).not.toContain(business.slogan);
    expect(source).not.toContain(business.whatsapp.number);
    expect(source).not.toContain(business.whatsapp.message);
    for (const line of business.whatsapp.message.split("\n")) {
      if (line.trim().length > 8) expect(source).not.toContain(line.trim());
    }
    expect(source).not.toMatch(/import[^;]*\bbusiness\b/);
    expect(source).not.toMatch(/from\s+["'][^"']*data\/business["']/);
  });
});

