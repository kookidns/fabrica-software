import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { describe, expect, it } from "vitest";
import { business, type Business } from "../data/business";
import { formatPrice } from "../lib/formatPrice";
import { renderMenu } from "./menu";

const sectionsDir = dirname(fileURLToPath(import.meta.url));

// Test data, deliberately different from business.ts.
const MENU: Business["menu"] = {
  drinks: [
    { name: "Té verde", price: 30 },
    { name: "Espresso doble", price: 1250.5 },
  ],
  desserts: [
    { name: "Galleta", price: 0 },
    { name: "Brownie", price: 38 },
    { name: "Flan napolitano", price: 52 },
  ],
};
const MONEY = { locale: "es-MX", currency: "MXN" };

const groupsOf = (element: HTMLElement): Element[] =>
  Array.from(element.querySelectorAll("h3"), (h3) => h3.parentElement).filter((el): el is HTMLElement => el !== null);

describe("CA-5: renderMenu returns the Bebidas and Postres groups", () => {
  it("has exactly two groups, in order, each with an <h3> and a <dl>", () => {
    const element = renderMenu(MENU, MONEY);
    const groups = groupsOf(element);
    expect(groups).toHaveLength(2);
    expect(element.querySelectorAll("h3")).toHaveLength(2);
    expect(groups.map((group) => group.querySelector("h3")?.textContent)).toEqual(["Bebidas", "Postres"]);
    for (const group of groups) {
      expect(group.querySelectorAll("dl")).toHaveLength(1);
    }
  });
});

describe("CA-6: each <dl> lists the products in order as <div><dt><dd>", () => {
  const element = renderMenu(MENU, MONEY);
  const [drinksGroup, dessertsGroup] = groupsOf(element);

  it.each([
    ["Bebidas", drinksGroup, MENU.drinks],
    ["Postres", dessertsGroup, MENU.desserts],
  ] as const)("%s: one <div> per item with name and formatted price", (_label, group, items) => {
    const list = group?.querySelector("dl");
    const children = Array.from(list?.children ?? []);
    expect(children.map((child) => child.tagName)).toEqual(items.map(() => "DIV"));
    children.forEach((row, index) => {
      const item = items[index];
      expect(Array.from(row.children).map((child) => child.tagName)).toEqual(["DT", "DD"]);
      expect(row.querySelector("dt")?.textContent).toBe(item?.name);
      expect(row.querySelector("dd")?.textContent).toBe(formatPrice(item?.price ?? Number.NaN, "es-MX", "MXN"));
    });
    expect(group?.querySelectorAll("dt")).toHaveLength(items.length);
  });

  it("uses the locale and currency it receives", () => {
    const euros = renderMenu(MENU, { locale: "es-ES", currency: "EUR" });
    expect(euros.querySelector("dd")?.textContent).toBe(formatPrice(30, "es-ES", "EUR"));
  });
});

describe("CA-7: product names are painted as text", () => {
