+/* Sección Menú: tarjetas Bebidas / Postres; solo var(--…) de tokens.css (D-02, brain/diseno.md → Tarjeta). */
+
+/* Móvil: una columna, una tarjeta debajo de otra. */
+.menu {
+  display: grid;
+  gap: var(--space-5);
+}
+
+/* Tarjeta informativa, sin hover. */
+.menu__group {
+  min-width: 0;
+  padding: var(--space-5);
+  background: var(--color-surface-raised);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+  box-shadow: var(--shadow-sm);
+}
+
+.menu__title {
+  margin-bottom: var(--space-4);
+  font-size: var(--text-xl);
+  font-weight: 600;
+}
+
+.menu__list {
+  margin: 0;
+}
+
+/* Nombre a la izquierda y precio a la derecha, en la misma fila y alineados a la línea base. */
+.menu__item {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: baseline;
+  column-gap: var(--space-4);
+  padding-block: var(--space-3);
+}
+
+/* Separador solo decorativo entre productos. */
+.menu__item + .menu__item {
+  border-top: 1px solid var(--color-border);
+}
+
+.menu__item:first-child {
+  padding-top: 0;
+}
+
+.menu__item:last-child {
+  padding-bottom: 0;
+}
+
+/* Un nombre largo pasa a varias líneas sin empujar el precio fuera (CA-02.3). */
+.menu__name {
+  min-width: 0;
+  font-size: var(--text-lg);
+  color: var(--color-text);
+  overflow-wrap: anywhere;
+}
+
+/* El precio nunca se parte. */
+.menu__price {
+  margin: 0;
+  font-size: var(--text-lg);
+  font-weight: 700;
+  color: var(--color-primary);
+  white-space: nowrap;
+  text-align: end;
+}
+
+/* Desde 768 px: Bebidas | Postres en dos columnas. */
+@media (min-width: 768px) {
+  .menu {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: var(--space-6);
+    align-items: start;
+  }
+}
