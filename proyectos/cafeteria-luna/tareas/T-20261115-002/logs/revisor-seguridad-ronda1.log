+const intl = (price: number, locale: string, currency: string): string =>
+  new Intl.NumberFormat(locale, { style: "currency", currency }).format(price);
+
+describe("CA-1: formatPrice formats with Intl for es-MX / MXN", () => {
+  it("formats 45 exactly like Intl.NumberFormat, with $ and 45", () => {
