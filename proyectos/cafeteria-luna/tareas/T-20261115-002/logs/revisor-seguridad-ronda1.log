import type { Business, MenuItem } from "../data/business";
import { formatPrice } from "../lib/formatPrice";

/**
 * "Menú" section: one card per group (Bebidas, Postres), each a <dl> of name + price rows.
 * Products, locale and currency arrive as parameters from src/data/business.ts via main.ts (D-00);
 * prices are formatted only by formatPrice (D-06). Text goes in with textContent only.
 */

export interface Money {
  locale: string;
  currency: string;
}

function renderGroup(title: string, items: MenuItem[], money: Money): HTMLElement {
  const group = document.createElement("div");
  group.className = "menu__group";

  const heading = document.createElement("h3");
  heading.className = "menu__title";
  heading.textContent = title;

  const list = document.createElement("dl");
  list.className = "menu__list";
  for (const item of items) {
    const row = document.createElement("div");
    row.className = "menu__item";
    const name = document.createElement("dt");
    name.className = "menu__name";
    name.textContent = item.name;
    const price = document.createElement("dd");
    price.className = "menu__price";
    price.textContent = formatPrice(item.price, money.locale, money.currency);
    row.append(name, price);
    list.append(row);
  }

  group.append(heading, list);
  return group;
}

export function renderMenu(menu: Business["menu"], money: Money): HTMLElement {
  const container = document.createElement("div");
  container.className = "menu";
  container.append(renderGroup("Bebidas", menu.drinks, money), renderGroup("Postres", menu.desserts, money));
  return container;
}
/**
 * Single place that turns a price into text (D-06). Pure function: locale and currency come from
 * src/data/business.ts through the caller, never from here.
 */
export function formatPrice(price: number, locale: string, currency: string): string {
  // Fail loudly instead of painting "$NaN" or a negative price.
  if (!Number.isFinite(price) || price < 0) {
    throw new Error(`Invalid price: ${String(price)}`);
  }
  return new Intl.NumberFormat(locale, { style: "currency", currency }).format(price);
}
import "./styles/tokens.css";
import "./styles/main.css";
import "./styles/menu.css";
import { business } from "./data/business";
import { buildWhatsAppUrl } from "./lib/whatsapp";
import { renderHero } from "./sections/hero";
import { renderMenu } from "./sections/menu";
import { renderReserve } from "./sections/reserve";

function requireElement(doc: Document, selector: string): Element {
  const element = doc.querySelector(selector);
  if (!element) {
    throw new Error(`Mount container not found in index.html: ${selector}`);
  }
  return element;
}

/** Paints the business data into the static skeleton of index.html (D-04). */
export function mount(doc: Document): void {
  // Look up every container first so a missing one fails before the page is half painted.
  const hero = requireElement(doc, "#inicio");
  const menuHeading = requireElement(doc, "#menu h2");
  const reserveHeading = requireElement(doc, "#reservar h2");

  // Built once so both reserve buttons point to exactly the same URL.
  const reserveUrl = buildWhatsAppUrl(business.whatsapp.number, business.whatsapp.message);
  // Built before painting: an invalid price throws here, leaving the page untouched.
  const menu = renderMenu(business.menu, { locale: business.locale, currency: business.currency });

  hero.append(renderHero({ name: business.name, slogan: business.slogan }, reserveUrl));
  menuHeading.after(menu);
  reserveHeading.after(renderReserve(reserveUrl));
}

mount(document);
