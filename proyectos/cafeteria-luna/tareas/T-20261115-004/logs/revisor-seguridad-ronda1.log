+++ b/src/sections/location.guards.test.ts
@@ -0,0 +1,85 @@
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { Business } from "../data/business";
+import { renderLocation } from "./location";
+
+// T-20261115-004: the URL prefix guards of createMap and createDirectionsLink. src/lib/maps.ts always
+// returns valid URLs, so it is mocked here. Separate file: vi.mock applies to the whole file and must
+// not reach location.test.ts.
+const maps = vi.hoisted(() => ({
+  buildMapEmbedUrl: vi.fn<(lat: number, lng: number) => string>(),
+  buildDirectionsUrl: vi.fn<(lat: number, lng: number) => string>(),
+}));
+vi.mock("../lib/maps", () => maps);
+
+const sectionsDir = dirname(fileURLToPath(import.meta.url));
+
+const LOCATION: Pick<Business, "hours" | "address" | "coordinates"> = {
+  hours: [
+    { day: "Lunes", closed: true },
+    { day: "Martes", open: "07:30", close: "19:00" },
+    { day: "Miércoles", open: "07:30", close: "19:00" },
+    { day: "Jueves", open: "07:30", close: "19:00" },
+    { day: "Viernes", open: "07:30", close: "22:15" },
+    { day: "Sábado", open: "10:00", close: "22:15" },
+    { day: "Domingo", closed: true },
+  ],
+  address: "Avenida de Prueba 456, Col. Pruebas, 11111 Guadalajara, Jalisco, México",
+  coordinates: { lat: 20.6597, lng: -103.3496 },
+};
+
+const MAP_PREFIX = "https://www.openstreetmap.org/export/embed.html?";
+const DIRECTIONS_PREFIX = "https://www.google.com/maps/search/?";
+const VALID_MAP = `${MAP_PREFIX}prueba=1`;
+const VALID_DIRECTIONS = `${DIRECTIONS_PREFIX}prueba=1`;
+
+beforeEach(() => {
+  maps.buildMapEmbedUrl.mockReset().mockReturnValue(VALID_MAP);
+  maps.buildDirectionsUrl.mockReset().mockReturnValue(VALID_DIRECTIONS);
+});
+
+describe("CA-14: the map guard rejects anything but the OpenStreetMap embed prefix", () => {
+  it.each([
+    "javascript:alert(1)",
+    "http://www.openstreetmap.org/export/embed.html?bbox=0",
+    "https://www.openstreetmap.org.example.com/export/embed.html?bbox=0",
+  ])("throws for %s", (url) => {
+    maps.buildMapEmbedUrl.mockReturnValue(url);
+    expect(() => renderLocation(LOCATION)).toThrow(Error);
+    expect(() => renderLocation(LOCATION)).toThrow(MAP_PREFIX);
+  });
+});
+
+describe("CA-15: the directions guard rejects anything but the Google Maps search prefix", () => {
+  it.each([
+    "javascript:alert(1)",
+    "http://www.google.com/maps/search/?api=1",
+    "https://www.google.com.example.com/maps/search/?api=1",
+  ])("throws for %s", (url) => {
+    maps.buildDirectionsUrl.mockReturnValue(url);
+    expect(() => renderLocation(LOCATION)).toThrow(Error);
+    expect(() => renderLocation(LOCATION)).toThrow(DIRECTIONS_PREFIX);
+  });
+});
+
+describe("CA-16: the guards let legitimate URLs through untouched", () => {
+  it("uses the exact URLs for the iframe src and the Cómo llegar href", () => {
+    let element: HTMLElement | undefined;
+    expect(() => {
+      element = renderLocation(LOCATION);
+    }).not.toThrow();
+    expect(element?.querySelector("iframe")?.getAttribute("src")).toBe(VALID_MAP);
+    const link = Array.from(element?.querySelectorAll("a") ?? []).find((a) => a.textContent?.trim() === "Cómo llegar");
+    expect(link?.getAttribute("href")).toBe(VALID_DIRECTIONS);
+  });
+});
+
+describe("CA-17: the sandbox comment names MapLibre, not Leaflet", () => {
+  it("does not mention Leaflet and mentions MapLibre", () => {
+    const source = readFileSync(resolve(sectionsDir, "location.ts"), "utf8");
+    expect(source).not.toContain("Leaflet");
+    expect(source).toContain("MapLibre");
+  });
+});
