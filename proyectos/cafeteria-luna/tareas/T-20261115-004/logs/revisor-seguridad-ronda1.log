@@ -0,0 +1,136 @@
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+// T-20261115-004: accessibility of the mounted page (CA-05.2, CA-05.4), with the real business.ts data.
+
+const srcDir = dirname(fileURLToPath(import.meta.url));
+const indexBody = (): HTMLElement =>
+  new DOMParser().parseFromString(readFileSync(resolve(srcDir, "../index.html"), "utf8"), "text/html").body;
+
+const squash = (value: string | null | undefined): string => (value ?? "").replace(/\s+/g, " ").trim();
+
+// Same approach as loadPage() in main.test.ts: main.ts mounts on import.
+const mountPage = async (): Promise<void> => {
+  document.body.replaceWith(document.importNode(indexBody(), true));
+  await import("./main");
+};
+
+const TAP_CLASSES = ["skip-link", "brand", "nav-link", "btn"];
+const FOCUSABLE = 'a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])';
+const NEW_TAB_SUFFIX = "(se abre en una pestaña nueva)";
+
+beforeEach(async () => {
+  vi.resetModules();
+  await mountPage();
+});
+
+describe("CA-1: one labelled heading per section", () => {
+  it("labels every main > section with an h1/h2 inside that section", () => {
+    const sections = Array.from(document.querySelectorAll<HTMLElement>("main > section"));
+    expect(sections.length).toBeGreaterThan(0);
+    for (const section of sections) {
+      const id = section.getAttribute("aria-labelledby");
+      expect(id, `aria-labelledby of #${section.id}`).toBeTruthy();
+      const heading = document.getElementById(id ?? "");
+      expect(heading, `#${id}`).not.toBeNull();
+      expect(["H1", "H2"], `#${id} tag`).toContain(heading?.tagName);
+      expect(section.contains(heading), `#${id} inside #${section.id}`).toBe(true);
+      expect(squash(heading?.textContent), `text of #${id}`).not.toBe("");
+    }
+  });
+
+  it("has exactly one h1 or h2 in each section", () => {
+    for (const section of document.querySelectorAll<HTMLElement>("main > section")) {
+      expect(section.querySelectorAll("h1, h2"), `#${section.id}`).toHaveLength(1);
+    }
+  });
+
+  it("has a single h1 in the document, inside #inicio", () => {
+    const h1s = document.querySelectorAll("h1");
+    expect(h1s).toHaveLength(1);
+    expect(h1s[0]?.closest("section")?.id).toBe("inicio");
+  });
+});
+
+describe("CA-2: heading levels", () => {
+  it("starts at h1 and never skips a level going down", () => {
+    const levels = Array.from(document.querySelectorAll("h1, h2, h3, h4, h5, h6"), (h) => Number(h.tagName[1]));
+    expect(levels[0]).toBe(1);
+    levels.forEach((level, index) => {
+      if (index === 0) return;
+      const previous = levels[index - 1] ?? 1;
+      expect(level - previous, `h${previous} → h${level} at position ${index}`).toBeLessThanOrEqual(1);
+    });
+  });
+});
+
+describe("CA-3: images, graphics and the iframe", () => {
+  it("gives every <img> an alt attribute", () => {
+    for (const img of document.querySelectorAll("img")) {
+      expect(img.hasAttribute("alt"), img.outerHTML).toBe(true);
+    }
+  });
+
+  it("hides every <svg> or names it as an image", () => {
+    for (const svg of document.querySelectorAll("svg")) {
+      const hidden = svg.getAttribute("aria-hidden") === "true";
+      const named = svg.getAttribute("role") === "img" && squash(svg.getAttribute("aria-label")) !== "";
+      expect(hidden || named, svg.outerHTML).toBe(true);
+    }
+  });
+
+  it("gives the iframe a non-empty title", () => {
+    const iframes = document.querySelectorAll("iframe");
+    expect(iframes.length).toBeGreaterThan(0);
+    for (const iframe of iframes) {
+      expect(squash(iframe.getAttribute("title"))).not.toBe("");
+    }
+  });
+});
+
+describe("CA-4: WhatsApp buttons announce their purpose", () => {
+  const whatsappLinks = (): HTMLAnchorElement[] =>
+    Array.from(document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me/"]'));
+
+  it("has exactly two, one in #inicio and one in #reservar", () => {
+    expect(whatsappLinks().map((a) => a.closest("section")?.id)).toEqual(["inicio", "reservar"]);
+  });
+
+  it("has an aria-label that starts with the visible text, names WhatsApp and warns of the new tab", () => {
+    for (const link of whatsappLinks()) {
+      const visible = squash(link.textContent);
+      const label = link.getAttribute("aria-label") ?? "";
+      expect(visible).toBe("Reservar mesa por WhatsApp");
+      expect(label.startsWith(visible), label).toBe(true);
+      expect(label).toContain("WhatsApp");
+      expect(label.endsWith(NEW_TAB_SUFFIX), label).toBe(true);
+    }
+  });
+
+  it("hides its icon from assistive technology", () => {
+    for (const link of whatsappLinks()) {
+      const svg = link.querySelector("svg");
+      expect(svg).not.toBeNull();
+      expect(svg?.getAttribute("aria-hidden")).toBe("true");
+    }
+  });
+});
+
+describe("CA-5: every focusable element is named and uses a 44 px class", () => {
+  it("names each focusable element (except the iframe) and gives it skip-link, brand, nav-link or btn", () => {
+    const focusables = Array.from(document.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
+      (element) => element.tagName !== "IFRAME",
+    );
+    expect(focusables.length).toBeGreaterThan(0);
+    for (const element of focusables) {
+      const name = squash(element.getAttribute("aria-label")) || squash(element.textContent);
+      expect(name, element.outerHTML).not.toBe("");
+      expect(
+        TAP_CLASSES.some((cls) => element.classList.contains(cls)),
+        `${element.outerHTML} needs one of ${TAP_CLASSES.join(", ")}`,
+      ).toBe(true);
+    }
+  });
+});
