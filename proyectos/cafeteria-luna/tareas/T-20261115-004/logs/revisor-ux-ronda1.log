diff --git a/src/styles/split.test.ts b/src/styles/split.test.ts
new file mode 100644
index 0000000..af52633
--- /dev/null
+++ b/src/styles/split.test.ts
@@ -0,0 +1,286 @@
+import { existsSync, readdirSync, readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+// T-20261115-004: main.css split (decision 1), tap targets and focus ring (CA-05.2) read from the CSS.
+
+const stylesDir = dirname(fileURLToPath(import.meta.url));
+const stripComments = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
+const normalize = (value: string): string => value.replace(/\s+/g, " ").trim();
+const readRaw = (file: string): string => readFileSync(resolve(stylesDir, file), "utf8");
+
+// "@media (min-width: 768px)" whatever the spacing; "" for top-level rules.
+const normalizeQuery = (query: string): string =>
+  normalize(query)
+    .toLowerCase()
+    .replace(/\(\s*/g, "(")
+    .replace(/\s*\)/g, ")")
+    .replace(/\s*:\s*/g, ": ");
+
+interface CssRule {
+  file: string;
+  context: string;
+  selectors: string[];
+  body: string;
+  /** Offset in the comment-free source, to compare the order of two rules. */
+  start: number;
+}
+
+const toRule = (file: string, context: string, prelude: string, body: string, start: number): CssRule => ({
+  file,
+  context,
+  selectors: prelude.split(",").map(normalize).filter(Boolean),
+  body: normalize(body),
+  start,
+});
+
+// Top-level rules and rules one level inside an @-block (all this project uses).
+const parseCss = (file: string): CssRule[] => {
+  const css = stripComments(readRaw(file));
+  const rules: CssRule[] = [];
+  let index = 0;
+  while (index < css.length) {
+    const open = css.indexOf("{", index);
+    if (open < 0) break;
+    const prelude = css.slice(index, open);
+    if (prelude.trim().startsWith("@")) {
+      let depth = 0;
+      let end = open;
+      for (; end < css.length; end += 1) {
+        if (css[end] === "{") depth += 1;
+        if (css[end] === "}") depth -= 1;
+        if (depth === 0) break;
+      }
+      const inner = css.slice(open + 1, end);
+      const context = normalizeQuery(prelude);
+      for (const match of inner.matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
+        rules.push(toRule(file, context, match[1] ?? "", match[2] ?? "", open + 1 + (match.index ?? 0)));
+      }
+      index = end + 1;
+    } else {
+      const close = css.indexOf("}", open);
+      rules.push(toRule(file, "", prelude, css.slice(open + 1, close), index));
+      index = close + 1;
+    }
+  }
+  return rules;
+};
+
+const declarations = (body: string): Map<string, string> => {
+  const map = new Map<string, string>();
+  for (const part of body.split(";")) {
+    const colon = part.indexOf(":");
+    if (colon < 0) continue;
+    map.set(part.slice(0, colon).trim(), part.slice(colon + 1).trim());
+  }
+  return map;
+};
+
+const MD = "@media (min-width: 768px)";
+const NO_PREFERENCE = "@media (prefers-reduced-motion: no-preference)";
+const REDUCE = "@media (prefers-reduced-motion: reduce)";
+
+const STYLE_FILES = [
+  "tokens.css",
+  "main.css",
+  "header.css",
+  "buttons.css",
+  "hero.css",
+  "reserve.css",
+  "footer.css",
+  "menu.css",
+  "location.css",
+];
+
+// Decision 1 of the spec: file → context → exact selectors (selector lists split on commas).
+const SPLIT: Record<string, Record<string, string[]>> = {
+  "main.css": {
+    "": [
+      "*",
+      "*::before",
+      "*::after",
+      "body",
+      "h1",
+      "h2",
+      "h3",
+      "p",
+      "a",
+      ".container",
+      ":focus-visible",
+      "main:focus",
+      "main > section",
+      "main > section:nth-of-type(even)",
+      "main > section h2",
+    ],
+    [MD]: ["main > section"],
+    [NO_PREFERENCE]: ["html"],
+    [REDUCE]: ["*", "*::before", "*::after"],
+  },
+  "header.css": {
+    "": [
+      ".skip-link",
+      ".skip-link:not(:focus)",
+      ".site-header",
+      ".site-header__inner",
+      ".brand",
+      ".site-nav",
+      ".site-nav__list",
+      ".nav-link",
+      ".nav-link:hover",
+    ],
+    [MD]: [".site-header__inner", ".site-nav", ".site-nav__list"],
+  },
+  "buttons.css": {
+    "": [".btn", ".btn:active", ".btn__icon", ".btn--whatsapp", ".btn--whatsapp:hover", ".btn--secondary", ".btn--secondary:hover"],
+    [MD]: [".btn--whatsapp", ".btn--secondary"],
+    [REDUCE]: [".btn:active"],
+  },
+  "hero.css": {
+    "": [".hero", ".hero__content", ".hero__title", ".hero__slogan"],
+    [MD]: [".hero"],
+  },
+  "reserve.css": {
+    "": [".reserve__text"],
+  },
+  "footer.css": {
+    "": [".site-footer", ".site-footer a", ".site-footer :focus-visible", ".site-footer__name", ".site-footer__notice"],
+  },
+};
+
+const allCssFiles = readdirSync(stylesDir).filter((file) => file.endsWith(".css"));
+const parsed = new Map(allCssFiles.map((file) => [file, parseCss(file)]));
+const rulesOf = (file: string): CssRule[] => parsed.get(file) ?? [];
+const exactRule = (file: string, selector: string, context = ""): CssRule | undefined =>
+  rulesOf(file).find((rule) => rule.context === context && rule.selectors.length === 1 && rule.selectors[0] === selector);
+
+// Token values in px (1rem = 16px), at the base and from 768 px.
+const tokenPx = (): { base: Map<string, number>; md: Map<string, number> } => {
+  const toPx = (value: string): number => {
+    const match = value.match(/^([\d.]+)(px|rem)$/);
+    if (!match) return Number.NaN;
+    return Number(match[1]) * (match[2] === "rem" ? 16 : 1);
+  };
+  const pick = (rules: CssRule[]): Map<string, number> => {
+    const map = new Map<string, number>();
+    for (const rule of rules) {
+      for (const [name, value] of declarations(rule.body)) map.set(name, toPx(value));
+    }
+    return map;
+  };
+  const tokens = rulesOf("tokens.css").filter((rule) => rule.selectors.includes(":root"));
+  const base = pick(tokens.filter((rule) => rule.context === ""));
+  const md = new Map([...base, ...pick(tokens.filter((rule) => rule.context === MD))]);
+  return { base, md };
+};
+
+describe("CA-6: 44 px tap targets declared in header.css and buttons.css", () => {
+  const { base, md } = tokenPx();
+  const ALLOWED = ["var(--tap-min)", "var(--header-height)", "var(--space-7)"];
+
+  it("resolves every allowed min-height token to 44 px or more, on mobile and from 768 px", () => {
+    for (const token of ["--tap-min", "--header-height", "--space-7"]) {
+      expect(base.get(token), `${token} (base)`).toBeGreaterThanOrEqual(44);
+      expect(md.get(token), `${token} (768 px)`).toBeGreaterThanOrEqual(44);
+    }
+  });
+
+  it.each([
+    ["header.css", ".skip-link"],
+    ["header.css", ".brand"],
+    ["header.css", ".nav-link"],
+    ["buttons.css", ".btn"],
+  ])("%s %s declares min-height with an allowed token", (file, selector) => {
+    const rule = exactRule(file, selector);
+    expect(rule, `${selector} in ${file}`).toBeDefined();
+    expect(ALLOWED).toContain(declarations(rule?.body ?? "").get("min-height"));
+  });
+
+  it.each([
+    ["header.css", ".nav-link"],
+    ["buttons.css", ".btn"],
+  ])("%s %s declares min-width: var(--tap-min)", (file, selector) => {
+    expect(declarations(exactRule(file, selector)?.body ?? "").get("min-width")).toBe("var(--tap-min)");
+  });
+});
+
+describe("CA-7: only main:focus removes the outline", () => {
+  const OUTLINE_OFF = [
+    /(^|;\s*)outline: (none|0)(\s*!important)?(;|$)/,
+    /(^|;\s*)outline-style: none(\s*!important)?(;|$)/,
+    /(^|;\s*)outline-width: 0(\s*!important)?(;|$)/,
+  ];
+
+  it("finds outline removals in main:focus and nowhere else in src/styles/*.css", () => {
+    const offenders = [...parsed.values()]
+      .flat()
+      .filter((rule) => OUTLINE_OFF.some((pattern) => pattern.test(rule.body)))
+      .map((rule) => `${rule.file} ${rule.context} ${rule.selectors.join(", ")}`.replace(/\s+/g, " "));
+    expect(offenders).toEqual(["main.css main:focus"]);
+  });
+});
+
+describe("CA-8: style files exist, stay under 200 lines and keep colors in tokens.css", () => {
+  it.each(STYLE_FILES)("%s exists and has at most 200 lines", (file) => {
+    expect(existsSync(resolve(stylesDir, file)), file).toBe(true);
+    const lines = readRaw(file).replace(/\r?\n$/, "").split(/\r?\n/);
+    expect(lines.length).toBeLessThanOrEqual(200);
+  });
+
+  it.each(STYLE_FILES.filter((file) => file !== "tokens.css"))("%s has no color literals", (file) => {
+    const css = stripComments(readRaw(file));
+    expect(css).not.toMatch(/#[0-9a-f]{3,8}(?![\w-])/i);
+    expect(css).not.toMatch(/\b(rgba?|hsla?)\(/i);
+  });
+});
+
+describe("CA-9: every selector of decision 1 lives in its file and context only", () => {
+  const cases = Object.entries(SPLIT).flatMap(([file, contexts]) =>
+    Object.entries(contexts).flatMap(([context, selectors]) =>
+      selectors.map((selector) => ({ file, context, selector, label: `${file} ${context || "(top level)"} ${selector}` })),
+    ),
+  );
+
+  it.each(cases)("$label", ({ file, context, selector }) => {
+    const owners = [...parsed.values()]
+      .flat()
+      .filter((rule) => rule.context === context && rule.selectors.includes(selector))
+      .map((rule) => rule.file);
+    expect(owners, `${selector} in ${context || "(top level)"}`).toContain(file);
+    expect(new Set(owners), `${selector} must not appear in another file`).toEqual(new Set([file]));
+  });
+
+  it.each(Object.keys(SPLIT))("%s contains only the selectors of decision 1 (a pure move of rules)", (file) => {
+    const expected = new Set(
+      Object.entries(SPLIT[file] ?? {}).flatMap(([context, selectors]) => selectors.map((s) => `${context}|${s}`)),
+    );
+    const actual = new Set(rulesOf(file).flatMap((rule) => rule.selectors.map((s) => `${rule.context}|${s}`)));
+    expect(actual).toEqual(expected);
+  });
+});
+
+describe("CA-10: the reduced-motion override of .btn:active moves with the button", () => {
+  it("buttons.css sets .btn:active { transform: none } in a reduce block after the base translateY(1px)", () => {
+    const baseActive = exactRule("buttons.css", ".btn:active");
+    const reduceActive = exactRule("buttons.css", ".btn:active", REDUCE);
+    expect(declarations(baseActive?.body ?? "").get("transform")).toBe("translateY(1px)");
+    expect(declarations(reduceActive?.body ?? "").get("transform")).toBe("none");
+    expect(reduceActive?.start ?? -1).toBeGreaterThan(baseActive?.start ?? Number.POSITIVE_INFINITY);
+  });
+
+  it("leaves no .btn selector in the reduce block of main.css", () => {
+    const reduceRules = rulesOf("main.css").filter((rule) => rule.context === REDUCE);
+    expect(reduceRules.length).toBeGreaterThan(0);
+    for (const rule of reduceRules) {
+      expect(rule.selectors.join(", ")).not.toMatch(/\.btn/);
+    }
+  });
+});
+
+describe("CA-11: main.ts imports the style files once each, in cascade order", () => {
+  it("imports tokens, main, header, buttons, hero, reserve, footer, menu and location, in that order", () => {
+    const source = readFileSync(resolve(stylesDir, "../main.ts"), "utf8");
+    const imports = Array.from(source.matchAll(/import\s+["'](\.\/styles\/[^"']+)["'];?/g), (match) => match[1]);
+    expect(imports).toEqual(STYLE_FILES.map((file) => `./styles/${file}`));
+  });
+});
