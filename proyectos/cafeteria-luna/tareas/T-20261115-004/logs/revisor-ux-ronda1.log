diff --git a/src/styles/buttons.css b/src/styles/buttons.css
new file mode 100644
index 0000000..98f06e0
--- /dev/null
+++ b/src/styles/buttons.css
@@ -0,0 +1,78 @@
+/* Botones compartidos (WhatsApp y contorno); solo usan var(--…) de tokens.css
+   (D-02, D-08, D-10, brain/diseno.md → Botón). Se importa antes que las secciones. */
+
+/* ── Botón ────────────────────────────────────────────── */
+/* min-width: los 44 px de ancho no dependen de la longitud del texto (CA-05.2). */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-2);
+  min-height: var(--space-7); /* 48 px (diseno.md) */
+  min-width: var(--tap-min);
+  padding: 0 var(--space-5);
+  border: 2px solid transparent;
+  border-radius: var(--radius-pill);
+  font-family: var(--font-body);
+  font-weight: 700;
+  font-size: var(--text-base);
+  line-height: var(--leading-heading);
+  text-align: center;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 150ms ease, transform 150ms ease;
+}
+
+.btn:active {
+  transform: translateY(1px);
+}
+
+.btn__icon {
+  flex: none;
+  width: var(--space-5);
+  height: var(--space-5);
+}
+
+/* Móvil: ocupa el ancho del contenedor (diseno.md). */
+.btn--whatsapp {
+  width: 100%;
+  background: var(--color-whatsapp);
+  color: var(--color-on-whatsapp);
+}
+
+/* Hover ~10 % más oscuro, mezclando con un token (sin colores a mano). */
+.btn--whatsapp:hover {
+  background: color-mix(in srgb, var(--color-whatsapp) 90%, var(--color-text));
+}
+
+/* Botón de contorno (diseno.md → Botón secondary); móvil: ancho completo.
+   El margen propio de cada sección va en el archivo de la sección (location.css). */
+.btn--secondary {
+  width: 100%;
+  background: transparent;
+  color: var(--color-primary);
+  border-color: var(--color-primary);
+}
+
+.btn--secondary:hover {
+  background: var(--color-surface);
+}
+
+/* ── Desde 768 px ─────────────────────────────────────── */
+@media (min-width: 768px) {
+  .btn--whatsapp {
+    width: auto;
+  }
+
+  .btn--secondary {
+    width: auto;
+  }
+}
+
+/* ── Movimiento reducido ──────────────────────────────── */
+/* Va después de .btn:active: con la misma especificidad, gana la última regla. */
+@media (prefers-reduced-motion: reduce) {
+  .btn:active {
+    transform: none;
+  }
+}
diff --git a/src/styles/buttons.test.ts b/src/styles/buttons.test.ts
new file mode 100644
index 0000000..c702eea
--- /dev/null
+++ b/src/styles/buttons.test.ts
@@ -0,0 +1,110 @@
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+// T-20261115-004 CA-12: .btn--secondary moves from location.css to buttons.css (decision 1, D-10).
+
+const stylesDir = dirname(fileURLToPath(import.meta.url));
+const stripComments = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
+const normalize = (value: string): string => value.replace(/\s+/g, " ").trim();
+const readCss = (file: string): string => {
+  const path = resolve(stylesDir, file);
+  return existsSync(path) ? stripComments(readFileSync(path, "utf8")) : "";
+};
+
+interface CssRule {
+  selector: string;
+  body: string;
+}
+
+// Innermost rules only (rules nested in @media come out with their own selector).
+const parseRules = (source: string): CssRule[] =>
+  Array.from(source.matchAll(/([^{}]+)\{([^{}]*)\}/g), (match) => ({
+    selector: normalize(match[1] ?? ""),
+    body: normalize(match[2] ?? ""),
+  }));
+
+// Splits the stylesheet into the top-level part and the bodies of its @-blocks, braces balanced.
+const splitAtBlocks = (source: string): { base: string; blocks: { query: string; body: string }[] } => {
+  let base = "";
+  const blocks: { query: string; body: string }[] = [];
+  let index = 0;
+  while (index < source.length) {
+    const at = source.indexOf("@", index);
+    if (at < 0) {
+      base += source.slice(index);
+      break;
+    }
+    base += source.slice(index, at);
+    const open = source.indexOf("{", at);
+    let depth = 0;
+    let end = open;
+    for (; end < source.length; end += 1) {
+      if (source[end] === "{") depth += 1;
+      if (source[end] === "}") depth -= 1;
+      if (depth === 0) break;
+    }
+    blocks.push({ query: normalize(source.slice(at, open)), body: source.slice(open + 1, end) });
+    index = end + 1;
+  }
+  return { base, blocks };
+};
+
+const stylesheet = (file: string): { base: CssRule[]; md: CssRule[]; all: CssRule[] } => {
+  const css = readCss(file);
+  const { base, blocks } = splitAtBlocks(css);
+  const mdBlock = blocks.find((block) => /^@media \(\s*min-width:\s*768px\s*\)$/.test(block.query));
+  return { base: parseRules(base), md: parseRules(mdBlock?.body ?? ""), all: parseRules(css) };
+};
+
+const buttons = stylesheet("buttons.css");
+const baseRules = buttons.base;
+
+// Rules whose selector list contains one matching `selector` exactly (after splitting on commas).
+const rulesFor = (selector: RegExp, list: CssRule[] = baseRules): CssRule[] =>
+  list.filter((rule) => rule.selector.split(",").some((part) => selector.test(part.trim())));
+const bodyFor = (selector: RegExp, list: CssRule[] = baseRules): string =>
+  rulesFor(selector, list)
+    .map((rule) => rule.body)
+    .join("; ");
+const declaration = (property: string, value: string): RegExp =>
+  new RegExp(`(^|;\\s*)${property}: ${value}(;|$)`);
+
+// Moved unchanged from src/styles/location.test.ts (T-20261115-003 CA-19 f); it now reads buttons.css.
+describe("CA-19 (f): .btn--secondary (outline button)", () => {
+  it("is transparent with primary text and border", () => {
+    const body = bodyFor(/^\.btn--secondary$/);
+    expect(body).toMatch(/(^|;\s*)background(-color)?: transparent(;|$)/);
+    expect(body).toMatch(declaration("color", "var\\(--color-primary\\)"));
+    expect(body).toMatch(/(^|;\s*)border(-color)?: [^;]*var\(--color-primary\)/);
+  });
+
+  it("uses var(--color-surface) on hover", () => {
+    expect(bodyFor(/^\.btn--secondary:hover$/)).toContain("var(--color-surface)");
+  });
+});
+
+describe("CA-12 (a): .btn--secondary width in buttons.css", () => {
+  it("is full width on mobile", () => {
+    expect(bodyFor(/^\.btn--secondary$/)).toMatch(declaration("width", "100%"));
+  });
+
+  it("is auto width from 768 px", () => {
+    expect(bodyFor(/^\.btn--secondary$/, buttons.md)).toMatch(declaration("width", "auto"));
+  });
+});
+
+describe("CA-12 (b): location.css keeps only its own spacing for the button", () => {
+  const location = stylesheet("location.css");
+
+  it("has no rule with the exact selector .btn--secondary or .btn--secondary:hover, in any context", () => {
+    expect(rulesFor(/^\.btn--secondary(:hover)?$/, location.all)).toEqual([]);
+  });
+
+  it("spaces the button inside the place block with margin-top: var(--space-4)", () => {
+    expect(bodyFor(/^\.location__place \.btn--secondary$/, location.base)).toMatch(
+      declaration("margin-top", "var\\(--space-4\\)"),
+    );
+  });
+});
