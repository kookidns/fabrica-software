+++ b/src/styles/hero.css
@@ -0,0 +1,37 @@
+/* Sección Portada; solo usa var(--…) de tokens.css (D-02, D-08, brain/diseno.md). */
+
+/* ── Portada ──────────────────────────────────────────── */
+/* Alto visible menos la cabecera: nombre, eslogan y botón sin hacer scroll (CA-01.1, CA-01.2). */
+.hero {
+  display: flex;
+  align-items: center;
+  min-height: calc(100vh - var(--header-height) - var(--tap-min));
+  min-height: calc(100svh - var(--header-height) - var(--tap-min));
+}
+
+.hero__content {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-4);
+}
+
+.hero__title {
+  font-size: var(--text-3xl);
+  font-weight: 700;
+}
+
+.hero__slogan {
+  max-width: 65ch;
+  margin-bottom: var(--space-3);
+  font-size: var(--text-lg);
+  color: var(--color-text-muted);
+}
