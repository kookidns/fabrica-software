/* Estilos base y layout mobile-first; solo usan var(--…) de tokens.css (D-02, brain/diseno.md).
   Cabecera, botones, portada, Reservar y pie viven en su propio archivo (header.css, buttons.css,
   hero.css, reserve.css, footer.css), importado en main.ts después de este. */

/* ── Base ─────────────────────────────────────────────── */
*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-body);
  color: var(--color-text);
  background: var(--color-bg);
  overflow-wrap: break-word;
}

h1,
h2,
h3 {
  margin: 0;
  font-family: var(--font-heading);
  line-height: var(--leading-heading);
  color: var(--color-text);
  overflow-wrap: anywhere;
}

p {
  margin: 0;
}

a {
  color: var(--color-primary);
}

.container {
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  padding-inline: var(--gutter);
}

/* ── Foco: anillo azul que cae sobre el fondo, nunca sobre el primario ── */
:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 3px;
}

/* main recibe el foco del enlace de salto; el anillo alrededor de toda la página no aporta. */
main:focus {
  outline: none;
}

/* ── Secciones ────────────────────────────────────────── */
/* El ancla deja el título bajo la cabecera de dos filas (nombre + navegación). */
main > section {
  padding-block: var(--space-7);
  scroll-margin-top: calc(var(--header-height) + var(--tap-min));
}

main > section:nth-of-type(even) {
  background: var(--color-surface);
}

main > section h2 {
  margin-bottom: var(--space-5);
  font-size: var(--text-2xl);
  font-weight: 600;
}

/* ── Desde 768 px ─────────────────────────────────────── */
@media (min-width: 768px) {
  main > section {
    padding-block: var(--space-8);
    scroll-margin-top: var(--header-height);
  }
}

/* ── Movimiento reducido ──────────────────────────────── */
/* La anulación de .btn:active vive junto al botón, en buttons.css (CA-10). */
@media (prefers-reduced-motion: no-preference) {
  html {
    scroll-behavior: smooth;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
    scroll-behavior: auto !important;
  }
}
