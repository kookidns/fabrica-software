    expect(source, "must not import the data file").not.toMatch(/import[^;]*["'][^"']*data\/business/);
  });
});
import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { describe, expect, expectTypeOf, it } from "vitest";
import { business } from "./business";
import type { Business, DayHours } from "./business";

// Plain strings, not the global URL: under jsdom it is jsdom's class, which node:url rejects.
const dataDir = dirname(fileURLToPath(import.meta.url));
const readSource = (): string => readFileSync(resolve(dataDir, "business.ts"), "utf8");

const TIME = /^([01]\d|2[0-3]):[0-5]\d$/;

describe("CA-1: header comment marks the data as fictitious", () => {
  it("starts with a comment mentioning ficticio(s) and D-00", () => {
    const header = /^\s*(\/\*[\s\S]*?\*\/|(?:\/\/[^\n]*\n)+)/.exec(readSource())?.[1];
    expect(header, "leading comment").toBeDefined();
    expect(header).toMatch(/ficticios?/i);
    expect(header).toContain("D-00");
  });
});

describe("CA-2: identity, locale and currency", () => {
  it("has the agreed name, a slogan, es-MX and MXN", () => {
    expect(business.name).toBe("Cafetería Luna");
    expect(typeof business.slogan).toBe("string");
    expect(business.slogan.trim()).not.toBe("");
    expect(business.locale).toBe("es-MX");
    expect(business.currency).toBe("MXN");
  });
});

describe("CA-3: menu", () => {
  it.each(["drinks", "desserts"] as const)("%s has at least 3 valid products", (group) => {
    const items = business.menu[group];
    expect(items.length).toBeGreaterThanOrEqual(3);
    for (const item of items) {
      expect(item.name.trim(), `name in ${group}`).not.toBe("");
      expect(typeof item.price, `price of ${item.name}`).toBe("number");
      expect(Number.isFinite(item.price), `price of ${item.name}`).toBe(true);
      expect(item.price, `price of ${item.name}`).toBeGreaterThan(0);
    }
  });
});

describe("CA-4: opening hours", () => {
  it("has 7 entries Monday to Sunday in order", () => {
    expect(business.hours.map((entry) => entry.day)).toEqual([
      "Lunes",
      "Martes",
      "Miércoles",
      "Jueves",
      "Viernes",
      "Sábado",
      "Domingo",
    ]);
  });

  it("has at least one closed day without open/close", () => {
    const closed = business.hours.filter((entry) => entry.closed === true);
    expect(closed.length).toBeGreaterThanOrEqual(1);
    for (const entry of closed) {
      expect(entry).not.toHaveProperty("open");
      expect(entry).not.toHaveProperty("close");
    }
  });

  it("every open day has HH:MM 24 h times with open < close", () => {
    for (const entry of business.hours) {
      if (entry.closed) continue;
      expect(entry.open, `${entry.day} open`).toMatch(TIME);
      expect(entry.close, `${entry.day} close`).toMatch(TIME);
      expect(entry.open < entry.close, `${entry.day}: ${entry.open} < ${entry.close}`).toBe(true);
    }
  });
});

describe("CA-5: address and coordinates", () => {
  it("has a non-empty address and valid finite coordinates", () => {
    expect(business.address.trim()).not.toBe("");
    const { lat, lng } = business.coordinates;
    expect(Number.isFinite(lat)).toBe(true);
    expect(Number.isFinite(lng)).toBe(true);
    expect(lat).toBeGreaterThanOrEqual(-90);
    expect(lat).toBeLessThanOrEqual(90);
    expect(lng).toBeGreaterThanOrEqual(-180);
    expect(lng).toBeLessThanOrEqual(180);
  });
});

describe("CA-6: WhatsApp data", () => {
  it("uses the D-00 example number as digits only", () => {
    expect(business.whatsapp.number).toBe("520000000000");
  });

  it("has a Spanish message asking for date, time and party size", () => {
    const { message } = business.whatsapp;
    expect(message.trim()).not.toBe("");
    expect(message).toMatch(/\bfecha\b/i);
    expect(message).toMatch(/\bhora\b/i);
    expect(message).toMatch(/\bpersonas\b/i);
  });
});

describe("CA-7: business is typed with the exported Business type", () => {
  it("is annotated as Business in the source", () => {
    expect(readSource()).toMatch(/export const business:\s*Business\s*=/);
  });

  it("has exactly the Business type (checked by npm run typecheck)", () => {
    expectTypeOf(business).toEqualTypeOf<Business>();
    expectTypeOf(business).not.toBeAny();
  });

  it("models hours as an exclusive union (checked by npm run typecheck)", () => {
    const invalid: DayHours[] = [
      // @ts-expect-error a closed day cannot have opening times
      { day: "Lunes", closed: true, open: "08:00", close: "20:00" },
      // @ts-expect-error an open day cannot be marked as closed
      { day: "Martes", open: "08:00", close: "20:00", closed: true },
      // @ts-expect-error an open day needs both open and close
      { day: "Miércoles", open: "08:00" },
    ];
    expect(invalid).toHaveLength(3);
  });
});

