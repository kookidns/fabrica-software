import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { describe, expect, it } from "vitest";
import { business } from "../data/business";
import { buildWhatsAppUrl } from "./whatsapp";

// Plain strings, not the global URL: under jsdom it is jsdom's class, which node:url rejects.
const libDir = dirname(fileURLToPath(import.meta.url));

const textParam = (url: string): string => url.slice(url.indexOf("?text=") + "?text=".length);

describe("CA-8: number is reduced to digits only", () => {
  it.each(["+52 000 000 0000", "(52) 000-000-0000"])("cleans %j", (number) => {
    expect(buildWhatsAppUrl(number, "Hola").startsWith("https://wa.me/520000000000?text=")).toBe(true);
  });
});

describe("CA-9: message is encoded with encodeURIComponent and decodes losslessly", () => {
  const message = "¡Hola! ¿Tienen mesa mañana?\nSomos 4 & #luna / café = rico";

  it("uses exactly encodeURIComponent(message) after ?text=", () => {
    const value = textParam(buildWhatsAppUrl("520000000000", message));
    expect(value).toBe(encodeURIComponent(message));
    expect(value).toContain("%20");
    expect(value).not.toContain("+");
  });

  it("decodes back to the identical message", () => {
    const url = buildWhatsAppUrl("520000000000", message);
    expect(decodeURIComponent(textParam(url))).toBe(message);
    expect(new URL(url).searchParams.get("text")).toBe(message);
  });
});

describe("CA-10: URL format valid for mobile app and WhatsApp Web", () => {
  it("is https://wa.me/<digits> with text as the only parameter", () => {
    const parsed = new URL(buildWhatsAppUrl("+52 000 000 0000", "Hola"));
    expect(parsed.protocol).toBe("https:");
    expect(parsed.hostname).toBe("wa.me");
    expect(parsed.pathname).toMatch(/^\/\d+$/);
    expect(parsed.pathname).toBe("/520000000000");
    expect([...parsed.searchParams.keys()]).toEqual(["text"]);
  });
});

describe("CA-11: number without digits", () => {
  it.each(["", "+ -", "()"])("throws an Error for %j", (number) => {
    expect(() => buildWhatsAppUrl(number, "Hola")).toThrow(Error);
  });
});

describe("CA-12: link built from the real data file", () => {
  it("points to the business number and asks for date, time and party size", () => {
    const url = buildWhatsAppUrl(business.whatsapp.number, business.whatsapp.message);
    expect(url.startsWith("https://wa.me/520000000000?text=")).toBe(true);
    const text = decodeURIComponent(textParam(url));
    expect(text).toBe(business.whatsapp.message);
    expect(text).toMatch(/\bfecha\b/i);
    expect(text).toMatch(/\bhora\b/i);
    expect(text).toMatch(/\bpersonas\b/i);
  });
});

describe("CA-13: whatsapp.ts holds no business data", () => {
  it("does not contain the number or the message", () => {
    const source = readFileSync(resolve(libDir, "whatsapp.ts"), "utf8");
