/*
 * DATOS FICTICIOS (decisión D-00 del brain).
 * Todos los valores de este archivo son de ejemplo: menú y precios en MXN, horario, dirección,
 * coordenadas y WhatsApp (+52 000 000 0000). Deben sustituirse por los reales antes de publicar
 * (ver brain/huecos.md). Para cambiarlos, edita solo este archivo: ningún otro módulo contiene
 * datos del negocio.
 */

export interface MenuItem {
  name: string;
  /** Price as a number in `currency`; formatting lives in src/lib/formatPrice.ts (D-06). */
  price: number;
}

export interface OpenDay {
  day: string;
  /** "HH:MM", 24 h. */
  open: string;
  /** "HH:MM", 24 h, later than `open`. */
  close: string;
  closed?: never;
}

export interface ClosedDay {
  day: string;
  closed: true;
  open?: never;
  close?: never;
}

export type DayHours = OpenDay | ClosedDay;

export interface Business {
  name: string;
  slogan: string;
  locale: string;
  currency: string;
  menu: {
    drinks: MenuItem[];
    desserts: MenuItem[];
  };
  /** Seven entries, Monday to Sunday. */
  hours: DayHours[];
  address: string;
  coordinates: { lat: number; lng: number };
  /** `number`: digits only, country code included. */
  whatsapp: { number: string; message: string };
}

export const business: Business = {
  name: "Cafetería Luna",
  slogan: "Tu rincón tranquilo para un buen café",
  locale: "es-MX",
  currency: "MXN",
  menu: {
    drinks: [
      { name: "Café americano", price: 45 },
      { name: "Capuchino", price: 55 },
      { name: "Latte", price: 60 },
      { name: "Chocolate caliente", price: 50 },
    ],
    desserts: [
      { name: "Pastel de chocolate", price: 75 },
      { name: "Cheesecake de frutos rojos", price: 80 },
      { name: "Pan de elote", price: 45 },
    ],
  },
  hours: [
    { day: "Lunes", closed: true },
    { day: "Martes", open: "08:00", close: "20:00" },
    { day: "Miércoles", open: "08:00", close: "20:00" },
    { day: "Jueves", open: "08:00", close: "20:00" },
    { day: "Viernes", open: "08:00", close: "21:00" },
    { day: "Sábado", open: "09:00", close: "21:00" },
    { day: "Domingo", open: "09:00", close: "15:00" },
  ],
  address: "Calle Ejemplo 123, Col. Centro, 00000 Ciudad de México, CDMX, México",
  coordinates: { lat: 19.4326, lng: -99.1332 },
  whatsapp: {
    number: "520000000000",
    message:
      "¡Hola, Cafetería Luna! Quiero reservar una mesa. ¿Me ayudas?\nFecha: \nHora: \nNúmero de personas: ",
  },
};
/**
 * Builds the WhatsApp "click to chat" link (D-05): https://wa.me/<digits>?text=<message>.
 * Works for the mobile app and for WhatsApp Web on desktop.
 * Pure function: the number and message come from src/data/business.ts, never from here.
 */
export function buildWhatsAppUrl(number: string, message: string): string {
  // wa.me only accepts digits: drop "+", spaces, dashes, parentheses and anything else.
  const digits = number.replace(/\D/g, "");
  if (digits === "") {
    throw new Error("WhatsApp number must contain at least one digit");
  }
  // encodeURIComponent (not URLSearchParams) so spaces become %20 instead of "+".
  return `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
}

