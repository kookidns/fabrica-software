+});
+
+describe("T-20261117-001 CA-5: cup illustration for wide screens", () => {
+  it("includes one decorative <svg class=hero__art>, a direct child after the button", () => {
+    const hero = renderHero(content, URL_OK);
+    const art = hero.querySelectorAll(":scope > svg.hero__art");
