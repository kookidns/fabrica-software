@@ -32,3 +36,47 @@ describe("CA-8: data is rendered as text, never as HTML", () => {
     expect(hero.querySelector("p")?.textContent).toBe(payload);
   });
 });
+
+describe("T-20261117-001 CA-4: moon in the hero", () => {
+  it("has a decorative <svg class=hero__moon> before the <h1>", () => {
+    const hero = renderHero(content, URL_OK);
+    const moon = hero.querySelector(":scope > svg.hero__moon");
