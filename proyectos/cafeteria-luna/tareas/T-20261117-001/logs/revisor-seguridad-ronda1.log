+
+  it("keeps the non-SVG children as H1, P, A with the same text, id, href and class", () => {
+    const hero = renderHero(content, URL_OK);
+    const others = Array.from(hero.children).filter((child) => child.namespaceURI !== "http://www.w3.org/2000/svg");
+    expect(others.map((child) => child.tagName)).toEqual(["H1", "P", "A"]);
+    expect(others[0]?.id).toBe("inicio-titulo");
+    expect(others[0]?.textContent).toBe(content.name);
+    expect(others[1]?.textContent).toBe(content.slogan);
