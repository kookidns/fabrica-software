+/**
+ * Decorative SVG icons, drawn with the DOM API (createElementNS, never HTML strings: D-04).
+ * Every icon is aria-hidden and not focusable, has no text, and paints only with currentColor or
+ * none: the real colors come from the section stylesheets through var(--…) tokens (D-02).
+ * The moon of the header and the footer is static in index.html and reuses MOON_PATH.
+ */
+
+const SVG_NS = "http://www.w3.org/2000/svg";
+
+export const ICON_NAMES = ["moon", "cup", "cake", "calendar", "pin", "whatsapp", "cup-art"] as const;
+export type IconName = (typeof ICON_NAMES)[number];
+
+type Attributes = Readonly<Record<string, string>>;
+type Shape = readonly ["path" | "circle" | "ellipse" | "rect", Attributes];
+
+interface IconDefinition {
+  viewBox: string;
+  /** Presentation attributes of the <svg>, inherited by its shapes. */
+  base: Attributes;
+  shapes: readonly Shape[];
+}
+
+const FILLED: Attributes = { fill: "currentColor" };
+const OUTLINE: Attributes = {
+  fill: "none",
+  stroke: "currentColor",
+  "stroke-width": "2",
+  "stroke-linecap": "round",
+  "stroke-linejoin": "round",
+};
+
+const path = (d: string, extra: Attributes = {}): Shape => ["path", { d, ...extra }];
+
+// Crescent moon opening to the upper right (24 × 24).
+export const MOON_PATH = "M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z";
+
+// Simplified, monochrome WhatsApp glyph: round speech bubble with a tail and a handset inside.
+const WHATSAPP_BUBBLE = "M12 3.2a8.8 8.8 0 0 0-7.6 13.2L3.2 20.8l4.5-1.2A8.8 8.8 0 1 0 12 3.2z";
+const WHATSAPP_HANDSET =
+  "M8.6 7.4C9 7.2 9.4 7.3 9.6 7.7l1 1.8c.1.3 0 .6-.2.8l-.5.5c.7 1.3 2 2.6 3.3 3.3l.5-.5c.2-.2.5-.3.8-.2" +
+  "l1.8 1c.4.2.5.6.3 1-.5 1-1.6 1.5-2.7 1.2-2.8-.8-5.7-3.7-6.5-6.5-.3-1.1.2-2.2 1.2-2.7z";
+
+// Desktop illustration (280 × 200): cup with saucer, steam, a moon on the cup, sparks and a sprig.
+// Each part has a class so hero.css can give it a token color (fill/stroke from CSS).
+const ART_LINE: Attributes = { fill: "none", stroke: "currentColor", "stroke-linecap": "round" };
+const ART_SHAPE: Attributes = { fill: "currentColor", stroke: "currentColor", "stroke-width": "5" };
+const CUP_ART: readonly Shape[] = [
+  ["ellipse", { class: "hero__art-shadow", cx: "115", cy: "184", rx: "100", ry: "9", fill: "currentColor" }],
+  ["ellipse", { class: "hero__art-saucer", cx: "115", cy: "168", rx: "82", ry: "16", ...ART_SHAPE }],
+  path("M180 100c26-6 40 10 32 28c-6 13-22 18-38 20", { class: "hero__art-handle", ...ART_LINE, "stroke-width": "8" }),
+  path("M47 88H183C183 136 157 164 115 164C73 164 47 136 47 88Z", { class: "hero__art-cup", ...ART_SHAPE }),
+  ["ellipse", { class: "hero__art-cup", cx: "115", cy: "88", rx: "68", ry: "12", ...ART_SHAPE }],
+  ["ellipse", { class: "hero__art-coffee", cx: "115", cy: "89", rx: "56", ry: "7", fill: "currentColor" }],
+  path("M129 134a18 18 0 0 1-23.5-23.5a18 18 0 1 0 23.5 23.5z", { class: "hero__art-moon", fill: "currentColor" }),
+  path("M93 66c-10-12 10-20 0-34", { class: "hero__art-steam", ...ART_LINE, "stroke-width": "5" }),
+  path("M115 62c-10-12 10-20 0-34", { class: "hero__art-steam", ...ART_LINE, "stroke-width": "5" }),
+  path("M137 66c-10-12 10-20 0-34", { class: "hero__art-steam", ...ART_LINE, "stroke-width": "5" }),
+  path("M34 70l-14-8M30 92H14M44 52l-8-13", { class: "hero__art-spark", ...ART_LINE, "stroke-width": "5" }),
+  path("M236 176c4-34 12-60 30-84", { class: "hero__art-leaf", ...ART_LINE, "stroke-width": "4" }),
+  path(
+    "M240 146c-14-4-20-16-17-28c13 4 19 16 17 28zM250 116c-12-6-16-18-11-29c11 6 15 18 11 29z" +
+      "M244 160c6-13 18-18 28-13c-5 12-17 17-28 13z",
+    { class: "hero__art-leaf", fill: "currentColor" },
+  ),
+];
+
+const ICONS: Record<IconName, IconDefinition> = {
+  moon: { viewBox: "0 0 24 24", base: FILLED, shapes: [path(MOON_PATH)] },
+  cup: {
+    viewBox: "0 0 24 24",
+    base: OUTLINE,
+    shapes: [
+      path("M5 10h11v3.5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"),
+      path("M16 11h1a3 3 0 0 1 0 6h-1.6"),
+      path("M3.5 21h15"),
+      path("M9 7.5c-1.2-1.3 1.2-2.2 0-4.5M13 7.5c-1.2-1.3 1.2-2.2 0-4.5"),
+    ],
+  },
+  cake: {
+    viewBox: "0 0 24 24",
+    base: OUTLINE,
+    shapes: [
+      path("M3 12 19.2 5.6a1.5 1.5 0 0 1 1.8 1.4V12"),
+      ["rect", { x: "3", y: "12", width: "18", height: "8", rx: "1" }],
+      path("M3 16h18"),
+      ["circle", { cx: "17", cy: "3.2", r: "1.2" }],
+    ],
+  },
+  calendar: {
+    viewBox: "0 0 24 24",
+    base: OUTLINE,
+    shapes: [
+      ["rect", { x: "3", y: "5", width: "18", height: "16", rx: "2" }],
+      path("M3 10h18M8 3v4M16 3v4"),
+    ],
+  },
+  pin: {
+    viewBox: "0 0 24 24",
+    base: OUTLINE,
+    shapes: [
+      path("M12 21.5s-7-6.1-7-11.5a7 7 0 0 1 14 0c0 5.4-7 11.5-7 11.5z"),
+      ["circle", { cx: "12", cy: "10", r: "2.5" }],
+    ],
+  },
+  whatsapp: {
+    viewBox: "0 0 24 24",
+    base: {},
+    shapes: [
+      path(WHATSAPP_BUBBLE, { fill: "none", stroke: "currentColor", "stroke-width": "1.8", "stroke-linejoin": "round" }),
+      path(WHATSAPP_HANDSET, { fill: "currentColor" }),
+    ],
+  },
+  "cup-art": { viewBox: "0 0 280 200", base: {}, shapes: CUP_ART },
+};
+
+function setAttributes(element: Element, attributes: Attributes): void {
+  for (const [name, value] of Object.entries(attributes)) {
+    element.setAttribute(name, value);
+  }
+}
+
+/** Returns a new decorative <svg> for `name`, with `className` on the root when given. */
+export function createIcon(name: IconName, className?: string): SVGSVGElement {
+  const { viewBox, base, shapes } = ICONS[name];
+  const svg = document.createElementNS(SVG_NS, "svg");
+  if (className) svg.setAttribute("class", className);
+  svg.setAttribute("viewBox", viewBox);
+  svg.setAttribute("aria-hidden", "true");
+  svg.setAttribute("focusable", "false");
+  setAttributes(svg, base);
+  for (const [tag, attributes] of shapes) {
+    const shape = document.createElementNS(SVG_NS, tag);
+    setAttributes(shape, attributes);
+    svg.append(shape);
+  }
+  return svg;
+}

