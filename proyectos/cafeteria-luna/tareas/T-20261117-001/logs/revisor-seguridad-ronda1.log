  title.id = HERO_TITLE_ID;
  title.className = "hero__title";
  title.textContent = name;

  const tagline = document.createElement("p");
  tagline.className = "hero__slogan";
  tagline.textContent = slogan;

  // Decorative, aria-hidden: the moon above the title and the cup illustration (hidden below 768 px by hero.css).
  content.append(
    createIcon("moon", "hero__moon"),
    title,
    tagline,
    createReserveButton(reserveUrl),
    createIcon("cup-art", "hero__art"),
  );
