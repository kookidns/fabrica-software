+    expect(art[0]?.querySelector(".hero__art-saucer")).not.toBeNull();
+    expect(art[0]?.querySelectorAll(".hero__art-steam").length).toBeGreaterThan(0);
+  });
+
+  it("has exactly two SVGs outside the button: the moon and the cup", () => {
+    const hero = renderHero(content, URL_OK);
+    const outside = Array.from(hero.querySelectorAll("svg")).filter((svg) => !svg.closest("a"));
+    expect(outside.map((svg) => svg.getAttribute("class"))).toEqual(["hero__moon", "hero__art"]);
+    expect(hero.textContent).toBe(`${content.name}${content.slogan}Reservar mesa por WhatsApp`);
