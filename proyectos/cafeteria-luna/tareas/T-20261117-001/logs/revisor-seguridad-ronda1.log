diff --git a/src/decor.test.ts b/src/decor.test.ts
new file mode 100644
index 0000000..3ea3be7
--- /dev/null
+++ b/src/decor.test.ts
@@ -0,0 +1,175 @@
+import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
+import { dirname, join, relative, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { MOON_PATH } from "./sections/icons";
+
+// T-20261117-001: decorative SVGs on the mounted page (CA-2, CA-3, CA-11), focus order unchanged
+// (CA-12) and no new resources (CA-2, CA-13 e, CA-14). Mounted as in a11y.test.ts.
+
+const srcDir = dirname(fileURLToPath(import.meta.url));
+const projectRoot = resolve(srcDir, "..");
+const indexHtml = (): string => readFileSync(resolve(projectRoot, "index.html"), "utf8");
+const indexDoc = (): Document => new DOMParser().parseFromString(indexHtml(), "text/html");
+const squash = (value: string | null | undefined): string => (value ?? "").replace(/\s+/g, " ").trim();
+
+const mountPage = async (): Promise<void> => {
+  document.body.replaceWith(document.importNode(indexDoc().body, true));
+  await import("./main");
+};
+
+const FORBIDDEN_TAGS = ["title", "desc", "text", "image", "use", "foreignobject", "script"];
+
+// CA-1 (a)–(d) for any <svg> of the page.
+const expectDecorative = (svg: Element): void => {
+  const label = svg.getAttribute("class") ?? svg.outerHTML;
+  expect(svg.getAttribute("aria-hidden"), label).toBe("true");
+  expect(svg.getAttribute("focusable"), label).toBe("false");
+  expect(svg.getAttribute("viewBox"), label).toMatch(/^\d+ \d+ \d+ \d+$/);
+  expect(svg.textContent, label).toBe("");
+  for (const node of [svg, ...Array.from(svg.querySelectorAll("*"))]) {
+    expect(FORBIDDEN_TAGS, `${label} ${node.tagName}`).not.toContain(node.tagName.toLowerCase());
+    for (const attr of Array.from(node.attributes)) {
+      const name = attr.name.toLowerCase();
+      expect(["href", "xlink:href", "style", "tabindex"], `${label} ${name}`).not.toContain(name);
+      expect(name.startsWith("on"), `${label} ${name}`).toBe(false);
+      if (name === "fill" || name === "stroke") expect(["currentColor", "none"], `${label} ${name}`).toContain(attr.value);
+    }
+  }
+};
+
+describe("T-20261117-001 CA-2: inventory of SVGs on the mounted page", () => {
+  beforeEach(async () => {
+    vi.resetModules();
+    await mountPage();
+  });
+
+  it("has exactly 10 <svg>, in the agreed places", () => {
+    const count = (selector: string): number => document.querySelectorAll(selector).length;
+    expect(count("svg")).toBe(10);
+    expect(count("header .brand > svg")).toBe(1);
+    expect(Array.from(document.querySelectorAll("#inicio svg")).filter((svg) => !svg.closest("a"))).toHaveLength(2);
+    expect(count("#menu h3 > svg")).toBe(2);
+    expect(count("#menu svg")).toBe(2);
+    expect(count("#horario h3 > svg")).toBe(2);
+    expect(count("#horario svg")).toBe(2);
+    for (const link of document.querySelectorAll('a[href^="https://wa.me/"]')) {
+      expect(link.querySelectorAll("svg")).toHaveLength(1);
+    }
+    expect(count("footer svg")).toBe(1);
+  });
+
+  it("makes all 10 decorative (CA-1 a–d)", () => {
+    for (const svg of document.querySelectorAll("svg")) expectDecorative(svg);
+  });
+
+  it("has no <img>, <picture> or <object>", () => {
+    expect(document.querySelectorAll("img, picture, object")).toHaveLength(0);
+  });
+});
+
+describe("T-20261117-001 CA-3: static moon in the header brand", () => {
+  const brand = (): Element | null => indexDoc().querySelector("header .brand");
+
+  it("starts .brand with <svg class=brand__icon> (crescent) followed by the text", () => {
+    const first = brand()?.firstChild as Element | null;
+    expect(first?.nodeName.toLowerCase()).toBe("svg");
+    expect(first?.getAttribute("class")).toBe("brand__icon");
+    expect(first?.querySelector("path")?.getAttribute("d")).toBe(MOON_PATH);
+    expect(brand()?.lastChild?.nodeType).toBe(Node.TEXT_NODE);
+    expectDecorative(first as Element);
+  });
+
+  it("keeps the brand text and href", () => {
+    expect(brand()?.textContent).toBe("Cafetería Luna");
+    expect(brand()?.getAttribute("href")).toBe("#inicio");
+  });
+});
+
+describe("T-20261117-001 CA-11: static moon in the footer", () => {
+  it("has one <svg class=site-footer__moon> (crescent) next to the name", () => {
+    const footer = indexDoc().querySelector("footer");
+    const moons = footer?.querySelectorAll("svg") ?? [];
+    expect(moons).toHaveLength(1);
+    const moon = moons[0] as Element;
+    expect(moon.getAttribute("class")).toBe("site-footer__moon");
+    expect(moon.querySelector("path")?.getAttribute("d")).toBe(MOON_PATH);
+    expect(moon.closest(".site-footer__name")).not.toBeNull();
+    expect(squash(footer?.querySelector(".site-footer__name")?.textContent)).toBe("Cafetería Luna");
+    expectDecorative(moon);
+  });
+});
+
+describe("T-20261117-001 CA-12: focus order and names unchanged", () => {
+  beforeEach(async () => {
+    vi.resetModules();
+    await mountPage();
+  });
+
+  it("lists exactly the 8 focusable elements (iframe aside), in order", () => {
+    const NEW_TAB = " (se abre en una pestaña nueva)";
+    const focusables = Array.from(
+      document.querySelectorAll<HTMLElement>('a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])'),
+    ).filter((element) => element.tagName !== "IFRAME");
+    const names = focusables.map((element) => squash(element.getAttribute("aria-label")) || squash(element.textContent));
+    expect(names).toEqual([
+      "Saltar al contenido",
+      "Cafetería Luna",
+      "Menú",
+      "Horario y ubicación",
+      "Reservar",
+      `Reservar mesa por WhatsApp${NEW_TAB}`,
+      `Cómo llegar${NEW_TAB}`,
+      `Reservar mesa por WhatsApp${NEW_TAB}`,
+    ]);
+    expect(focusables[5]?.closest("section")?.id).toBe("inicio");
+    expect(focusables[7]?.closest("section")?.id).toBe("reservar");
+  });
+
+  it("adds no tabindex: only main#contenido has one", () => {
+    expect(Array.from(document.querySelectorAll("[tabindex]"), (element) => element.id)).toEqual(["contenido"]);
+  });
+});
+
+// Every non-test file under src/, recursively.
+const sourceFiles = (dir: string): string[] =>
+  readdirSync(dir).flatMap((entry) => {
+    const path = join(dir, entry);
+    if (statSync(path).isDirectory()) return sourceFiles(path);
+    return entry.endsWith(".test.ts") ? [] : [path];
+  });
+
+describe("T-20261117-001 CA-2, CA-13 (e), CA-14: graphics drawn in code, no new resources", () => {
+  const files = [resolve(projectRoot, "index.html"), ...sourceFiles(srcDir)];
+  const read = (file: string): string => readFileSync(file, "utf8");
+
+  it.each(files.map((file) => relative(projectRoot, file)))("%s has no image references nor sketch files", (file) => {
+    const text = read(resolve(projectRoot, file));
+    for (const fragment of ["data:image", ".png", ".jpg", ".webp", "boceto"]) {
+      expect(text.toLowerCase(), fragment).not.toContain(fragment);
+    }
+    if (file.endsWith(".css")) expect(text).not.toMatch(/url\(/i);
+    for (const host of ["fonts.googleapis", "fonts.gstatic"]) {
+      expect(text, host).not.toContain(`${host}.com`);
+    }
+  });
+
+  it("keeps public/ without files", () => {
+    const publicDir = resolve(projectRoot, "public");
+    expect(existsSync(publicDir) ? readdirSync(publicDir) : []).toEqual([]);
+  });
+
+  it("uses no HTML-string DOM API in any non-test .ts of src/ (D-04)", () => {
+    for (const file of files.filter((path) => path.endsWith(".ts"))) {
+      for (const api of ["innerHTML", "outerHTML", "insertAdjacentHTML", "DOMParser"]) {
+        expect(read(file), `${relative(projectRoot, file)} contains ${api}`).not.toContain(api);
+      }
+    }
+  });
+
+  it("adds no <link> and no external <script> to index.html", () => {
+    const doc = indexDoc();
+    expect(doc.querySelectorAll("link")).toHaveLength(0);
+    expect(Array.from(doc.querySelectorAll("script"), (script) => script.getAttribute("src"))).toEqual(["/src/main.ts"]);
+  });
+});
diff --git a/src/sections/decor.test.ts b/src/sections/decor.test.ts
new file mode 100644
index 0000000..fc90669
--- /dev/null
+++ b/src/sections/decor.test.ts
@@ -0,0 +1,127 @@
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+import type { Business } from "../data/business";
+import { createIcon } from "./icons";
+import { renderLocation } from "./location";
+import { renderMenu } from "./menu";
+import { createReserveButton } from "./reserve";
+
+// T-20261117-001: decorative icons in the Menú, Horario y ubicación and reserve button (CA-6, CA-7, CA-9, CA-10).
+// Separate file so menu.test.ts, location.test.ts and reserve.test.ts stay unchanged.
+
+const sectionsDir = dirname(fileURLToPath(import.meta.url));
+const readSource = (file: string): string => readFileSync(resolve(sectionsDir, file), "utf8");
+const SVG_NS = "http://www.w3.org/2000/svg";
+
+// Same shapes as the icon of icons.ts: compares tag names and attributes of the whole tree.
+const signature = (svg: Element): string[] =>
+  [svg, ...Array.from(svg.querySelectorAll("*"))].map(
+    (node) =>
+      `${node.tagName}|${Array.from(node.attributes)
+        .filter((attr) => attr.name !== "class" || node !== svg)
+        .map((attr) => `${attr.name}=${attr.value}`)
+        .sort()
+        .join(";")}`,
+  );
+
+const MENU: Business["menu"] = {
+  drinks: [{ name: "Té verde", price: 30 }],
+  desserts: [{ name: "Flan napolitano con un nombre muy largo para partirse", price: 52 }],
+};
+const MONEY = { locale: "es-MX", currency: "MXN" };
+
+const LOCATION: Pick<Business, "hours" | "address" | "coordinates"> = {
+  hours: [
+    { day: "Lunes", closed: true },
+    { day: "Martes", open: "07:30", close: "19:00" },
+  ],
+  address: "Avenida de Prueba 456, Col. Pruebas",
+  coordinates: { lat: 20.6597, lng: -103.3496 },
+};
+
+const URL_OK = "https://wa.me/521234567890?text=Hola%20prueba";
+
+describe("T-20261117-001 CA-6: cup and cake icons in the menu headings", () => {
+  const headings = Array.from(renderMenu(MENU, MONEY).querySelectorAll("h3"));
+
+  it.each([
+    [0, "Bebidas", "cup"],
+    [1, "Postres", "cake"],
+  ] as const)("h3 #%i (%s) starts with the %s icon, class menu__icon, and keeps its exact text", (index, text, icon) => {
+    const heading = headings[index];
+    const svg = heading?.firstChild;
+    expect(svg).toBeInstanceOf(SVGSVGElement);
+    expect((svg as Element).getAttribute("class")).toBe("menu__icon");
+    expect(signature(svg as Element)).toEqual(signature(createIcon(icon)));
+    expect(heading?.textContent).toBe(text);
+    expect(heading?.querySelectorAll("svg")).toHaveLength(1);
+  });
+});
+
+describe("T-20261117-001 CA-7: the menu rows keep their DOM (dots are CSS only)", () => {
+  it("keeps every row as div.menu__item > dt + dd with the same text and no extra nodes", () => {
+    const element = renderMenu(MENU, MONEY);
+    for (const row of element.querySelectorAll(".menu__item")) {
+      expect(row.tagName).toBe("DIV");
+      expect(Array.from(row.childNodes).map((node) => node.nodeName)).toEqual(["DT", "DD"]);
+      for (const cell of row.children) {
+        expect(Array.from(cell.childNodes).map((node) => node.nodeType)).toEqual([Node.TEXT_NODE]);
+      }
+    }
+    expect(element.querySelector("dt")?.textContent).toBe("Té verde");
+  });
+});
+
+describe("T-20261117-001 CA-9: calendar and pin icons in the location headings", () => {
+  const headings = Array.from(renderLocation(LOCATION).querySelectorAll("h3"));
+
+  it.each([
+    [0, "Horario", "calendar"],
+    [1, "Dirección", "pin"],
+  ] as const)("h3 #%i (%s) starts with the %s icon, class location__icon, and keeps its exact text", (index, text, icon) => {
+    const heading = headings[index];
+    const svg = heading?.firstChild;
+    expect(svg).toBeInstanceOf(SVGSVGElement);
+    expect((svg as Element).getAttribute("class")).toBe("location__icon");
+    expect(signature(svg as Element)).toEqual(signature(createIcon(icon)));
+    expect(heading?.textContent).toBe(text);
+    expect(heading?.querySelectorAll("svg")).toHaveLength(1);
+  });
+
+  it("keeps the id of the Horario heading that names the table", () => {
+    expect(headings[0]?.id).toBe("horario-semana-titulo");
+  });
+
+  it("imports createIcon from ./icons and leaves the map constants as they were", () => {
+    const source = readSource("location.ts");
+    expect(source).toMatch(/import\s*\{[^}]*\bcreateIcon\b[^}]*\}\s*from\s*["']\.\/icons["']/);
+    expect(source).toContain('const MAP_URL_PREFIX = "https://www.openstreetmap.org/export/embed.html?";');
+    expect(source).toContain('const DIRECTIONS_URL_PREFIX = "https://www.google.com/maps/search/?";');
+    expect(source).toContain(
+      'const MAP_SANDBOX = "allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox";',
+    );
+  });
+});
+
+describe("T-20261117-001 CA-10: WhatsApp glyph in the reserve button", () => {
+  it("starts with the whatsapp icon of icons.ts, class btn__icon, in currentColor", () => {
+    const button = createReserveButton(URL_OK);
+    const svg = button.firstChild as Element;
+    expect(svg.namespaceURI).toBe(SVG_NS);
+    expect(svg.getAttribute("class")).toBe("btn__icon");
+    expect(signature(svg)).toEqual(signature(createIcon("whatsapp")));
+    expect(button.querySelectorAll("svg")).toHaveLength(1);
+    expect(button.className).toBe("btn btn--whatsapp");
+  });
+
+  it("removes CHAT_ICON_PATH and createChatIcon from reserve.ts and uses createIcon", () => {
+    const source = readSource("reserve.ts");
+    expect(source).not.toContain("CHAT_ICON_PATH");
+    expect(source).not.toContain("createChatIcon");
+    expect(source).not.toContain("createElementNS");
+    expect(source).toMatch(/import\s*\{\s*createIcon\s*\}\s*from\s*["']\.\/icons["']/);
+    expect(source).toContain('createIcon("whatsapp", "btn__icon")');
+  });
+});
