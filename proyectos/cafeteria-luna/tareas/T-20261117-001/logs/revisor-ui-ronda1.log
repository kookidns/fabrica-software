+  it("has exactly 10 <svg>, in the agreed places", () => {
+    const count = (selector: string): number => document.querySelectorAll(selector).length;
+    expect(count("svg")).toBe(10);
+    expect(count("header .brand > svg")).toBe(1);
+    expect(Array.from(document.querySelectorAll("#inicio svg")).filter((svg) => !svg.closest("a"))).toHaveLength(2);
+    expect(count("#menu h3 > svg")).toBe(2);
+    expect(count("#menu svg")).toBe(2);
+    expect(count("#horario h3 > svg")).toBe(2);
+    expect(count("#horario svg")).toBe(2);
+    for (const link of document.querySelectorAll('a[href^="https://wa.me/"]')) {
+      expect(link.querySelectorAll("svg")).toHaveLength(1);
+    }
+    expect(count("footer svg")).toBe(1);
+  });
+
+  it("makes all 10 decorative (CA-1 a–d)", () => {
+    for (const svg of document.querySelectorAll("svg")) expectDecorative(svg);
+  });
+
+  it("has no <img>, <picture> or <object>", () => {
+    expect(document.querySelectorAll("img, picture, object")).toHaveLength(0);
+  });
+});
+
+describe("T-20261117-001 CA-3: static moon in the header brand", () => {
