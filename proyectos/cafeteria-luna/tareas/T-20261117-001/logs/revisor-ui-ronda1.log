diff --git a/src/styles/decor.test.ts b/src/styles/decor.test.ts
new file mode 100644
index 0000000..b659eee
--- /dev/null
+++ b/src/styles/decor.test.ts
@@ -0,0 +1,195 @@
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+// T-20261117-001: decorative styles of each section, read from its own stylesheet (CA-3 to CA-11).
+
+const stylesDir = dirname(fileURLToPath(import.meta.url));
+const stripComments = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
+const normalize = (value: string): string => value.replace(/\s+/g, " ").trim();
+const MD = "@media (min-width: 768px)";
+
+interface CssRule {
+  context: string;
+  selectors: string[];
+  body: string;
+}
+
+// Top-level rules and rules one level inside an @-block (same approach as split.test.ts).
+const parseCss = (file: string): CssRule[] => {
+  const css = stripComments(readFileSync(resolve(stylesDir, file), "utf8"));
+  const rules: CssRule[] = [];
+  const toRule = (context: string, prelude: string, body: string): CssRule => ({
+    context,
+    selectors: prelude.split(",").map(normalize).filter(Boolean),
+    body: normalize(body),
+  });
+  let index = 0;
+  while (index < css.length) {
+    const open = css.indexOf("{", index);
+    if (open < 0) break;
+    const prelude = css.slice(index, open);
+    if (prelude.trim().startsWith("@")) {
+      let depth = 0;
+      let end = open;
+      for (; end < css.length; end += 1) {
+        if (css[end] === "{") depth += 1;
+        if (css[end] === "}") depth -= 1;
+        if (depth === 0) break;
+      }
+      const context = normalize(prelude).replace(/\(\s*/g, "(").replace(/\s*\)/g, ")").replace(/\s*:\s*/g, ": ");
+      for (const match of css.slice(open + 1, end).matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
+        rules.push(toRule(context, match[1] ?? "", match[2] ?? ""));
+      }
+      index = end + 1;
+    } else {
+      const close = css.indexOf("}", open);
+      rules.push(toRule("", prelude, css.slice(open + 1, close)));
+      index = close + 1;
+    }
+  }
+  return rules;
+};
+
+const declarations = (body: string): Map<string, string> => {
+  const map = new Map<string, string>();
+  for (const part of body.split(";")) {
+    const colon = part.indexOf(":");
+    if (colon >= 0) map.set(part.slice(0, colon).trim(), part.slice(colon + 1).trim());
+  }
+  return map;
+};
+
+// Merged declarations of every rule of `file` whose selector list contains `selector`, in `context`.
+const decl = (file: string, selector: string, context = ""): Map<string, string> =>
+  new Map(
+    parseCss(file)
+      .filter((rule) => rule.context === context && rule.selectors.includes(selector))
+      .flatMap((rule) => [...declarations(rule.body)]),
+  );
+
+const SIZE = /^(\d*\.?\d+em|var\(--[\w-]+\))$/;
+
+describe("T-20261117-001 CA-3: header.css only gains .brand__icon", () => {
+  it(".brand__icon is sized in em or tokens, does not shrink and is painted in secondary", () => {
+    const icon = decl("header.css", ".brand__icon");
+    expect(icon.get("flex")).toBe("none");
+    expect(icon.get("width")).toMatch(SIZE);
+    expect(icon.get("height")).toMatch(SIZE);
+    expect(icon.get("color")).toBe("var(--color-secondary)");
+  });
+
+  it("keeps .brand and .brand:focus-visible exactly as before", () => {
+    expect(Object.fromEntries(decl("header.css", ".brand"))).toEqual({
+      display: "inline-flex",
+      "align-items": "center",
+      "min-height": "var(--header-height)",
+      "padding-inline": "var(--space-2)",
+      "margin-inline": "calc(-1 * var(--space-2))",
+      "font-family": "var(--font-heading)",
+      "font-weight": "700",
+      "font-size": "var(--text-lg)",
+      "line-height": "var(--leading-heading)",
+      color: "var(--color-text)",
+      "text-decoration": "none",
+    });
+    expect(Object.fromEntries(decl("header.css", ".brand:focus-visible"))).toEqual({ "outline-offset": "-3px" });
+  });
+});
+
+describe("T-20261117-001 CA-4 and CA-5: hero.css paints the moon and shows the cup from 768 px", () => {
+  it(".hero__moon is painted in secondary and does not shrink", () => {
+    expect(decl("hero.css", ".hero__moon").get("color")).toBe("var(--color-secondary)");
+    expect(decl("hero.css", ".hero__moon").get("flex")).toBe("none");
+  });
+
+  it(".hero__art is hidden at the base and shown from 768 px in the second column", () => {
+    expect(decl("hero.css", ".hero__art").get("display")).toBe("none");
+    const md = decl("hero.css", ".hero__art", MD);
+    expect(md.get("display")).toBe("block");
+    expect(md.get("grid-column")).toBe("2");
+  });
+
+  it("turns .hero__content into two columns from 768 px", () => {
+    const md = decl("hero.css", ".hero__content", MD);
+    expect(md.get("display")).toBe("grid");
+    expect(md.get("grid-template-columns")).toBe("minmax(0, 1fr) auto");
+  });
+
+  it("colors the cup parts only with the allowed tokens", () => {
+    const ALLOWED = ["primary", "secondary", "surface", "border", "text-muted"].map((t) => `var(--color-${t})`);
+    const parts = parseCss("hero.css").filter((rule) => rule.selectors.some((s) => s.startsWith(".hero__art")));
+    expect(parts.length).toBeGreaterThan(0);
+    for (const rule of parts) {
+      for (const [property, value] of declarations(rule.body)) {
+        if (["color", "fill", "stroke"].includes(property)) expect(ALLOWED, `${rule.selectors} ${property}`).toContain(value);
+      }
+    }
+  });
+});
+
+describe("T-20261117-001 CA-6 and CA-7: menu.css icons and dotted leaders", () => {
+  it(".menu__title lines up icon and text with a token gap; .menu__icon is primary", () => {
+    const title = decl("menu.css", ".menu__title");
+    expect(title.get("display")).toBe("flex");
+    expect(title.get("align-items")).toBe("center");
+    expect(title.get("gap")).toMatch(/^var\(--space-\d\)$/);
+    expect(decl("menu.css", ".menu__icon").get("color")).toBe("var(--color-primary)");
+    expect(decl("menu.css", ".menu__icon").get("flex")).toBe("none");
+  });
+
+  it("draws a flexible dotted ::after on the name, colored with a token", () => {
+    const name = decl("menu.css", ".menu__name");
+    expect(name.get("display")).toBe("flex");
+    const dots = decl("menu.css", ".menu__name::after");
+    expect(dots.get("content")).toBe('""');
+    expect(dots.get("flex")).toMatch(/^1 1 /);
+    expect(dots.get("min-width")).toBe("0");
+    expect(dots.get("border-bottom")).toMatch(/^\S+ dotted var\(--color-[\w-]+\)$/);
+  });
+
+  it("removes the solid separator between rows", () => {
+    expect(parseCss("menu.css").some((rule) => rule.selectors.includes(".menu__item + .menu__item"))).toBe(false);
+  });
+});
+
+describe("T-20261117-001 CA-8: main.css draws a line on each side of the section h2", () => {
+  it("centers the h2 text in a three-column grid whose side columns can shrink to 0", () => {
+    const h2 = decl("main.css", "main > section h2");
+    expect(h2.get("text-align")).toBe("center");
+    expect(h2.get("display")).toBe("grid");
+    expect(h2.get("grid-template-columns")).toBe("minmax(0, 1fr) auto minmax(0, 1fr)");
+  });
+
+  it.each(["main > section h2::before", "main > section h2::after"])("%s is an empty primary line", (selector) => {
+    const line = decl("main.css", selector);
+    expect(line.get("content")).toBe('""');
+    expect(line.get("min-width")).toBe("0");
+    expect(line.get("border-top")).toMatch(/^\S+ solid var\(--color-primary\)$/);
+  });
+
+  it("gives no line to the hero h1", () => {
+    const selectors = ["main.css", "hero.css"].flatMap((file) => parseCss(file).flatMap((rule) => rule.selectors));
+    expect(selectors.filter((s) => /h1|hero__title/.test(s) && /::?(before|after)/.test(s))).toEqual([]);
+  });
+});
+
+describe("T-20261117-001 CA-9: location.css icons", () => {
+  it(".location__title lines up icon and text; .location__icon is primary", () => {
+    const title = decl("location.css", ".location__title");
+    expect(title.get("display")).toBe("flex");
+    expect(title.get("align-items")).toBe("center");
+    expect(title.get("gap")).toMatch(/^var\(--space-\d\)$/);
+    expect(decl("location.css", ".location__icon").get("color")).toBe("var(--color-primary)");
+  });
+});
+
+describe("T-20261117-001 CA-11: footer.css moon", () => {
+  it(".site-footer__moon is secondary and the footer keeps its dark colors", () => {
+    expect(decl("footer.css", ".site-footer__moon").get("color")).toBe("var(--color-secondary)");
+    const footer = decl("footer.css", ".site-footer");
+    expect(footer.get("background")).toBe("var(--color-footer-bg)");
+    expect(footer.get("color")).toBe("var(--color-footer-text)");
+  });
+});
