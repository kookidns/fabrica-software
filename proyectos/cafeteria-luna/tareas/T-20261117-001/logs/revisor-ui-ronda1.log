 }
 
+/* Título centrado entre dos líneas decorativas. Las columnas laterales pueden quedarse en 0:
+   un título largo se parte en dos líneas y nunca desborda. El h1 de la portada no lleva líneas. */
 main > section h2 {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
+  align-items: center;
+  column-gap: var(--space-3);
   margin-bottom: var(--space-5);
   font-size: var(--text-2xl);
   font-weight: 600;
+  text-align: center;
+}
+
+main > section h2::before,
+main > section h2::after {
+  content: "";
+  width: 100%;
+  max-width: var(--space-8);
+  min-width: 0;
+  border-top: 2px solid var(--color-primary);
+}
+
+main > section h2::before {
+  justify-self: end;
+}
+
+main > section h2::after {
+  justify-self: start;
 }
 
