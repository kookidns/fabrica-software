+/* ── Decoración (SVG aria-hidden de src/sections/icons.ts) ── */
+/* Luna dorada sobre el título: relleno de un gráfico decorativo, no texto (diseno.md). */
+.hero__moon {
+  flex: none;
+  width: var(--space-7);
+  height: var(--space-7);
+  color: var(--color-secondary);
+}
+
+/* Taza de escritorio: oculta en móvil para no restar altura a la primera pantalla.
+   Cada parte toma su color de un token; el contorno usa el color heredado (primary). */
+.hero__art {
+  display: none;
+  width: clamp(14rem, 30vw, 20rem);
+  height: auto;
+  color: var(--color-primary);
+}
+
+.hero__art-shadow {
+  color: var(--color-border);
+}
+
+.hero__art-saucer,
+.hero__art-cup {
+  fill: var(--color-surface);
+}
+
+.hero__art-moon,
+.hero__art-spark {
+  color: var(--color-secondary);
+}
+
+.hero__art-steam,
+.hero__art-leaf {
+  color: var(--color-text-muted);
+}
+
 /* ── Desde 768 px ─────────────────────────────────────── */
+/* Dos columnas: luna, título, eslogan y botón a la izquierda; la taza a la derecha. */
 @media (min-width: 768px) {
   .hero {
     min-height: calc(100vh - var(--header-height));
     min-height: calc(100svh - var(--header-height));
   }
+
+  .hero__content {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto;
+    justify-items: start;
+    align-items: center;
+    column-gap: var(--space-6);
+  }
+
+  .hero__art {
+    display: block;
+    grid-column: 2;
+    grid-row: 1 / span 4;
+  }
 }

