+import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
+import { dirname, join, relative, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { MOON_PATH } from "./sections/icons";
+
+// T-20261117-001: decorative SVGs on the mounted page (CA-2, CA-3, CA-11), focus order unchanged
+// (CA-12) and no new resources (CA-2, CA-13 e, CA-14). Mounted as in a11y.test.ts.
+
+const srcDir = dirname(fileURLToPath(import.meta.url));
+const projectRoot = resolve(srcDir, "..");
+const indexHtml = (): string => readFileSync(resolve(projectRoot, "index.html"), "utf8");
+const indexDoc = (): Document => new DOMParser().parseFromString(indexHtml(), "text/html");
+const squash = (value: string | null | undefined): string => (value ?? "").replace(/\s+/g, " ").trim();
+
+const mountPage = async (): Promise<void> => {
+  document.body.replaceWith(document.importNode(indexDoc().body, true));
+  await import("./main");
+};
+
+const FORBIDDEN_TAGS = ["title", "desc", "text", "image", "use", "foreignobject", "script"];
+
+// CA-1 (a)–(d) for any <svg> of the page.
+const expectDecorative = (svg: Element): void => {
+  const label = svg.getAttribute("class") ?? svg.outerHTML;
+  expect(svg.getAttribute("aria-hidden"), label).toBe("true");
+  expect(svg.getAttribute("focusable"), label).toBe("false");
+  expect(svg.getAttribute("viewBox"), label).toMatch(/^\d+ \d+ \d+ \d+$/);
+  expect(svg.textContent, label).toBe("");
+  for (const node of [svg, ...Array.from(svg.querySelectorAll("*"))]) {
+    expect(FORBIDDEN_TAGS, `${label} ${node.tagName}`).not.toContain(node.tagName.toLowerCase());
+    for (const attr of Array.from(node.attributes)) {
+      const name = attr.name.toLowerCase();
+      expect(["href", "xlink:href", "style", "tabindex"], `${label} ${name}`).not.toContain(name);
+      expect(name.startsWith("on"), `${label} ${name}`).toBe(false);
+      if (name === "fill" || name === "stroke") expect(["currentColor", "none"], `${label} ${name}`).toContain(attr.value);
+    }
+  }
+};
+
+describe("T-20261117-001 CA-2: inventory of SVGs on the mounted page", () => {
+  beforeEach(async () => {
+    vi.resetModules();
+    await mountPage();
+  });
