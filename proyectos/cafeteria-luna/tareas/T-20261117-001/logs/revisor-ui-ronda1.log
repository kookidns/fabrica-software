diff --git a/src/sections/icons.test.ts b/src/sections/icons.test.ts
new file mode 100644
index 0000000..b2c1235
--- /dev/null
+++ b/src/sections/icons.test.ts
@@ -0,0 +1,104 @@
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+import { ICON_NAMES, createIcon, type IconName } from "./icons";
+
+// T-20261117-001 CA-1: a single module draws every decorative SVG with the DOM API.
+
+const sectionsDir = dirname(fileURLToPath(import.meta.url));
+const SVG_NS = "http://www.w3.org/2000/svg";
+const NAMES: IconName[] = ["moon", "cup", "cake", "calendar", "pin", "whatsapp", "cup-art"];
+const FORBIDDEN_TAGS = ["title", "desc", "text", "image", "use", "foreignobject", "script"];
+
+const allNodes = (svg: SVGSVGElement): Element[] => [svg, ...Array.from(svg.querySelectorAll("*"))];
+
+describe("T-20261117-001 CA-1: createIcon(name) returns a decorative SVGSVGElement", () => {
+  it("exports exactly the seven icon names", () => {
+    expect([...ICON_NAMES].sort()).toEqual([...NAMES].sort());
+  });
+
+  it.each(NAMES)("%s is an <svg> in the SVG namespace with at least one shape", (name) => {
+    const svg = createIcon(name);
+    expect(svg).toBeInstanceOf(SVGSVGElement);
+    expect(svg.namespaceURI).toBe(SVG_NS);
+    expect(svg.tagName).toBe("svg");
+    expect(svg.querySelectorAll("path, circle, ellipse, rect, line").length).toBeGreaterThan(0);
+    for (const node of allNodes(svg)) {
+      expect(node.namespaceURI, node.tagName).toBe(SVG_NS);
+    }
+  });
+
+  it.each(NAMES)("(a) %s has aria-hidden, focusable=false and a viewBox", (name) => {
+    const svg = createIcon(name);
+    expect(svg.getAttribute("aria-hidden")).toBe("true");
+    expect(svg.getAttribute("focusable")).toBe("false");
+    expect(svg.getAttribute("viewBox")).toMatch(/^\d+ \d+ \d+ \d+$/);
+    expect(svg.hasAttribute("tabindex")).toBe(false);
+  });
+
+  it.each(NAMES)("(b) %s has no forbidden element or attribute", (name) => {
+    for (const node of allNodes(createIcon(name))) {
+      expect(FORBIDDEN_TAGS, node.tagName).not.toContain(node.tagName.toLowerCase());
+      for (const attr of Array.from(node.attributes)) {
+        expect(["href", "xlink:href", "style"], `${node.tagName} ${attr.name}`).not.toContain(attr.name.toLowerCase());
+        expect(attr.name.toLowerCase().startsWith("on"), `${node.tagName} ${attr.name}`).toBe(false);
+      }
+    }
+  });
+
+  it.each(NAMES)("(c) %s only uses currentColor or none in fill and stroke", (name) => {
+    for (const node of allNodes(createIcon(name))) {
+      for (const attr of ["fill", "stroke"]) {
+        if (node.hasAttribute(attr)) {
+          expect(["currentColor", "none"], `${node.tagName} ${attr}`).toContain(node.getAttribute(attr));
+        }
+      }
+    }
+  });
+
+  it.each(NAMES)("(d) %s has an empty textContent", (name) => {
+    expect(createIcon(name).textContent).toBe("");
+  });
+
+  it("puts the optional class name on the <svg>", () => {
+    expect(createIcon("moon", "hero__moon").getAttribute("class")).toBe("hero__moon");
+    expect(createIcon("cup").hasAttribute("class")).toBe(false);
+  });
+
+  it("returns a new element on every call", () => {
+    expect(createIcon("pin")).not.toBe(createIcon("pin"));
+  });
+
+  it("gives the cup-art parts their own classes so hero.css can color them with tokens", () => {
+    const art = createIcon("cup-art", "hero__art");
+    const classes = new Set(Array.from(art.querySelectorAll("[class]"), (node) => node.getAttribute("class")));
+    for (const part of ["hero__art-saucer", "hero__art-cup", "hero__art-coffee", "hero__art-steam", "hero__art-moon"]) {
+      expect(classes, part).toContain(part);
+    }
+  });
+});
+
+describe("T-20261117-001 CA-1: icons.ts source", () => {
+  const source = readFileSync(resolve(sectionsDir, "icons.ts"), "utf8");
+
+  it("creates the elements with createElementNS and the SVG namespace", () => {
+    expect(source).toContain("createElementNS");
+    expect(source).toContain(SVG_NS);
+  });
+
+  it("has no color literals", () => {
+    expect(source).not.toMatch(/#[0-9a-f]{3}(?:[0-9a-f]{3})?(?![\w-])/i);
+    expect(source).not.toMatch(/\b(rgba?|hsla?)\(/i);
+  });
+
+  it("uses no HTML-string DOM API", () => {
+    for (const api of ["innerHTML", "outerHTML", "insertAdjacentHTML", "DOMParser"]) {
+      expect(source, `icons.ts contains ${api}`).not.toContain(api);
+    }
+  });
+
+  it("has at most 200 lines", () => {
+    expect(source.replace(/\r?\n$/, "").split(/\r?\n/).length).toBeLessThanOrEqual(200);
+  });
+});
diff --git a/src/sections/icons.ts b/src/sections/icons.ts
