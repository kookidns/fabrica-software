+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+// T-20261117-001: decorative styles of each section, read from its own stylesheet (CA-3 to CA-11).
+
+const stylesDir = dirname(fileURLToPath(import.meta.url));
+const stripComments = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
+const normalize = (value: string): string => value.replace(/\s+/g, " ").trim();
+const MD = "@media (min-width: 768px)";
+
+interface CssRule {
+  context: string;
+  selectors: string[];
+  body: string;
+}
+
+// Top-level rules and rules one level inside an @-block (same approach as split.test.ts).
+const parseCss = (file: string): CssRule[] => {
+  const css = stripComments(readFileSync(resolve(stylesDir, file), "utf8"));
+  const rules: CssRule[] = [];
+  const toRule = (context: string, prelude: string, body: string): CssRule => ({
+    context,
+    selectors: prelude.split(",").map(normalize).filter(Boolean),
+    body: normalize(body),
+  });
+  let index = 0;
+  while (index < css.length) {
+    const open = css.indexOf("{", index);
+    if (open < 0) break;
+    const prelude = css.slice(index, open);
+    if (prelude.trim().startsWith("@")) {
+      let depth = 0;
+      let end = open;
+      for (; end < css.length; end += 1) {
+        if (css[end] === "{") depth += 1;
+        if (css[end] === "}") depth -= 1;
+        if (depth === 0) break;
+      }
+      const context = normalize(prelude).replace(/\(\s*/g, "(").replace(/\s*\)/g, ")").replace(/\s*:\s*/g, ": ");
+      for (const match of css.slice(open + 1, end).matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
+        rules.push(toRule(context, match[1] ?? "", match[2] ?? ""));
+      }
+      index = end + 1;
+    } else {
+      const close = css.indexOf("}", open);
+      rules.push(toRule("", prelude, css.slice(open + 1, close)));
+      index = close + 1;
+    }
+  }
+  return rules;
+};
+
+const declarations = (body: string): Map<string, string> => {
+  const map = new Map<string, string>();
+  for (const part of body.split(";")) {
+    const colon = part.indexOf(":");
+    if (colon >= 0) map.set(part.slice(0, colon).trim(), part.slice(colon + 1).trim());
+  }
+  return map;
+};
+
+// Merged declarations of every rule of `file` whose selector list contains `selector`, in `context`.
+const decl = (file: string, selector: string, context = ""): Map<string, string> =>
+  new Map(
+    parseCss(file)
+      .filter((rule) => rule.context === context && rule.selectors.includes(selector))
+      .flatMap((rule) => [...declarations(rule.body)]),
+  );
+
+const SIZE = /^(\d*\.?\d+em|var\(--[\w-]+\))$/;
+
+describe("T-20261117-001 CA-3: header.css only gains .brand__icon", () => {
+  it(".brand__icon is sized in em or tokens, does not shrink and is painted in secondary", () => {
+    const icon = decl("header.css", ".brand__icon");
+    expect(icon.get("flex")).toBe("none");
+    expect(icon.get("width")).toMatch(SIZE);
+    expect(icon.get("height")).toMatch(SIZE);
+    expect(icon.get("color")).toBe("var(--color-secondary)");
+  });
+
+  it("keeps .brand and .brand:focus-visible exactly as before", () => {
+    expect(Object.fromEntries(decl("header.css", ".brand"))).toEqual({
+      display: "inline-flex",
+      "align-items": "center",
+      "min-height": "var(--header-height)",
+      "padding-inline": "var(--space-2)",
+      "margin-inline": "calc(-1 * var(--space-2))",
+      "font-family": "var(--font-heading)",
+      "font-weight": "700",
+      "font-size": "var(--text-lg)",
+      "line-height": "var(--leading-heading)",
+      color: "var(--color-text)",
+      "text-decoration": "none",
+    });
+    expect(Object.fromEntries(decl("header.css", ".brand:focus-visible"))).toEqual({ "outline-offset": "-3px" });
+  });
+});
+
+describe("T-20261117-001 CA-4 and CA-5: hero.css paints the moon and shows the cup from 768 px", () => {
+  it(".hero__moon is painted in secondary and does not shrink", () => {
+    expect(decl("hero.css", ".hero__moon").get("color")).toBe("var(--color-secondary)");
+    expect(decl("hero.css", ".hero__moon").get("flex")).toBe("none");
+  });
