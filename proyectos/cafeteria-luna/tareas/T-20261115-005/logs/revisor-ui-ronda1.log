  padding-inline: var(--space-4);
  border-radius: var(--radius-sm);
  background: var(--color-surface-raised);
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: var(--shadow-md);
}

.skip-link:not(:focus) {
  width: 1px;
  height: 1px;
  min-height: 0;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ── Cabecera sticky ──────────────────────────────────── */
/* Móvil: el nombre ocupa una fila de --header-height y la navegación otra de --tap-min
   (las tres entradas no caben junto al nombre en 375 px). Desde 768 px, una sola fila. */
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}

.site-header__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  column-gap: var(--space-4);
}

/* padding-inline + margin negativo igual: deja sitio al anillo de foco junto al texto sin mover
   la marca en reposo (mismo patrón que .site-nav__list). */
.brand {
  display: inline-flex;
  align-items: center;
  min-height: var(--header-height);
  padding-inline: var(--space-2);
  margin-inline: calc(-1 * var(--space-2));
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: var(--text-lg);
  line-height: var(--leading-heading);
  color: var(--color-text);
  text-decoration: none;
}

/* La caja de la marca empieza en y = 0 (cabecera sticky sin padding): con el offset global de
   +3 px el lado de arriba del anillo quedaba fuera de la ventana. Hacia dentro cae sobre el
   fondo surface de la cabecera (6.97:1); grosor, estilo y color siguen siendo los globales. */
.brand:focus-visible {
  outline-offset: -3px;
}

.site-nav {
  flex-basis: 100%;
  min-width: 0;
}

.site-nav__list {
  display: flex;
  gap: var(--space-2);
  margin: 0 calc(-1 * var(--space-2));
  padding: 0;
  list-style: none;
}

/* min-width: los 44 px de ancho no dependen de la longitud del texto (CA-05.2). */
.nav-link {
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  min-width: var(--tap-min);
  padding-inline: var(--space-2);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary);
  text-decoration: none;
  white-space: nowrap;
}

.nav-link:hover {
  text-decoration: underline;
  text-underline-offset: var(--space-1);
}

/* ── Desde 768 px ─────────────────────────────────────── */
@media (min-width: 768px) {
  .site-header__inner {
    flex-wrap: nowrap;
    min-height: var(--header-height);
  }

  .site-nav {
    flex-basis: auto;
  }

  .site-nav__list {
    margin: 0;
  }
}
/* Estilos base y layout mobile-first; solo usan var(--…) de tokens.css (D-02, brain/diseno.md).
   Cabecera, botones, portada, Reservar y pie viven en su propio archivo (header.css, buttons.css,
   hero.css, reserve.css, footer.css), importado en main.ts después de este. */

/* ── Base ─────────────────────────────────────────────── */
*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-body);
  color: var(--color-text);
  background: var(--color-bg);
  overflow-wrap: break-word;
}

h1,
h2,
h3 {
  margin: 0;
  font-family: var(--font-heading);
  line-height: var(--leading-heading);
  color: var(--color-text);
  overflow-wrap: anywhere;
}

p {
  margin: 0;
}

a {
  color: var(--color-primary);
}

.container {
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  padding-inline: var(--gutter);
}

/* ── Foco: anillo azul que cae sobre el fondo, nunca sobre el primario ── */
:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 3px;
}

/* main recibe el foco del enlace de salto; el anillo alrededor de toda la página no aporta. */
main:focus {
  outline: none;
}

/* ── Secciones ────────────────────────────────────────── */
/* El ancla deja el título bajo la cabecera de dos filas (nombre + navegación). */
main > section {
  padding-block: var(--space-7);
  scroll-margin-top: calc(var(--header-height) + var(--tap-min));
}

main > section:nth-of-type(even) {
  background: var(--color-surface);
}

main > section h2 {
  margin-bottom: var(--space-5);
  font-size: var(--text-2xl);
  font-weight: 600;
}

/* ── Desde 768 px ─────────────────────────────────────── */
@media (min-width: 768px) {
  main > section {
    padding-block: var(--space-8);
    scroll-margin-top: var(--header-height);
  }
}

/* ── Movimiento reducido ──────────────────────────────── */
/* La anulación de .btn:active vive junto al botón, en buttons.css (CA-10). */
@media (prefers-reduced-motion: no-preference) {
  html {
    scroll-behavior: smooth;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
    scroll-behavior: auto !important;
  }
}

