// T-20261115-005: the focus ring of .brand is drawn inwards because its box starts at y = 0.
describe("T-20261115-005 CA-4: change limited to the focus ring of .brand", () => {
  const PX = /^(-?\d*\.?\d+)px$/;
  const OUTLINE_LONGHANDS = ["outline", "outline-color", "outline-style", "outline-width"];
  const brandFocus = (): Map<string, string> => declarations(exactRule("header.css", ".brand:focus-visible")?.body ?? "");
  const globalRingWidth = (): number => {
    const outline = declarations(exactRule("main.css", ":focus-visible")?.body ?? "").get("outline") ?? "";
    return Number(outline.split(" ")[0]?.match(PX)?.[1] ?? Number.NaN);
  };
  const offsetPx = (): number => Number(brandFocus().get("outline-offset")?.match(PX)?.[1] ?? Number.NaN);

  it("(a) adds no :hover rule and leaves the @media (min-width: 768px) rules of header.css unchanged", () => {
    const hovers = rulesOf("header.css").flatMap((rule) => rule.selectors.filter((s) => s.includes(":hover")));
    expect(hovers).toEqual([".nav-link:hover"]);
    const md = Object.fromEntries(
      rulesOf("header.css")
        .filter((rule) => rule.context === MD)
        .map((rule) => [rule.selectors.join(", "), Object.fromEntries(declarations(rule.body))]),
    );
    expect(md).toEqual({
      ".site-header__inner": { "flex-wrap": "nowrap", "min-height": "var(--header-height)" },
      ".site-nav": { "flex-basis": "auto" },
      ".site-nav__list": { margin: "0" },
    });
  });

  it("(b) .brand:focus-visible declares a negative outline-offset in px at least as large as the global ring", () => {
    expect(exactRule("header.css", ".brand:focus-visible"), ".brand:focus-visible in header.css").toBeDefined();
    expect(brandFocus().get("outline-offset")).toMatch(PX);
    expect(globalRingWidth()).toBe(3);
    expect(offsetPx()).toBeLessThan(0);
    expect(Math.abs(offsetPx())).toBeGreaterThanOrEqual(globalRingWidth());
  });

  it("(c) .brand:focus-visible keeps width, style and color from the global ring", () => {
    expect(exactRule("header.css", ".brand:focus-visible")).toBeDefined();
    for (const property of OUTLINE_LONGHANDS) {
      expect(brandFocus().has(property), property).toBe(false);
    }
  });

  it("(d) the only :focus-visible selectors in src/styles/*.css are the global, footer and brand ones", () => {
    const focusSelectors = [...parsed.values()]
      .flat()
      .flatMap((rule) => rule.selectors.filter((s) => s.includes(":focus-visible")).map((s) => `${rule.file}|${rule.context}|${s}`));
    expect(focusSelectors.sort()).toEqual(
      ["footer.css||.site-footer :focus-visible", "header.css||.brand:focus-visible", "main.css||:focus-visible"].sort(),
    );
    const global = declarations(exactRule("main.css", ":focus-visible")?.body ?? "");
    expect(Object.fromEntries(global)).toEqual({ outline: "3px solid var(--color-focus)", "outline-offset": "3px" });
  });

  // Supports CA-2 and CA-3: the inward ring needs room beside the text, and the padding is
  // cancelled by an equal negative margin so the resting layout does not move.
  it(".brand gains inline padding cancelled by an equal negative margin, wider than the inward ring", () => {
    const brand = declarations(exactRule("header.css", ".brand")?.body ?? "");
    expect(brand.get("padding-inline")).toBe("var(--space-2)");
    expect(brand.get("margin-inline")).toBe("calc(-1 * var(--space-2))");
    expect(brand.get("min-height")).toBe("var(--header-height)");
    const { base, md } = tokenPx();
    for (const tokens of [base, md]) {
      expect(tokens.get("--space-2")).toBeGreaterThanOrEqual(Math.abs(offsetPx()));
    }
  });
});

