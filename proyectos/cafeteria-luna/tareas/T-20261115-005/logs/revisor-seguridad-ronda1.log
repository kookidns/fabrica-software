/**
 * Builds the WhatsApp "click to chat" link (D-05): https://wa.me/<digits>?text=<message>.
 * Works for the mobile app and for WhatsApp Web on desktop.
 * Pure function: the number and message come from src/data/business.ts, never from here.
 */
export function buildWhatsAppUrl(number: string, message: string): string {
  // wa.me only accepts digits: drop "+", spaces, dashes, parentheses and anything else.
  const digits = number.replace(/\D/g, "");
  if (digits === "") {
    throw new Error("WhatsApp number must contain at least one digit");
  }
  // encodeURIComponent (not URLSearchParams) so spaces become %20 instead of "+".
  return `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
}
/**
 * Map URLs for the "Horario y ubicación" section (D-05). Pure functions: the coordinates come from
 * src/data/business.ts through the caller, never from here (D-00).
 */

const OSM_EMBED_URL = "https://www.openstreetmap.org/export/embed.html";
const DIRECTIONS_URL = "https://www.google.com/maps/search/";

/** Half side of the embedded map's bbox, in degrees (~1 km across: street level). */
const BBOX_HALF_SIDE = 0.005;

// Fail loudly instead of placing the marker somewhere wrong or building a broken URL.
function assertCoordinates(lat: number, lng: number): void {
  if (!Number.isFinite(lat) || lat < -90 || lat > 90) {
    throw new Error(`Invalid latitude: ${String(lat)}`);
  }
  if (!Number.isFinite(lng) || lng < -180 || lng > 180) {
    throw new Error(`Invalid longitude: ${String(lng)}`);
  }
}

// Six decimals (~0.1 m): no exponent notation and no floating-point noise.
const serialize = (value: number): string => value.toFixed(6);

/** OpenStreetMap embed URL with a marker at (lat, lng); bbox order is west,south,east,north. */
export function buildMapEmbedUrl(lat: number, lng: number): string {
  assertCoordinates(lat, lng);
  const bbox = [lng - BBOX_HALF_SIDE, lat - BBOX_HALF_SIDE, lng + BBOX_HALF_SIDE, lat + BBOX_HALF_SIDE]
    .map(serialize)
    .join(",");
  const params = new URLSearchParams({
    bbox,
    layer: "mapnik",
    marker: `${serialize(lat)},${serialize(lng)}`,
  });
  return `${OSM_EMBED_URL}?${params.toString()}`;
}

/** Google Maps URL that opens the maps app (mobile) or the web (desktop) at (lat, lng). */
export function buildDirectionsUrl(lat: number, lng: number): string {
  assertCoordinates(lat, lng);
  const params = new URLSearchParams({ api: "1", query: `${serialize(lat)},${serialize(lng)}` });
  return `${DIRECTIONS_URL}?${params.toString()}`;
}
