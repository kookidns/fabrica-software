/* ── Enlace "Saltar al contenido": oculto hasta recibir foco ── */
.skip-link {
  position: absolute;
  top: var(--space-2);
  left: var(--space-2);
  z-index: 20;
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  padding-inline: var(--space-4);
  border-radius: var(--radius-sm);
  background: var(--color-surface-raised);
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: var(--shadow-md);
}

.skip-link:not(:focus) {
  width: 1px;
  height: 1px;
  min-height: 0;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ── Cabecera sticky ──────────────────────────────────── */
/* Móvil: el nombre ocupa una fila de --header-height y la navegación otra de --tap-min
   (las tres entradas no caben junto al nombre en 375 px). Desde 768 px, una sola fila. */
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}

.site-header__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  column-gap: var(--space-4);
}

/* padding-inline + margin negativo igual: deja sitio al anillo de foco junto al texto sin mover
   la marca en reposo (mismo patrón que .site-nav__list). */
.brand {
  display: inline-flex;
  align-items: center;
  min-height: var(--header-height);
  padding-inline: var(--space-2);
  margin-inline: calc(-1 * var(--space-2));
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: var(--text-lg);
  line-height: var(--leading-heading);
  color: var(--color-text);
  text-decoration: none;
}

/* La caja de la marca empieza en y = 0 (cabecera sticky sin padding): con el offset global de
   +3 px el lado de arriba del anillo quedaba fuera de la ventana. Hacia dentro cae sobre el
   fondo surface de la cabecera (6.97:1); grosor, estilo y color siguen siendo los globales. */
.brand:focus-visible {
  outline-offset: -3px;
}

.site-nav {
  flex-basis: 100%;
  min-width: 0;
}

.site-nav__list {
  display: flex;
  gap: var(--space-2);
  margin: 0 calc(-1 * var(--space-2));
  padding: 0;
  list-style: none;
}

/* min-width: los 44 px de ancho no dependen de la longitud del texto (CA-05.2). */
.nav-link {
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  min-width: var(--tap-min);
  padding-inline: var(--space-2);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary);
  text-decoration: none;
  white-space: nowrap;
}

.nav-link:hover {
  text-decoration: underline;
  text-underline-offset: var(--space-1);
}

/* ── Desde 768 px ─────────────────────────────────────── */
@media (min-width: 768px) {
  .site-header__inner {
    flex-wrap: nowrap;
    min-height: var(--header-height);
  }

  .site-nav {
    flex-basis: auto;
  }

  .site-nav__list {
    margin: 0;
  }
}
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { describe, expect, it } from "vitest";

// T-20261115-004: main.css split (decision 1), tap targets and focus ring (CA-05.2) read from the CSS.

const stylesDir = dirname(fileURLToPath(import.meta.url));
const stripComments = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
const normalize = (value: string): string => value.replace(/\s+/g, " ").trim();
const readRaw = (file: string): string => readFileSync(resolve(stylesDir, file), "utf8");

// "@media (min-width: 768px)" whatever the spacing; "" for top-level rules.
const normalizeQuery = (query: string): string =>
  normalize(query)
    .toLowerCase()
    .replace(/\(\s*/g, "(")
    .replace(/\s*\)/g, ")")
    .replace(/\s*:\s*/g, ": ");

interface CssRule {
  file: string;
  context: string;
  selectors: string[];
  body: string;
  /** Offset in the comment-free source, to compare the order of two rules. */
  start: number;
}

const toRule = (file: string, context: string, prelude: string, body: string, start: number): CssRule => ({
  file,
  context,
  selectors: prelude.split(",").map(normalize).filter(Boolean),
  body: normalize(body),
  start,
});

// Top-level rules and rules one level inside an @-block (all this project uses).
const parseCss = (file: string): CssRule[] => {
  const css = stripComments(readRaw(file));
  const rules: CssRule[] = [];
  let index = 0;
  while (index < css.length) {
    const open = css.indexOf("{", index);
    if (open < 0) break;
    const prelude = css.slice(index, open);
    if (prelude.trim().startsWith("@")) {
      let depth = 0;
      let end = open;
      for (; end < css.length; end += 1) {
        if (css[end] === "{") depth += 1;
        if (css[end] === "}") depth -= 1;
        if (depth === 0) break;
      }
      const inner = css.slice(open + 1, end);
      const context = normalizeQuery(prelude);
      for (const match of inner.matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
        rules.push(toRule(file, context, match[1] ?? "", match[2] ?? "", open + 1 + (match.index ?? 0)));
      }
      index = end + 1;
    } else {
      const close = css.indexOf("}", open);
      rules.push(toRule(file, "", prelude, css.slice(open + 1, close), index));
      index = close + 1;
    }
  }
  return rules;
};

const declarations = (body: string): Map<string, string> => {
  const map = new Map<string, string>();
  for (const part of body.split(";")) {
    const colon = part.indexOf(":");
    if (colon < 0) continue;
    map.set(part.slice(0, colon).trim(), part.slice(colon + 1).trim());
  }
  return map;
};

const MD = "@media (min-width: 768px)";
const NO_PREFERENCE = "@media (prefers-reduced-motion: no-preference)";
const REDUCE = "@media (prefers-reduced-motion: reduce)";

const STYLE_FILES = [
  "tokens.css",
  "main.css",
  "header.css",
  "buttons.css",
  "hero.css",
  "reserve.css",
  "footer.css",
