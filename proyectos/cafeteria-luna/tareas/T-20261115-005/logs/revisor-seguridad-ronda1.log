  },
  "footer.css": {
    "": [".site-footer", ".site-footer a", ".site-footer :focus-visible", ".site-footer__name", ".site-footer__notice"],
  },
};

const allCssFiles = readdirSync(stylesDir).filter((file) => file.endsWith(".css"));
const parsed = new Map(allCssFiles.map((file) => [file, parseCss(file)]));
const rulesOf = (file: string): CssRule[] => parsed.get(file) ?? [];
const exactRule = (file: string, selector: string, context = ""): CssRule | undefined =>
  rulesOf(file).find((rule) => rule.context === context && rule.selectors.length === 1 && rule.selectors[0] === selector);

// Token values in px (1rem = 16px), at the base and from 768 px.
const tokenPx = (): { base: Map<string, number>; md: Map<string, number> } => {
  const toPx = (value: string): number => {
    const match = value.match(/^([\d.]+)(px|rem)$/);
    if (!match) return Number.NaN;
    return Number(match[1]) * (match[2] === "rem" ? 16 : 1);
  };
  const pick = (rules: CssRule[]): Map<string, number> => {
    const map = new Map<string, number>();
    for (const rule of rules) {
      for (const [name, value] of declarations(rule.body)) map.set(name, toPx(value));
    }
    return map;
  };
  const tokens = rulesOf("tokens.css").filter((rule) => rule.selectors.includes(":root"));
  const base = pick(tokens.filter((rule) => rule.context === ""));
  const md = new Map([...base, ...pick(tokens.filter((rule) => rule.context === MD))]);
  return { base, md };
};

