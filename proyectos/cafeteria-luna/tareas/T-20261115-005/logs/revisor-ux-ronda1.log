/* Enlace de salto y cabecera sticky con la navegación; solo usan var(--…) de tokens.css
   (D-02, D-08, brain/diseno.md). */

/* ── Enlace "Saltar al contenido": oculto hasta recibir foco ── */
.skip-link {
  position: absolute;
  top: var(--space-2);
  left: var(--space-2);
  z-index: 20;
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  padding-inline: var(--space-4);
  border-radius: var(--radius-sm);
  background: var(--color-surface-raised);
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: var(--shadow-md);
}

.skip-link:not(:focus) {
  width: 1px;
  height: 1px;
  min-height: 0;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ── Cabecera sticky ──────────────────────────────────── */
/* Móvil: el nombre ocupa una fila de --header-height y la navegación otra de --tap-min
   (las tres entradas no caben junto al nombre en 375 px). Desde 768 px, una sola fila. */
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}

.site-header__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  column-gap: var(--space-4);
}

/* padding-inline + margin negativo igual: deja sitio al anillo de foco junto al texto sin mover
   la marca en reposo (mismo patrón que .site-nav__list). */
.brand {
  display: inline-flex;
  align-items: center;
  min-height: var(--header-height);
  padding-inline: var(--space-2);
  margin-inline: calc(-1 * var(--space-2));
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: var(--text-lg);
  line-height: var(--leading-heading);
  color: var(--color-text);
  text-decoration: none;
}

/* La caja de la marca empieza en y = 0 (cabecera sticky sin padding): con el offset global de
   +3 px el lado de arriba del anillo quedaba fuera de la ventana. Hacia dentro cae sobre el
   fondo surface de la cabecera (6.97:1); grosor, estilo y color siguen siendo los globales. */
.brand:focus-visible {
  outline-offset: -3px;
}

.site-nav {
  flex-basis: 100%;
  min-width: 0;
}

.site-nav__list {
  display: flex;
  gap: var(--space-2);
  margin: 0 calc(-1 * var(--space-2));
  padding: 0;
  list-style: none;
}

/* min-width: los 44 px de ancho no dependen de la longitud del texto (CA-05.2). */
.nav-link {
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  min-width: var(--tap-min);
  padding-inline: var(--space-2);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary);
  text-decoration: none;
  white-space: nowrap;
}

.nav-link:hover {
  text-decoration: underline;
  text-underline-offset: var(--space-1);
}

/* ── Desde 768 px ─────────────────────────────────────── */
@media (min-width: 768px) {
  .site-header__inner {
    flex-wrap: nowrap;
    min-height: var(--header-height);
  }

  .site-nav {
    flex-basis: auto;
  }

  .site-nav__list {
    margin: 0;
  }
}
