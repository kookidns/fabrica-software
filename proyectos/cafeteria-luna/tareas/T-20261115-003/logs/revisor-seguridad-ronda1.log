+      expect(row.querySelector("td")?.textContent).toBe(expected);
+    });
+  });
+
+  it("shows exactly Cerrado for both closed days and hours for the open ones", () => {
+    const byDay = new Map(rows.map((row) => [row.querySelector("th")?.textContent, row.querySelector("td")?.textContent]));
+    expect(byDay.get("Lunes")).toBe("Cerrado");
+    expect(byDay.get("Domingo")).toBe("Cerrado");
+    expect(byDay.get("Martes")).toBe("07:30 a 19:00");
+    expect(byDay.get("Viernes")).toBe("07:30 a 22:15");
+    expect(rows.filter((row) => /\d/.test(row.querySelector("td")?.textContent ?? ""))).toHaveLength(5);
