+
+type Location = Pick<Business, "hours" | "address" | "coordinates">;
+
+// Test data, deliberately different from business.ts: two closed days (Lunes and Domingo).
+const LOCATION: Location = {
+  hours: [
+    { day: "Lunes", closed: true },
+    { day: "Martes", open: "07:30", close: "19:00" },
+    { day: "Miércoles", open: "07:30", close: "19:00" },
+    { day: "Jueves", open: "07:30", close: "19:00" },
+    { day: "Viernes", open: "07:30", close: "22:15" },
+    { day: "Sábado", open: "10:00", close: "22:15" },
+    { day: "Domingo", closed: true },
+  ],
+  address: "Avenida de Prueba 456, Col. Pruebas, 11111 Guadalajara, Jalisco, México",
+  coordinates: { lat: 20.6597, lng: -103.3496 },
+};
+
+const IFRAME_TITLE = "Mapa con la ubicación de la cafetería";
+const LINK_TEXT = "Cómo llegar";
+const SANDBOX = ["allow-popups", "allow-popups-to-escape-sandbox", "allow-same-origin", "allow-scripts"];
+
+const directionsLinks = (element: HTMLElement): HTMLAnchorElement[] =>
+  Array.from(element.querySelectorAll("a")).filter((a) => a.textContent?.trim() === LINK_TEXT);
+
+describe("CA-6: renderLocation returns the Horario and Dirección blocks", () => {
+  it("has exactly two <h3>, Horario then Dirección, and no <h1>, <h2> or <section>", () => {
+    const element = renderLocation(LOCATION);
+    expect(Array.from(element.querySelectorAll("h3"), (h3) => h3.textContent)).toEqual(["Horario", "Dirección"]);
+    expect(element.querySelectorAll("h1, h2, section")).toHaveLength(0);
+    expect(element.tagName).not.toBe("SECTION");
+  });
+});
+
+describe("CA-7: the hours table", () => {
