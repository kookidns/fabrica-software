+    expect(link?.getAttribute("aria-label")).toBe("Cómo llegar (se abre en una pestaña nueva)");
+    expect(link?.getAttribute("aria-label")?.startsWith(LINK_TEXT)).toBe(true);
+    expect(link?.classList.contains("btn")).toBe(true);
+    expect(link?.classList.contains("btn--secondary")).toBe(true);
+  });
+
+  it("comes after the iframe in document order", () => {
+    const iframe = element.querySelector("iframe");
+    expect(iframe).not.toBeNull();
+    expect(link).toBeDefined();
+    if (!iframe || !link) return;
+    expect(iframe.compareDocumentPosition(link) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+  });
+});
+
+describe("CA-11: address and day names are painted as text", () => {
+  it("shows HTML literally in <address> and <th> and creates no <img>", () => {
+    const payload = "<img src=x onerror=alert(1)>";
+    const element = renderLocation({
+      ...LOCATION,
+      address: payload,
+      hours: [{ day: payload, open: "08:00", close: "20:00" }, ...LOCATION.hours.slice(1)],
