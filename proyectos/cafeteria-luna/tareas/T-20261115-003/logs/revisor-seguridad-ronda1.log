diff --git a/src/sections/location.ts b/src/sections/location.ts
new file mode 100644
index 0000000..93701ad
--- /dev/null
+++ b/src/sections/location.ts
@@ -0,0 +1,124 @@
+import type { Business, DayHours } from "../data/business";
+import { buildDirectionsUrl, buildMapEmbedUrl } from "../lib/maps";
+
+/**
+ * "Horario y ubicación" section: an hours card (table) and the place block (address, OpenStreetMap
+ * iframe and "Cómo llegar" link). Hours, address and coordinates arrive as parameters from
+ * src/data/business.ts via main.ts (D-00); URLs are built only by src/lib/maps.ts (D-05).
+ * Text goes in with textContent and attributes with setAttribute only.
+ */
+
+export type Location = Pick<Business, "hours" | "address" | "coordinates">;
+
+const MAP_URL_PREFIX = "https://www.openstreetmap.org/export/embed.html?";
+const DIRECTIONS_URL_PREFIX = "https://www.google.com/maps/search/?";
+
+const HOURS_TITLE = "Horario";
+const HOURS_TITLE_ID = "horario-semana-titulo";
+const PLACE_TITLE = "Dirección";
+const CLOSED_TEXT = "Cerrado";
+const MAP_TITLE = "Mapa con la ubicación de la cafetería";
+const LINK_TEXT = "Cómo llegar";
+// The accessible name starts with the visible text (WCAG 2.5.3): change both together.
+const LINK_LABEL = `${LINK_TEXT} (se abre en una pestaña nueva)`;
+// Leaflet needs scripts; the iframe is cross-origin, so allow-same-origin cannot reach this page.
+// Never add allow-top-navigation*, allow-forms, allow-modals, allow-downloads or allow-pointer-lock.
+const MAP_SANDBOX = "allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox";
+
+function createTitle(text: string): HTMLHeadingElement {
+  const heading = document.createElement("h3");
+  heading.className = "location__title";
+  heading.textContent = text;
+  return heading;
+}
+
+function renderHoursRow(entry: DayHours): HTMLTableRowElement {
+  const row = document.createElement("tr");
+  const day = document.createElement("th");
+  day.setAttribute("scope", "row");
+  day.textContent = entry.day;
+  const time = document.createElement("td");
+  if (entry.closed) {
+    const closed = document.createElement("span");
+    closed.className = "hours__closed";
+    closed.textContent = CLOSED_TEXT;
+    time.append(closed);
+  } else {
+    time.textContent = `${entry.open} a ${entry.close}`;
+  }
+  row.append(day, time);
+  return row;
+}
+
+function renderHours(hours: DayHours[]): HTMLElement {
+  const card = document.createElement("div");
+  card.className = "location__hours";
+  const heading = createTitle(HOURS_TITLE);
+  heading.id = HOURS_TITLE_ID;
+
+  const table = document.createElement("table");
+  table.className = "hours";
+  table.setAttribute("aria-labelledby", HOURS_TITLE_ID);
+  const body = document.createElement("tbody");
+  body.append(...hours.map(renderHoursRow));
+  table.append(body);
+
+  card.append(heading, table);
+  return card;
+}
+
+function createMap(src: string): HTMLIFrameElement {
+  // Guard: only an OpenStreetMap embed may reach the src (blocks javascript: and other schemes).
+  if (!src.startsWith(MAP_URL_PREFIX)) {
+    throw new Error(`Map URL must start with ${MAP_URL_PREFIX}`);
+  }
+  const iframe = document.createElement("iframe");
+  iframe.setAttribute("src", src);
+  iframe.setAttribute("title", MAP_TITLE);
+  iframe.setAttribute("loading", "lazy");
+  iframe.setAttribute("referrerpolicy", "strict-origin-when-cross-origin");
+  iframe.setAttribute("sandbox", MAP_SANDBOX);
+  return iframe;
+}
+
+function createDirectionsLink(href: string): HTMLAnchorElement {
+  // Guard: only a Google Maps search may reach the href.
+  if (!href.startsWith(DIRECTIONS_URL_PREFIX)) {
+    throw new Error(`Directions URL must start with ${DIRECTIONS_URL_PREFIX}`);
+  }
+  const link = document.createElement("a");
+  link.className = "btn btn--secondary";
+  link.setAttribute("href", href);
+  link.setAttribute("target", "_blank");
+  link.setAttribute("rel", "noopener noreferrer");
+  link.setAttribute("aria-label", LINK_LABEL);
+  link.textContent = LINK_TEXT;
+  return link;
+}
+
+function renderPlace(address: string, coordinates: Location["coordinates"]): HTMLElement {
+  // Both URLs are built first: invalid coordinates throw before any element exists.
+  const mapUrl = buildMapEmbedUrl(coordinates.lat, coordinates.lng);
+  const directionsUrl = buildDirectionsUrl(coordinates.lat, coordinates.lng);
+
+  const place = document.createElement("div");
+  place.className = "location__place";
+
+  const addressElement = document.createElement("address");
+  addressElement.className = "location__address";
+  addressElement.textContent = address;
+
+  const map = document.createElement("div");
+  map.className = "location__map";
+  map.append(createMap(mapUrl));
+
+  place.append(createTitle(PLACE_TITLE), addressElement, map, createDirectionsLink(directionsUrl));
+  return place;
+}
+
+export function renderLocation(location: Location): HTMLElement {
+  const container = document.createElement("div");
+  container.className = "location";
+  container.append(renderHours(location.hours), renderPlace(location.address, location.coordinates));
+  return container;
+}
diff --git a/src/styles/location.css b/src/styles/location.css
new file mode 100644
index 0000000..53315ff
--- /dev/null
+++ b/src/styles/location.css
@@ -0,0 +1,128 @@
+/* Sección Horario y ubicación: tarjeta de horario, dirección, mapa y botón "Cómo llegar";
+   solo var(--…) de tokens.css (D-02, brain/diseno.md → Tarjeta, Botón, Layout). */
+
+/* Móvil: una columna, horario arriba y ubicación debajo. */
+.location {
+  display: grid;
+  gap: var(--space-5);
+}
+
+.location__hours,
+.location__place {
+  min-width: 0;
+}
+
+/* Tarjeta informativa, sin hover. */
+.location__hours {
+  padding: var(--space-5);
+  background: var(--color-surface-raised);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+  box-shadow: var(--shadow-sm);
+}
+
+.location__title {
+  margin-bottom: var(--space-4);
+  font-size: var(--text-xl);
+  font-weight: 600;
+}
+
+/* ── Horario ── */
+.hours {
+  width: 100%;
+  border-collapse: collapse;
+}
+
+.hours th,
+.hours td {
+  padding-block: var(--space-3);
+  padding-inline: 0;
+  vertical-align: baseline;
+}
+
+/* Separador solo decorativo entre días. */
+.hours tr + tr th,
+.hours tr + tr td {
+  border-top: 1px solid var(--color-border);
+}
+
+.hours tr:first-child th,
+.hours tr:first-child td {
+  padding-top: 0;
+}
+
+.hours tr:last-child th,
+.hours tr:last-child td {
+  padding-bottom: 0;
+}
+
+.hours th {
+  padding-inline-end: var(--space-4);
+  font-weight: 500;
+  text-align: start;
+  overflow-wrap: anywhere;
+}
+
+/* Las horas nunca se parten. */
+.hours td {
+  text-align: end;
+  white-space: nowrap;
+}
+
+/* El color nunca es el único indicador: siempre va con el texto "Cerrado". */
+.hours__closed {
+  font-weight: 700;
+  color: var(--color-error);
+}
+
+/* ── Ubicación ── */
+.location__address {
+  margin-bottom: var(--space-4);
+  font-style: normal;
+  overflow-wrap: anywhere;
+}
+
+/* Relación fija: el mapa diferido no provoca saltos de maquetación. */
+.location__map {
+  aspect-ratio: 4 / 3;
+  overflow: hidden;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+}
+
+.location__map iframe {
+  display: block;
+  width: 100%;
+  height: 100%;
+  border: 0;
+}
+
+/* Botón de contorno (diseno.md → Botón secondary); móvil: ancho completo. */
+.btn--secondary {
+  width: 100%;
+  margin-top: var(--space-4);
+  background: transparent;
+  color: var(--color-primary);
+  border-color: var(--color-primary);
+}
+
+.btn--secondary:hover {
+  background: var(--color-surface);
+}
+
+/* Desde 768 px: horario | dirección + mapa + botón. */
+@media (min-width: 768px) {
+  .location {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: var(--space-6);
+    align-items: start;
+  }
+
+  .location__map {
+    aspect-ratio: 16 / 9;
+  }
+
+  .btn--secondary {
+    width: auto;
+  }
+}
diff --git a/src/styles/location.test.ts b/src/styles/location.test.ts
new file mode 100644
index 0000000..7221897
--- /dev/null
+++ b/src/styles/location.test.ts
@@ -0,0 +1,132 @@
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+const stylesDir = dirname(fileURLToPath(import.meta.url));
+const stripComments = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
+const normalize = (value: string): string => value.replace(/\s+/g, " ").trim();
+const css = stripComments(readFileSync(resolve(stylesDir, "location.css"), "utf8"));
+
+interface CssRule {
+  selector: string;
+  body: string;
+}
+
+// Innermost rules only (rules nested in @media come out with their own selector).
+const parseRules = (source: string): CssRule[] =>
+  Array.from(source.matchAll(/([^{}]+)\{([^{}]*)\}/g), (match) => ({
+    selector: normalize(match[1] ?? ""),
+    body: normalize(match[2] ?? ""),
+  }));
+
+// Splits the stylesheet into the top-level part and the bodies of its @-blocks, braces balanced.
+const splitAtBlocks = (source: string): { base: string; blocks: { query: string; body: string }[] } => {
+  let base = "";
+  const blocks: { query: string; body: string }[] = [];
+  let index = 0;
+  while (index < source.length) {
+    const at = source.indexOf("@", index);
+    if (at < 0) {
+      base += source.slice(index);
+      break;
+    }
+    base += source.slice(index, at);
+    const open = source.indexOf("{", at);
+    let depth = 0;
+    let end = open;
+    for (; end < source.length; end += 1) {
+      if (source[end] === "{") depth += 1;
+      if (source[end] === "}") depth -= 1;
+      if (depth === 0) break;
+    }
+    blocks.push({ query: normalize(source.slice(at, open)), body: source.slice(open + 1, end) });
+    index = end + 1;
+  }
+  return { base, blocks };
+};
+
+const { base, blocks } = splitAtBlocks(css);
+const baseRules = parseRules(base);
+const mdBlock = blocks.find((block) => /^@media \(\s*min-width:\s*768px\s*\)$/.test(block.query));
+const mdRules = parseRules(mdBlock?.body ?? "");
+
+// Rules whose selector list contains one matching `selector` exactly (after splitting on commas).
+const rulesFor = (selector: RegExp, list: CssRule[] = baseRules): CssRule[] =>
+  list.filter((rule) => rule.selector.split(",").some((part) => selector.test(part.trim())));
+const bodyFor = (selector: RegExp, list: CssRule[] = baseRules): string =>
+  rulesFor(selector, list)
+    .map((rule) => rule.body)
+    .join("; ");
+const declaration = (property: string, value: string): RegExp =>
+  new RegExp(`(^|;\\s*)${property}: ${value}(;|$)`);
+
+describe("CA-19 (a): location.css only uses tokens", () => {
+  it("has no color literals", () => {
+    expect(css).not.toMatch(/#[0-9a-f]{3,8}(?![\w-])/i);
+    expect(css).not.toMatch(/\b(rgba?|hsla?)\(/i);
+  });
+});
+
+describe("CA-19 (b, c): hours card and Cerrado", () => {
+  it("styles the hours block as a diseno.md card", () => {
+    const body = bodyFor(/^\.location__hours$/);
+    expect(body, ".location__hours rule").not.toBe("");
+    for (const token of ["--color-surface-raised", "--color-border", "--radius-md", "--shadow-sm", "--space-5"]) {
+      expect(body, token).toContain(`var(${token})`);
+    }
+  });
+
+  it("paints Cerrado in var(--color-error)", () => {
+    expect(bodyFor(/^\.hours__closed$/)).toContain("var(--color-error)");
+  });
+});
+
+describe("CA-19 (d): address", () => {
+  it("is upright and wraps long words", () => {
+    const body = bodyFor(/^(\.location__address|(\.location\s+)?address)$/);
