import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { describe, expect, it } from "vitest";
import { business, type Business } from "../data/business";
import { buildDirectionsUrl, buildMapEmbedUrl } from "../lib/maps";
import { renderLocation } from "./location";

const sectionsDir = dirname(fileURLToPath(import.meta.url));

type Location = Pick<Business, "hours" | "address" | "coordinates">;

// Test data, deliberately different from business.ts: two closed days (Lunes and Domingo).
const LOCATION: Location = {
  hours: [
    { day: "Lunes", closed: true },
    { day: "Martes", open: "07:30", close: "19:00" },
    { day: "Miércoles", open: "07:30", close: "19:00" },
    { day: "Jueves", open: "07:30", close: "19:00" },
    { day: "Viernes", open: "07:30", close: "22:15" },
    { day: "Sábado", open: "10:00", close: "22:15" },
    { day: "Domingo", closed: true },
  ],
  address: "Avenida de Prueba 456, Col. Pruebas, 11111 Guadalajara, Jalisco, México",
  coordinates: { lat: 20.6597, lng: -103.3496 },
};

const IFRAME_TITLE = "Mapa con la ubicación de la cafetería";
const LINK_TEXT = "Cómo llegar";
const SANDBOX = ["allow-popups", "allow-popups-to-escape-sandbox", "allow-same-origin", "allow-scripts"];

const directionsLinks = (element: HTMLElement): HTMLAnchorElement[] =>
  Array.from(element.querySelectorAll("a")).filter((a) => a.textContent?.trim() === LINK_TEXT);

describe("CA-6: renderLocation returns the Horario and Dirección blocks", () => {
  it("has exactly two <h3>, Horario then Dirección, and no <h1>, <h2> or <section>", () => {
    const element = renderLocation(LOCATION);
    expect(Array.from(element.querySelectorAll("h3"), (h3) => h3.textContent)).toEqual(["Horario", "Dirección"]);
    expect(element.querySelectorAll("h1, h2, section")).toHaveLength(0);
    expect(element.tagName).not.toBe("SECTION");
  });
});

describe("CA-7: the hours table", () => {
  const element = renderLocation(LOCATION);
  const table = element.querySelector("table");
  const rows = Array.from(table?.querySelectorAll("tr") ?? []);

  it("has one row per day, in the order of the data, with <th scope=row> and <td>", () => {
    expect(element.querySelectorAll("table")).toHaveLength(1);
    expect(rows).toHaveLength(7);
    rows.forEach((row, index) => {
      const entry = LOCATION.hours[index];
      expect(Array.from(row.children).map((cell) => cell.tagName)).toEqual(["TH", "TD"]);
      const th = row.querySelector("th");
      expect(th?.getAttribute("scope")).toBe("row");
      expect(th?.textContent).toBe(entry?.day);
      const expected = entry?.closed ? "Cerrado" : `${entry?.open ?? ""} a ${entry?.close ?? ""}`;
      expect(row.querySelector("td")?.textContent).toBe(expected);
    });
  });

  it("shows exactly Cerrado for both closed days and hours for the open ones", () => {
    const byDay = new Map(rows.map((row) => [row.querySelector("th")?.textContent, row.querySelector("td")?.textContent]));
    expect(byDay.get("Lunes")).toBe("Cerrado");
    expect(byDay.get("Domingo")).toBe("Cerrado");
    expect(byDay.get("Martes")).toBe("07:30 a 19:00");
    expect(byDay.get("Viernes")).toBe("07:30 a 22:15");
    expect(rows.filter((row) => /\d/.test(row.querySelector("td")?.textContent ?? ""))).toHaveLength(5);
  });

  it("is named by the Horario <h3> through aria-labelledby", () => {
    const heading = Array.from(element.querySelectorAll("h3")).find((h3) => h3.textContent === "Horario");
    expect(heading?.id).toBeTruthy();
    expect(table?.getAttribute("aria-labelledby")).toBe(heading?.id);
  });
});

describe("CA-8: the address", () => {
  it("has exactly one <address> whose text is the address", () => {
    const element = renderLocation(LOCATION);
    const addresses = element.querySelectorAll("address");
    expect(addresses).toHaveLength(1);
    expect(addresses[0]?.textContent).toBe(LOCATION.address);
  });
});

describe("CA-9: the OpenStreetMap iframe", () => {
  const element = renderLocation(LOCATION);
  const iframe = element.querySelector("iframe");

  it("has exactly one iframe with the embed URL of the coordinates", () => {
    expect(element.querySelectorAll("iframe")).toHaveLength(1);
    expect(iframe?.getAttribute("src")).toBe(buildMapEmbedUrl(LOCATION.coordinates.lat, LOCATION.coordinates.lng));
  });

  it("has the accessible title, lazy loading and the referrer policy", () => {
    expect(iframe?.getAttribute("title")).toBe(IFRAME_TITLE);
    expect(iframe?.getAttribute("loading")).toBe("lazy");
    expect(iframe?.getAttribute("referrerpolicy")).toBe("strict-origin-when-cross-origin");
  });

  it("has exactly the four allowed sandbox tokens", () => {
    const tokens = (iframe?.getAttribute("sandbox") ?? "").split(/\s+/).filter(Boolean).sort();
    expect(tokens).toEqual(SANDBOX);
  });

  it("has no allow, allowfullscreen, srcdoc or frameborder attribute", () => {
    for (const attribute of ["allow", "allowfullscreen", "srcdoc", "frameborder"]) {
      expect(iframe?.hasAttribute(attribute), attribute).toBe(false);
    }
  });
});

describe("CA-10: the Cómo llegar link", () => {
  const element = renderLocation(LOCATION);
  const links = directionsLinks(element);
  const link = links[0];

  it("is a single link to the directions URL that opens in a new tab", () => {
    expect(links).toHaveLength(1);
    expect(link?.getAttribute("href")).toBe(buildDirectionsUrl(LOCATION.coordinates.lat, LOCATION.coordinates.lng));
    expect(link?.getAttribute("target")).toBe("_blank");
    expect(link?.getAttribute("rel")).toBe("noopener noreferrer");
  });

  it("has an aria-label that starts with the visible text and the btn btn--secondary classes", () => {
    expect(link?.getAttribute("aria-label")).toBe("Cómo llegar (se abre en una pestaña nueva)");
    expect(link?.getAttribute("aria-label")?.startsWith(LINK_TEXT)).toBe(true);
    expect(link?.classList.contains("btn")).toBe(true);
    expect(link?.classList.contains("btn--secondary")).toBe(true);
  });

  it("comes after the iframe in document order", () => {
    const iframe = element.querySelector("iframe");
    expect(iframe).not.toBeNull();
    expect(link).toBeDefined();
    if (!iframe || !link) return;
    expect(iframe.compareDocumentPosition(link) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
  });
});

describe("CA-11: address and day names are painted as text", () => {
  it("shows HTML literally in <address> and <th> and creates no <img>", () => {
    const payload = "<img src=x onerror=alert(1)>";
    const element = renderLocation({
      ...LOCATION,
      address: payload,
      hours: [{ day: payload, open: "08:00", close: "20:00" }, ...LOCATION.hours.slice(1)],
    });
    expect(element.querySelector("address")?.textContent).toBe(payload);
    expect(element.querySelector("th")?.textContent).toBe(payload);
    expect(element.querySelector("img")).toBeNull();
  });
});

describe("CA-12: invalid coordinates throw", () => {
  it.each([
    [Number.NaN, 0],
    [0, 181],
  ])("throws for (%s, %s) instead of painting a broken map", (lat, lng) => {
    expect(() => renderLocation({ ...LOCATION, coordinates: { lat, lng } })).toThrow(Error);
  });
});

describe("CA-13: location.ts source", () => {
  const source = readFileSync(resolve(sectionsDir, "location.ts"), "utf8");

  it("uses no HTML-string DOM API nor srcdoc", () => {
    for (const api of ["innerHTML", "outerHTML", "insertAdjacentHTML", "srcdoc"]) {
      expect(source, `location.ts contains ${api}`).not.toContain(api);
    }
  });

  it("imports from ../lib/maps", () => {
    expect(source).toMatch(/from\s*["']\.\.\/lib\/maps["']/);
  });

  it("imports only types from business, never the value", () => {
    expect(source).not.toMatch(/import\s*\{[^}]*\bbusiness\b[^}]*\}/);
    expect(source).not.toMatch(/import\s+business\b/);
    for (const match of source.matchAll(/import\s+([^;]*?)\s+from\s*["'][^"']*data\/business["']/g)) {
      expect(match[1], "imports from data/business must be `import type`").toMatch(/^type\b/);
    }
  });

  it("contains no business data", () => {
    expect(source).not.toContain(business.address);
    for (const entry of business.hours) {
      expect(source, entry.day).not.toContain(entry.day);
    }
    expect(source).not.toContain(String(business.coordinates.lat));
    expect(source).not.toContain(String(business.coordinates.lng));
  });

  it("builds no URLs of its own", () => {
    for (const fragment of ["api=1", "bbox", "marker="]) {
      expect(source, fragment).not.toContain(fragment);
    }
  });
});

