import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { describe, expect, it } from "vitest";
import { buildDirectionsUrl, buildMapEmbedUrl } from "./maps";

const libDir = dirname(fileURLToPath(import.meta.url));
const COORDINATE = /^-?\d+\.\d{6}$/;

const paramNames = (url: URL): string[] => Array.from(url.searchParams.keys()).sort();
const coordinatesOf = (value: string | null): string[] => (value ?? "").split(",");

describe("CA-1: buildMapEmbedUrl builds the OpenStreetMap embed URL", () => {
  const url = new URL(buildMapEmbedUrl(19.4326, -99.1332));

  it("points to https://www.openstreetmap.org/export/embed.html", () => {
    expect(url.protocol).toBe("https:");
    expect(url.host).toBe("www.openstreetmap.org");
    expect(url.pathname).toBe("/export/embed.html");
  });

  it("has layer=mapnik, marker lat,lng and bbox west,south,east,north with d = 0.005", () => {
    expect(url.searchParams.get("layer")).toBe("mapnik");
    expect(url.searchParams.get("marker")).toBe("19.432600,-99.133200");
    expect(url.searchParams.get("bbox")).toBe("-99.138200,19.427600,-99.128200,19.437600");
  });

  it("has no parameters other than bbox, layer and marker", () => {
    expect(paramNames(url)).toEqual(["bbox", "layer", "marker"]);
  });

  it("puts the marker inside the bbox", () => {
    const [west, south, east, north] = coordinatesOf(url.searchParams.get("bbox")).map(Number);
    const [lat, lng] = coordinatesOf(url.searchParams.get("marker")).map(Number);
    expect(lng).toBeGreaterThan(west ?? Number.NaN);
    expect(lng).toBeLessThan(east ?? Number.NaN);
    expect(lat).toBeGreaterThan(south ?? Number.NaN);
    expect(lat).toBeLessThan(north ?? Number.NaN);
  });
});

describe("CA-2: buildDirectionsUrl builds the Google Maps search URL", () => {
  const url = new URL(buildDirectionsUrl(19.4326, -99.1332));

  it("points to https://www.google.com/maps/search/ with api=1 and query lat,lng", () => {
    expect(url.protocol).toBe("https:");
    expect(url.host).toBe("www.google.com");
    expect(url.pathname).toBe("/maps/search/");
    expect(url.searchParams.get("api")).toBe("1");
    expect(url.searchParams.get("query")).toBe("19.432600,-99.133200");
  });

  it("has no parameters other than api and query", () => {
    expect(paramNames(url)).toEqual(["api", "query"]);
  });
});

describe("CA-3: coordinates are serialized with exactly six decimals", () => {
  it.each([
    [0.0000001, -0.0000001],
    [19.123456789, -99.987654321],
  ])("(%s, %s): no exponent, no spaces, every coordinate matches -?d+.dddddd", (lat, lng) => {
    const embed = buildMapEmbedUrl(lat, lng);
    const directions = buildDirectionsUrl(lat, lng);
    for (const raw of [embed, directions]) {
      expect(raw).not.toMatch(/\s/);
      expect(raw).not.toMatch(/\d[eE][+-]?\d/);
    }
    const embedUrl = new URL(embed);
    const values = [
      ...coordinatesOf(embedUrl.searchParams.get("marker")),
      ...coordinatesOf(embedUrl.searchParams.get("bbox")),
      ...coordinatesOf(new URL(directions).searchParams.get("query")),
    ];
    expect(values).toHaveLength(8);
    for (const value of values) {
      expect(value).toMatch(COORDINATE);
    }
  });

  it("rounds (19.123456789, -99.987654321) to 19.123457,-99.987654", () => {
    expect(new URL(buildDirectionsUrl(19.123456789, -99.987654321)).searchParams.get("query")).toBe(
      "19.123457,-99.987654",
    );
    expect(new URL(buildMapEmbedUrl(19.123456789, -99.987654321)).searchParams.get("marker")).toBe(
      "19.123457,-99.987654",
    );
  });
});

describe("CA-4: invalid coordinates throw", () => {
  const builders = [
    ["buildMapEmbedUrl", buildMapEmbedUrl],
    ["buildDirectionsUrl", buildDirectionsUrl],
  ] as const;
  const invalid: [number, number][] = [
    [Number.NaN, 0],
    [Number.POSITIVE_INFINITY, 0],
    [91, 0],
    [-91, 0],
    [0, Number.NaN],
    [0, 181],
    [0, -181],
  ];

  for (const [name, build] of builders) {
    it.each(invalid)(`${name}(%s, %s) throws`, (lat, lng) => {
      expect(() => build(lat, lng)).toThrow(Error);
    });

    it(`${name} accepts the edges (90, 180) and (-90, -180)`, () => {
      expect(() => build(90, 180)).not.toThrow();
      expect(() => build(-90, -180)).not.toThrow();
    });
  }
});

describe("CA-5: maps.ts source", () => {
  const source = readFileSync(resolve(libDir, "maps.ts"), "utf8");

  it("contains both base URLs", () => {
    expect(source).toContain("https://www.openstreetmap.org/export/embed.html");
    expect(source).toContain("https://www.google.com/maps/search/");
  });

  it("does not import business nor contain its coordinates", () => {
    expect(source).not.toMatch(/import[^;]*\bbusiness\b/);
    expect(source).not.toMatch(/from\s+["'][^"']*data\/business["']/);
    expect(source).not.toContain("19.4326");
    expect(source).not.toContain("-99.1332");
  });

  it("does not use the DOM", () => {
    expect(source).not.toMatch(/\bdocument\b/);
    expect(source).not.toMatch(/\bwindow\b/);
  });
});
