import "./styles/tokens.css";
import "./styles/main.css";
import "./styles/menu.css";
import "./styles/location.css";
import { business } from "./data/business";
import { buildWhatsAppUrl } from "./lib/whatsapp";
import { renderHero } from "./sections/hero";
import { renderLocation } from "./sections/location";
import { renderMenu } from "./sections/menu";
import { renderReserve } from "./sections/reserve";

function requireElement(doc: Document, selector: string): Element {
  const element = doc.querySelector(selector);
  if (!element) {
    throw new Error(`Mount container not found in index.html: ${selector}`);
  }
  return element;
}

/** Paints the business data into the static skeleton of index.html (D-04). */
export function mount(doc: Document): void {
  // Look up every container first so a missing one fails before the page is half painted.
  const hero = requireElement(doc, "#inicio");
  const menuHeading = requireElement(doc, "#menu h2");
  const locationHeading = requireElement(doc, "#horario h2");
  const reserveHeading = requireElement(doc, "#reservar h2");

  // Built once so both reserve buttons point to exactly the same URL.
  const reserveUrl = buildWhatsAppUrl(business.whatsapp.number, business.whatsapp.message);
  // Built before painting: an invalid price or coordinate throws here, leaving the page untouched.
  const menu = renderMenu(business.menu, { locale: business.locale, currency: business.currency });
  const location = renderLocation({
    hours: business.hours,
    address: business.address,
    coordinates: business.coordinates,
  });

  hero.append(renderHero({ name: business.name, slogan: business.slogan }, reserveUrl));
  menuHeading.after(menu);
  locationHeading.after(location);
  reserveHeading.after(renderReserve(reserveUrl));
}

mount(document);
