+import { existsSync, readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+// Plain strings, not the global URL: under jsdom it is jsdom's class, which node:url rejects.
+const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const fromRoot = (relativePath: string): string => resolve(projectRoot, relativePath);
+const readText = (relativePath: string): string => readFileSync(fromRoot(relativePath), "utf8");
+
+interface PackageJson {
+  scripts?: Record<string, string>;
+  dependencies?: Record<string, string>;
+  devDependencies?: Record<string, string>;
+}
+
+const readPackageJson = (): PackageJson => JSON.parse(readText("package.json")) as PackageJson;
+
+const loadIndexHtml = (): Document => new DOMParser().parseFromString(readText("index.html"), "text/html");
+
+const stripCssComments = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "").trim();
+
+describe("CA-1: package.json scripts", () => {
+  it("defines dev, lint, typecheck, test, build and preview with the agreed commands", () => {
+    const scripts = readPackageJson().scripts ?? {};
+    for (const name of ["dev", "lint", "typecheck", "test", "build", "preview"]) {
+      expect(scripts[name], `script "${name}"`).toBeTruthy();
+    }
+    expect(scripts.typecheck).toBe("tsc --noEmit");
+    expect(scripts.test).toBe("vitest run");
+    expect(scripts.build).toBe("vite build");
+    expect(scripts.lint).toMatch(/\beslint\b/);
+  });
+});
+
+describe("CA-2: dependencies", () => {
+  it("has no production dependencies and the required devDependencies", () => {
+    const pkg = readPackageJson();
+    expect(Object.keys(pkg.dependencies ?? {})).toEqual([]);
+    const devDependencies = Object.keys(pkg.devDependencies ?? {});
+    for (const name of ["vite", "typescript", "vitest", "jsdom", "eslint", "typescript-eslint"]) {
+      expect(devDependencies, `devDependency "${name}"`).toContain(name);
+    }
+  });
+
+  it("has a package-lock.json", () => {
+    expect(existsSync(fromRoot("package-lock.json"))).toBe(true);
+  });
+});
+
+describe("CA-3: index.html head", () => {
+  it("declares lang, title, charset, viewport and loads /src/main.ts as a module", () => {
+    const doc = loadIndexHtml();
+    expect(doc.documentElement.getAttribute("lang")).toBe("es");
+    expect(doc.title).toBe("Cafetería Luna");
+    expect(doc.querySelector("meta[charset]")?.getAttribute("charset")?.toUpperCase()).toBe("UTF-8");
+    expect(doc.querySelector('meta[name="viewport"]')?.getAttribute("content")).toBe(
+      "width=device-width, initial-scale=1",
+    );
+    expect(doc.querySelector('script[type="module"][src="/src/main.ts"]')).not.toBeNull();
+  });
+});
+
+describe("CA-4: index.html has no section content yet", () => {
+  it("contains no <section> and no <h2>", () => {
+    const doc = loadIndexHtml();
+    expect(doc.querySelectorAll("section, h2")).toHaveLength(0);
+  });
+});
+
+describe("CA-5: base source files", () => {
+  it("has src/main.ts and the two stylesheets, both without rules", () => {
+    for (const file of ["src/main.ts", "src/styles/tokens.css", "src/styles/main.css"]) {
+      expect(existsSync(fromRoot(file)), file).toBe(true);
+    }
+    expect(stripCssComments(readText("src/styles/tokens.css"))).toBe("");
+    expect(stripCssComments(readText("src/styles/main.css"))).toBe("");
+  });
+});
+
+describe("CA-6: main.ts imports styles in order", () => {
+  it("imports tokens.css before main.css", () => {
+    const source = readText("src/main.ts");
+    const tokensIndex = source.search(/import\s+["']\.\/styles\/tokens\.css["']/);
+    const mainIndex = source.search(/import\s+["']\.\/styles\/main\.css["']/);
+    expect(tokensIndex, "import of ./styles/tokens.css").toBeGreaterThanOrEqual(0);
+    expect(mainIndex, "import of ./styles/main.css").toBeGreaterThanOrEqual(0);
+    expect(tokensIndex).toBeLessThan(mainIndex);
+  });
+});
+
+describe("CA-7: smoke test in jsdom", () => {
+  it("runs with window and document available", () => {
+    expect(typeof window).toBe("object");
+    expect(typeof document).toBe("object");
+    expect(document.createElement("div").tagName).toBe("DIV");
+  });
+});
