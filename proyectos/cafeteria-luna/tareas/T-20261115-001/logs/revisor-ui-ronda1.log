src/sections/hero.ts
1: import { createReserveButton } from "./reserve";
2: 
3: /** Hero data; it comes from src/data/business.ts through main.ts, never imported here (D-00). */
4: export interface HeroContent {
5:   name: string;
6:   slogan: string;
7: }
8: 
9: // Must match aria-labelledby of section#inicio in index.html.
10: export const HERO_TITLE_ID = "inicio-titulo";
11: 
12: export function renderHero({ name, slogan }: HeroContent, reserveUrl: string): HTMLElement {
13:   const content = document.createElement("div");
14:   content.className = "hero__content container";
15: 
16:   const title = document.createElement("h1");
17:   title.id = HERO_TITLE_ID;
18:   title.className = "hero__title";
19:   title.textContent = name;
20: 
21:   const tagline = document.createElement("p");
22:   tagline.className = "hero__slogan";
23:   tagline.textContent = slogan;
24: 
25:   content.append(title, tagline, createReserveButton(reserveUrl));
26:   return content;
27: }
src/sections/reserve.ts
1: /**
2:  * "Reservar" section and the WhatsApp reserve button shared with the hero (single place that builds it).
3:  * The URL arrives as a parameter, already built by buildWhatsAppUrl (D-00, D-05): never rebuilt here.
4:  */
5: 
6: const SVG_NS = "http://www.w3.org/2000/svg";
7: const WHATSAPP_URL_PREFIX = "https://wa.me/";
8: 
9: const BUTTON_TEXT = "Reservar mesa por WhatsApp";
10: // The accessible name starts with the visible text (WCAG 2.5.3): change both together.
11: const BUTTON_LABEL = `${BUTTON_TEXT} (se abre en una pestaña nueva)`;
12: const RESERVE_TEXT =
13:   "¿Quieres asegurar tu mesa? Escríbenos por WhatsApp con la fecha, la hora y cuántas personas vienen. Te respondemos para confirmarla.";
14: 
15: // Speech bubble outline, drawn with the DOM API (no HTML strings).
16: const CHAT_ICON_PATH =
17:   "M4 3h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H9l-5 4v-4H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z";
18: 
19: function createChatIcon(): SVGSVGElement {
20:   const svg = document.createElementNS(SVG_NS, "svg");
21:   svg.setAttribute("class", "btn__icon");
22:   svg.setAttribute("viewBox", "0 0 24 24");
23:   svg.setAttribute("aria-hidden", "true");
24:   svg.setAttribute("focusable", "false");
25:   const path = document.createElementNS(SVG_NS, "path");
26:   path.setAttribute("d", CHAT_ICON_PATH);
27:   path.setAttribute("fill", "currentColor");
28:   svg.append(path);
29:   return svg;
30: }
31: 
32: export function createReserveButton(url: string): HTMLAnchorElement {
33:   // Guard: only a wa.me link may reach the href (blocks javascript: and other schemes).
34:   if (!url.startsWith(WHATSAPP_URL_PREFIX)) {
35:     throw new Error(`Reserve URL must start with ${WHATSAPP_URL_PREFIX}`);
36:   }
37:   const link = document.createElement("a");
38:   link.className = "btn btn--whatsapp";
39:   link.setAttribute("href", url);
40:   link.setAttribute("target", "_blank");
41:   link.setAttribute("rel", "noopener noreferrer");
42:   link.setAttribute("aria-label", BUTTON_LABEL);
43:   const label = document.createElement("span");
44:   label.textContent = BUTTON_TEXT;
45:   link.append(createChatIcon(), label);
46:   return link;
47: }
48: 
49: export function renderReserve(reserveUrl: string): HTMLElement {
50:   const body = document.createElement("div");
51:   body.className = "reserve";
52:   const text = document.createElement("p");
53:   text.className = "reserve__text";
54:   text.textContent = RESERVE_TEXT;
55:   body.append(text, createReserveButton(reserveUrl));
56:   return body;
57: }
src/main.ts
1: import "./styles/tokens.css";
2: import "./styles/main.css";
3: import { business } from "./data/business";
4: import { buildWhatsAppUrl } from "./lib/whatsapp";
5: import { renderHero } from "./sections/hero";
6: import { renderReserve } from "./sections/reserve";
7: 
8: function requireElement(doc: Document, selector: string): Element {
9:   const element = doc.querySelector(selector);
10:   if (!element) {
11:     throw new Error(`Mount container not found in index.html: ${selector}`);
12:   }
13:   return element;
14: }
15: 
16: /** Paints the business data into the static skeleton of index.html (D-04). */
17: export function mount(doc: Document): void {
18:   // Look up every container first so a missing one fails before the page is half painted.
19:   const hero = requireElement(doc, "#inicio");
20:   const reserveHeading = requireElement(doc, "#reservar h2");
21: 
22:   // Built once so both reserve buttons point to exactly the same URL.
23:   const reserveUrl = buildWhatsAppUrl(business.whatsapp.number, business.whatsapp.message);
24: 
25:   hero.append(renderHero({ name: business.name, slogan: business.slogan }, reserveUrl));
26:   reserveHeading.after(renderReserve(reserveUrl));
27: }
28: 
29: mount(document);
