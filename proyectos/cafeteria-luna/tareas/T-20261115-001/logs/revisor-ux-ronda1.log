+++ b/src/page.test.ts
@@ -0,0 +1,120 @@
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+// Structure of the static skeleton in index.html (D-04). jsdom parses it; nothing is mounted here.
+const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const indexHtml = readFileSync(resolve(projectRoot, "index.html"), "utf8");
+const loadIndexHtml = (): Document => new DOMParser().parseFromString(indexHtml, "text/html");
+
+const FOOTER_NOTICE =
+  "Página de demostración: el eslogan, el menú, los precios, el horario, la dirección y el número de WhatsApp son datos de ejemplo.";
+
+const FOCUSABLE = "a[href], button, input, select, textarea, [tabindex]:not([tabindex='-1'])";
+
+const text = (element: Element | null): string => (element?.textContent ?? "").replace(/\s+/g, " ").trim();
+
+describe("CA-1: head is kept and body is header, main#contenido, footer", () => {
+  it("keeps lang, title, charset, viewport and the module script", () => {
+    const doc = loadIndexHtml();
+    expect(doc.documentElement.getAttribute("lang")).toBe("es");
+    expect(doc.title).toBe("Cafetería Luna");
+    expect(doc.querySelector("meta[charset]")?.getAttribute("charset")?.toUpperCase()).toBe("UTF-8");
+    expect(doc.querySelector('meta[name="viewport"]')?.getAttribute("content")).toBe(
+      "width=device-width, initial-scale=1",
+    );
+    expect(doc.querySelector('script[type="module"][src="/src/main.ts"]')).not.toBeNull();
+  });
+
+  it("has exactly header, main#contenido and footer as body children (script aside)", () => {
+    const doc = loadIndexHtml();
+    const children = Array.from(doc.body.children).filter((child) => child.tagName !== "SCRIPT");
+    expect(children.map((child) => child.tagName)).toEqual(["HEADER", "MAIN", "FOOTER"]);
+    expect(children[1]?.id).toBe("contenido");
+  });
+});
+
+describe("CA-2: four sections in main with their headings", () => {
+  it("has sections inicio, menu, horario, reservar in that order", () => {
+    const doc = loadIndexHtml();
+    const main = doc.querySelector("main");
+    const sections = Array.from(main?.children ?? []).filter((child) => child.tagName === "SECTION");
+    expect(sections.map((section) => section.id)).toEqual(["inicio", "menu", "horario", "reservar"]);
+    expect(main?.querySelectorAll("section")).toHaveLength(4);
+  });
+
+  it("gives menu, horario and reservar a static <h2> referenced by aria-labelledby", () => {
+    const doc = loadIndexHtml();
+    const expected: Record<string, string> = { menu: "Menú", horario: "Horario y ubicación", reservar: "Reservar" };
+    for (const [id, heading] of Object.entries(expected)) {
+      const section = doc.getElementById(id);
+      const h2s = section?.querySelectorAll("h2") ?? [];
+      expect(h2s, `#${id} h2`).toHaveLength(1);
+      const h2 = h2s[0];
+      expect(text(h2 ?? null)).toBe(heading);
+      const labelledBy = section?.getAttribute("aria-labelledby");
+      expect(labelledBy, `#${id} aria-labelledby`).toBeTruthy();
+      expect(labelledBy).toBe(h2?.id);
+    }
+  });
+
+  it("points #inicio to the hero <h1> id and has no <h1> in the static HTML", () => {
+    const doc = loadIndexHtml();
+    expect(doc.getElementById("inicio")?.getAttribute("aria-labelledby")).toBe("inicio-titulo");
+    expect(doc.querySelectorAll("h1")).toHaveLength(0);
+  });
+});
+
+describe("CA-3: header with skip link, brand link and main navigation", () => {
+  it("has the skip link as the first focusable element of the body", () => {
+    const doc = loadIndexHtml();
+    const first = doc.body.querySelector(FOCUSABLE);
+    expect(first?.tagName).toBe("A");
+    expect(text(first)).toBe("Saltar al contenido");
+    expect(first?.getAttribute("href")).toBe("#contenido");
+    expect(first?.closest("header")).not.toBeNull();
+  });
+
+  it("has a brand link to #inicio that is not a heading", () => {
+    const doc = loadIndexHtml();
+    const header = doc.querySelector("header");
+    const brand = Array.from(header?.querySelectorAll("a") ?? []).find((a) => text(a) === "Cafetería Luna");
+    expect(brand).toBeDefined();
+    expect(brand?.getAttribute("href")).toBe("#inicio");
+    expect(brand?.closest("h1, h2, h3, h4, h5, h6")).toBeNull();
+    expect(brand?.querySelector("h1, h2, h3, h4, h5, h6")).toBeNull();
+  });
+
+  it("has nav[aria-label=Principal] with exactly Menú, Horario y ubicación, Reservar", () => {
+    const doc = loadIndexHtml();
+    const navs = doc.querySelectorAll('header nav[aria-label="Principal"]');
+    expect(navs).toHaveLength(1);
+    const links = Array.from(navs[0]?.querySelectorAll("a") ?? []);
+    expect(links.map((a) => text(a))).toEqual(["Menú", "Horario y ubicación", "Reservar"]);
+    expect(links.map((a) => a.getAttribute("href"))).toEqual(["#menu", "#horario", "#reservar"]);
+  });
+});
+
+describe("CA-4: no broken internal anchors", () => {
+  it("every href starting with # resolves to an element id", () => {
+    const doc = loadIndexHtml();
+    const anchors = Array.from(doc.querySelectorAll('a[href^="#"]'));
+    expect(anchors.length).toBeGreaterThanOrEqual(5);
+    for (const anchor of anchors) {
+      const id = anchor.getAttribute("href")?.slice(1) ?? "";
+      expect(id, "empty fragment").not.toBe("");
+      expect(doc.getElementById(id), `target of href="#${id}"`).not.toBeNull();
+    }
+  });
+});
+
+describe("CA-5: footer with name and demo-data notice (D-00)", () => {
+  it("contains Cafetería Luna and the exact notice", () => {
+    const doc = loadIndexHtml();
+    const footer = doc.querySelector("footer");
+    expect(text(footer)).toContain("Cafetería Luna");
+    const paragraphs = Array.from(footer?.querySelectorAll("p") ?? []).map((p) => text(p));
+    expect(paragraphs).toContain(FOOTER_NOTICE);
+  });
+});
