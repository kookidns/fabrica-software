/* ── Base ─────────────────────────────────────────────── */
*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-body);
  color: var(--color-text);
  background: var(--color-bg);
  overflow-wrap: break-word;
}

h1,
h2,
h3 {
  margin: 0;
  font-family: var(--font-heading);
  line-height: var(--leading-heading);
  color: var(--color-text);
  overflow-wrap: anywhere;
}

p {
  margin: 0;
}

a {
  color: var(--color-primary);
}

.container {
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  padding-inline: var(--gutter);
}

/* ── Foco: anillo azul que cae sobre el fondo, nunca sobre el primario ── */
:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 3px;
}

/* main recibe el foco del enlace de salto; el anillo alrededor de toda la página no aporta. */
main:focus {
  outline: none;
}

/* ── Enlace "Saltar al contenido": oculto hasta recibir foco ── */
.skip-link {
  position: absolute;
  top: var(--space-2);
  left: var(--space-2);
  z-index: 20;
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  padding-inline: var(--space-4);
  border-radius: var(--radius-sm);
  background: var(--color-surface-raised);
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: var(--shadow-md);
}

.skip-link:not(:focus) {
  width: 1px;
  height: 1px;
  min-height: 0;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ── Cabecera sticky ──────────────────────────────────── */
/* Móvil: el nombre ocupa una fila de --header-height y la navegación otra de --tap-min
   (las tres entradas no caben junto al nombre en 375 px). Desde 768 px, una sola fila. */
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}

.site-header__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  column-gap: var(--space-4);
}

.brand {
  display: inline-flex;
  align-items: center;
  min-height: var(--header-height);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: var(--text-lg);
  line-height: var(--leading-heading);
  color: var(--color-text);
  text-decoration: none;
}

.site-nav {
  flex-basis: 100%;
  min-width: 0;
}

.site-nav__list {
  display: flex;
  gap: var(--space-2);
  margin: 0 calc(-1 * var(--space-2));
  padding: 0;
  list-style: none;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  padding-inline: var(--space-2);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary);
  text-decoration: none;
  white-space: nowrap;
}

.nav-link:hover {
  text-decoration: underline;
  text-underline-offset: var(--space-1);
}

/* ── Secciones ────────────────────────────────────────── */
/* El ancla deja el título bajo la cabecera de dos filas (nombre + navegación). */
main > section {
  padding-block: var(--space-7);
  scroll-margin-top: calc(var(--header-height) + var(--tap-min));
}

main > section:nth-of-type(even) {
  background: var(--color-surface);
}

main > section h2 {
  margin-bottom: var(--space-5);
  font-size: var(--text-2xl);
  font-weight: 600;
}

/* ── Portada ──────────────────────────────────────────── */
/* Alto visible menos la cabecera: nombre, eslogan y botón sin hacer scroll (CA-01.1, CA-01.2). */
.hero {
  display: flex;
  align-items: center;
  min-height: calc(100vh - var(--header-height) - var(--tap-min));
  min-height: calc(100svh - var(--header-height) - var(--tap-min));
}

.hero__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
