  price: number;
}

export interface OpenDay {
  day: string;
  /** "HH:MM", 24 h. */
  open: string;
  /** "HH:MM", 24 h, later than `open`. */
  close: string;
  closed?: never;
}

export interface ClosedDay {
  day: string;
  closed: true;
  open?: never;
  close?: never;
}

export type DayHours = OpenDay | ClosedDay;

