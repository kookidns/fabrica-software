new file mode 100644
index 0000000..9028b4a
--- /dev/null
+++ b/src/sections/hero.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+import { renderHero } from "./hero";
+
+const URL_OK = "https://wa.me/521234567890?text=Hola%20prueba";
+const content = { name: "Café de Prueba", slogan: "Un eslogan de prueba" };
+
+describe("CA-7: renderHero({ name, slogan }, reserveUrl)", () => {
+  it("renders <h1> name, then <p> slogan, then the reserve button, and nothing else before it", () => {
+    const hero = renderHero(content, URL_OK);
+    const children = Array.from(hero.children);
+    expect(children.map((child) => child.tagName)).toEqual(["H1", "P", "A"]);
+    expect(hero.firstChild).toBe(children[0]);
+    expect(children[0]?.textContent).toBe(content.name);
+    expect(children[1]?.textContent).toBe(content.slogan);
+    expect(children[2]?.getAttribute("href")).toBe(URL_OK);
+    expect(children[2]?.textContent?.trim()).toBe("Reservar mesa por WhatsApp");
+    expect(children[2]?.classList.contains("btn--whatsapp")).toBe(true);
+  });
+
+  it("gives the <h1> the id that #inicio's aria-labelledby points to", () => {
+    const hero = renderHero(content, URL_OK);
+    expect(hero.querySelector("h1")?.id).toBe("inicio-titulo");
+  });
+});
+
+describe("CA-8: data is rendered as text, never as HTML", () => {
+  it("shows HTML in name or slogan literally and creates no <img>", () => {
+    const payload = "<img src=x onerror=alert(1)>";
+    const hero = renderHero({ name: payload, slogan: payload }, URL_OK);
+    expect(hero.querySelector("img")).toBeNull();
+    expect(hero.querySelector("h1")?.textContent).toBe(payload);
+    expect(hero.querySelector("p")?.textContent).toBe(payload);
+  });
+});
diff --git a/src/sections/reserve.test.ts b/src/sections/reserve.test.ts
new file mode 100644
index 0000000..6ed98d8
--- /dev/null
+++ b/src/sections/reserve.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from "vitest";
+import { createReserveButton, renderReserve } from "./reserve";
+
+const URL_OK = "https://wa.me/521234567890?text=Hola%20prueba";
+const BUTTON_TEXT = "Reservar mesa por WhatsApp";
+const BUTTON_LABEL = "Reservar mesa por WhatsApp (se abre en una pestaña nueva)";
+const RESERVE_TEXT =
+  "¿Quieres asegurar tu mesa? Escríbenos por WhatsApp con la fecha, la hora y cuántas personas vienen. Te respondemos para confirmarla.";
+
+describe("CA-6: createReserveButton(url)", () => {
+  it("returns a link to the given URL with the exact visible text and accessible name", () => {
+    const button = createReserveButton(URL_OK);
+    expect(button.tagName).toBe("A");
+    expect(button.getAttribute("href")).toBe(URL_OK);
+    expect(button.textContent?.trim()).toBe(BUTTON_TEXT);
+    expect(button.getAttribute("aria-label")).toBe(BUTTON_LABEL);
+    expect(button.getAttribute("aria-label")?.startsWith(BUTTON_TEXT)).toBe(true);
+  });
+
+  it("opens in a new tab with noopener and noreferrer", () => {
+    const button = createReserveButton(URL_OK);
+    expect(button.getAttribute("target")).toBe("_blank");
+    const rel = (button.getAttribute("rel") ?? "").split(/\s+/);
+    expect(rel).toContain("noopener");
+    expect(rel).toContain("noreferrer");
+  });
+
+  it("has a decorative DOM-created <svg> icon before the text", () => {
+    const button = createReserveButton(URL_OK);
+    const svg = button.querySelector("svg");
+    expect(svg).not.toBeNull();
+    expect(svg?.namespaceURI).toBe("http://www.w3.org/2000/svg");
+    expect(svg?.getAttribute("aria-hidden")).toBe("true");
+    expect(svg?.getAttribute("focusable")).toBe("false");
+    expect(button.firstElementChild).toBe(svg);
+    expect(button.firstChild).toBe(svg);
+  });
+
+  it("uses the whatsapp button variant class", () => {
+    const button = createReserveButton(URL_OK);
+    expect(button.classList.contains("btn")).toBe(true);
+    expect(button.classList.contains("btn--whatsapp")).toBe(true);
+  });
+
+  it.each(["javascript:alert(1)", "", "http://wa.me/52", "https://evil.example/https://wa.me/", " https://wa.me/52"])(
+    "throws instead of creating a link for %j",
+    (badUrl) => {
+      expect(() => createReserveButton(badUrl)).toThrow(Error);
+    },
+  );
+});
+
+describe("CA-9: renderReserve(url)", () => {
+  it("returns the reserve text followed by the reserve button", () => {
+    const element = renderReserve(URL_OK);
+    const children = Array.from(element.children);
+    expect(children.map((child) => child.tagName)).toEqual(["P", "A"]);
+    expect(children[0]?.textContent).toBe(RESERVE_TEXT);
+    expect(children[1]?.getAttribute("href")).toBe(URL_OK);
+    expect(children[1]?.textContent?.trim()).toBe(BUTTON_TEXT);
+  });
+});
diff --git a/src/styles/styles.test.ts b/src/styles/styles.test.ts
new file mode 100644
index 0000000..447a1e9
--- /dev/null
+++ b/src/styles/styles.test.ts
@@ -0,0 +1,148 @@
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+const stylesDir = dirname(fileURLToPath(import.meta.url));
+const stripComments = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
+const readCss = (file: string): string => stripComments(readFileSync(resolve(stylesDir, file), "utf8"));
+const normalize = (value: string): string => value.replace(/\s+/g, " ").trim();
+
+const parseDeclarations = (block: string): Map<string, string> => {
+  const declarations = new Map<string, string>();
+  for (const match of block.matchAll(/(--[\w-]+)\s*:\s*([^;]+);/g)) {
+    declarations.set(match[1] ?? "", normalize(match[2] ?? ""));
+  }
+  return declarations;
+};
+
+interface CssRule {
+  selector: string;
+  body: string;
+}
+
+// Innermost rules only (rules nested in @media come out with their own selector).
+const parseRules = (css: string): CssRule[] =>
+  Array.from(css.matchAll(/([^{}]+)\{([^{}]*)\}/g), (match) => ({
+    selector: normalize(match[1] ?? ""),
+    body: normalize(match[2] ?? ""),
+  }));
+
+// Copied from the "Tokens CSS" block of brain/diseno.md.
+const ROOT_TOKENS: Record<string, string> = {
+  "--color-bg": "#FBF6EE",
+  "--color-surface": "#F3EADB",
+  "--color-surface-raised": "#FFFFFF",
+  "--color-text": "#2B1D14",
+  "--color-text-muted": "#6B5646",
+  "--color-primary": "#7A3E1D",
+  "--color-primary-hover": "#62301A",
+  "--color-on-primary": "#FFFFFF",
+  "--color-secondary": "#E9C46A",
+  "--color-on-secondary": "#2B1D14",
+  "--color-whatsapp": "#1E6B45",
+  "--color-on-whatsapp": "#FFFFFF",
+  "--color-success": "#2E6B3A",
+  "--color-error": "#B3261E",
+  "--color-border": "#D9C9B3",
+  "--color-focus": "#1F4E8C",
+  "--color-footer-bg": "#2B1D14",
+  "--color-footer-text": "#F3EADB",
+  "--font-heading": '"Fraunces", Georgia, "Times New Roman", serif',
+  "--font-body": '"DM Sans", system-ui, -apple-system, "Segoe UI", sans-serif',
+  "--text-xs": "0.8125rem",
+  "--text-sm": "0.9375rem",
+  "--text-base": "1rem",
+  "--text-lg": "1.125rem",
+  "--text-xl": "1.5rem",
+  "--text-2xl": "1.875rem",
+  "--text-3xl": "2.5rem",
+  "--leading-body": "1.6",
+  "--leading-heading": "1.2",
+  "--space-1": "0.25rem",
+  "--space-2": "0.5rem",
+  "--space-3": "0.75rem",
+  "--space-4": "1rem",
+  "--space-5": "1.5rem",
+  "--space-6": "2rem",
+  "--space-7": "3rem",
+  "--space-8": "4.5rem",
+  "--radius-sm": "6px",
+  "--radius-md": "12px",
+  "--radius-lg": "20px",
+  "--radius-pill": "999px",
+  "--shadow-sm": "0 1px 2px rgb(43 29 20 / 0.08), 0 1px 3px rgb(43 29 20 / 0.06)",
+  "--shadow-md": "0 4px 12px rgb(43 29 20 / 0.12), 0 2px 4px rgb(43 29 20 / 0.06)",
+  "--container-max": "64rem",
+  "--gutter": "var(--space-4)",
+  "--tap-min": "44px",
+  "--header-height": "56px",
+};
+
+const MD_TOKENS: Record<string, string> = {
+  "--text-base": "1.0625rem",
+  "--text-lg": "1.25rem",
+  "--text-xl": "1.75rem",
+  "--text-2xl": "2.5rem",
+  "--text-3xl": "3.75rem",
+  "--gutter": "var(--space-5)",
+  "--header-height": "64px",
+};
+
+const MD_BLOCK = /@media\s*\(\s*min-width:\s*768px\s*\)\s*\{\s*:root\s*\{([^}]*)\}\s*\}/;
+
+describe("CA-14: tokens.css declares the diseno.md tokens", () => {
+  const css = readCss("tokens.css");
+
+  it("declares every token of the :root block with its exact value", () => {
+    const rootMatch = css.replace(MD_BLOCK, "").match(/:root\s*\{([^}]*)\}/);
+    expect(rootMatch, ":root block").not.toBeNull();
+    const declared = parseDeclarations(rootMatch?.[1] ?? "");
+    expect(Object.keys(ROOT_TOKENS).filter((name) => name.startsWith("--color-"))).toHaveLength(18);
+    for (const [name, value] of Object.entries(ROOT_TOKENS)) {
+      expect(declared.get(name), name).toBe(value);
+    }
+  });
+
+  it("redefines the type scale, gutter and header height from 768 px", () => {
+    const mdMatch = css.match(MD_BLOCK);
+    expect(mdMatch, "@media (min-width: 768px) { :root { … } }").not.toBeNull();
+    const declared = parseDeclarations(mdMatch?.[1] ?? "");
+    for (const [name, value] of Object.entries(MD_TOKENS)) {
+      expect(declared.get(name), name).toBe(value);
+    }
+  });
+});
+
+describe("CA-15: main.css only uses tokens and covers the base behaviours", () => {
+  const css = readCss("main.css");
+  const rules = parseRules(css);
+
+  it("has no color literals", () => {
+    expect(css).not.toMatch(/#[0-9a-f]{3,8}(?![\w-])/i);
+    expect(css).not.toMatch(/\b(rgba?|hsla?)\(/i);
+  });
+
+  it("makes the header sticky at the top", () => {
+    const header = rules.find((rule) => /header/.test(rule.selector) && /position: sticky/.test(rule.body));
+    expect(header, "sticky header rule").toBeDefined();
+    expect(header?.body).toMatch(/(^|;\s*)top: 0(;|$)/);
+  });
+
+  it("gives sections a scroll-margin-top based on var(--header-height)", () => {
+    const sections = rules.filter((rule) => /section/.test(rule.selector) && /scroll-margin-top:/.test(rule.body));
+    expect(sections.length).toBeGreaterThan(0);
+    for (const rule of sections) {
+      expect(rule.body).toMatch(/scroll-margin-top:[^;]*var\(--header-height\)/);
+    }
+  });
+
+  it("draws :focus-visible with var(--color-focus)", () => {
+    const focus = rules.find((rule) => /:focus-visible/.test(rule.selector) && /var\(--color-focus\)/.test(rule.body));
+    expect(focus, ":focus-visible rule").toBeDefined();
+  });
+
+  it("has a prefers-reduced-motion: reduce block", () => {
+    expect(css).toMatch(/@media\s*\(\s*prefers-reduced-motion:\s*reduce\s*\)\s*\{/);
+  });
+});

