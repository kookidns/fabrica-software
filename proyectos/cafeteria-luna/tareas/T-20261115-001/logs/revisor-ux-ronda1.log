}

/* ── Reservar ─────────────────────────────────────────── */
.reserve__text {
  max-width: 65ch;
  margin-bottom: var(--space-5);
}

/* ── Botón ────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
