/* Móvil: ocupa el ancho del contenedor (diseno.md). */
.btn--whatsapp {
  width: 100%;
  background: var(--color-whatsapp);
  color: var(--color-on-whatsapp);
}

/* Hover ~10 % más oscuro, mezclando con un token (sin colores a mano). */
.btn--whatsapp:hover {
  background: color-mix(in srgb, var(--color-whatsapp) 90%, var(--color-text));
}

/* ── Pie ──────────────────────────────────────────────── */
.site-footer {
  padding-block: var(--space-7);
  background: var(--color-footer-bg);
  color: var(--color-footer-text);
  font-size: var(--text-sm);
}

.site-footer a {
  color: var(--color-footer-text);
  text-decoration: underline;
}

/* En el pie oscuro el anillo va en dorado (9.75:1 sobre footer-bg). */
.site-footer :focus-visible {
  outline-color: var(--color-secondary);
}

.site-footer__name {
  margin-bottom: var(--space-2);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: var(--text-lg);
}

.site-footer__notice {
  max-width: 65ch;
}

/* ── Desde 768 px ─────────────────────────────────────── */
@media (min-width: 768px) {
  .site-header__inner {
    flex-wrap: nowrap;
    min-height: var(--header-height);
  }

  .site-nav {
    flex-basis: auto;
  }

  .site-nav__list {
    margin: 0;
  }

  main > section {
    padding-block: var(--space-8);
    scroll-margin-top: var(--header-height);
  }

  .hero {
    min-height: calc(100vh - var(--header-height));
    min-height: calc(100svh - var(--header-height));
  }

  .btn--whatsapp {
    width: auto;
  }
}

/* ── Movimiento reducido ──────────────────────────────── */
@media (prefers-reduced-motion: no-preference) {
  html {
    scroll-behavior: smooth;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
    scroll-behavior: auto !important;
  }

  .btn:active {
    transform: none;
  }
}
