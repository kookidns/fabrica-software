/**
 * "Reservar" section and the WhatsApp reserve button shared with the hero (single place that builds it).
 * The URL arrives as a parameter, already built by buildWhatsAppUrl (D-00, D-05): never rebuilt here.
 */

const SVG_NS = "http://www.w3.org/2000/svg";
const WHATSAPP_URL_PREFIX = "https://wa.me/";

const BUTTON_TEXT = "Reservar mesa por WhatsApp";
// The accessible name starts with the visible text (WCAG 2.5.3): change both together.
const BUTTON_LABEL = `${BUTTON_TEXT} (se abre en una pestaña nueva)`;
const RESERVE_TEXT =
  "¿Quieres asegurar tu mesa? Escríbenos por WhatsApp con la fecha, la hora y cuántas personas vienen. Te respondemos para confirmarla.";

// Speech bubble outline, drawn with the DOM API (no HTML strings).
const CHAT_ICON_PATH =
  "M4 3h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H9l-5 4v-4H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z";

function createChatIcon(): SVGSVGElement {
  const svg = document.createElementNS(SVG_NS, "svg");
  svg.setAttribute("class", "btn__icon");
  svg.setAttribute("viewBox", "0 0 24 24");
  svg.setAttribute("aria-hidden", "true");
  svg.setAttribute("focusable", "false");
  const path = document.createElementNS(SVG_NS, "path");
  path.setAttribute("d", CHAT_ICON_PATH);
  path.setAttribute("fill", "currentColor");
  svg.append(path);
  return svg;
}

export function createReserveButton(url: string): HTMLAnchorElement {
  // Guard: only a wa.me link may reach the href (blocks javascript: and other schemes).
  if (!url.startsWith(WHATSAPP_URL_PREFIX)) {
    throw new Error(`Reserve URL must start with ${WHATSAPP_URL_PREFIX}`);
  }
  const link = document.createElement("a");
  link.className = "btn btn--whatsapp";
  link.setAttribute("href", url);
  link.setAttribute("target", "_blank");
  link.setAttribute("rel", "noopener noreferrer");
  link.setAttribute("aria-label", BUTTON_LABEL);
  const label = document.createElement("span");
  label.textContent = BUTTON_TEXT;
  link.append(createChatIcon(), label);
  return link;
}

export function renderReserve(reserveUrl: string): HTMLElement {
  const body = document.createElement("div");
  body.className = "reserve";
  const text = document.createElement("p");
  text.className = "reserve__text";
  text.textContent = RESERVE_TEXT;
  body.append(text, createReserveButton(reserveUrl));
  return body;
}

